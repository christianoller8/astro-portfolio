---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '@/i18n/utils';
import { site, hasCV } from '@/data/site';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const currentYear = new Date().getFullYear();
const subject = encodeURIComponent(t('contact.mailto.subject'));
// El correo, partido en la "@" para dejar un salto de línea posible justo detrás (<wbr>)
const [emailLocal, emailDomain] = site.email.split('@');
---

<!-- El reverso del artboard: mismos datos, colores invertidos -->
<footer class="artboard-back" data-cs="<footer> Footer.astro">
  <div class="wrap back-inner">
    <div class="back-cta">
      <h2 class="t-head" data-reveal>{t('footer.title')}</h2>
      <p class="t-lead back-lead" data-reveal style="--reveal-i: 1">{t('footer.lead')}</p>
      <div class="back-actions" data-reveal style="--reveal-i: 2">
        <a class="btn btn-primary" href={`mailto:${site.email}?subject=${subject}`}>
          {t('footer.email')}
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn-invert" href={translatePath('/contact')}>{t('footer.form')}</a>
      </div>
    </div>

    <ul class="back-links" data-reveal style="--reveal-i: 3">
      <li class="back-mail">
        <a class="link" href={`mailto:${site.email}`}>{emailLocal}@<wbr />{emailDomain}</a>
        <button type="button" class="back-copy" data-copy={site.email} data-copied={t('footer.copied')} data-failed={t('footer.copyFailed')}>
          {t('footer.copy')}
        </button>
      </li>
      <li><a class="link" href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a></li>
      <li><a class="link" href={site.github} target="_blank" rel="noreferrer">GitHub ↗</a></li>
      {
        hasCV && (
          <li>
            <a class="link" href={site.cv} download>
              {t('hero.cta.cv')} <span class="btn-arrow" aria-hidden="true">↓</span>
            </a>
          </li>
        )
      }
    </ul>

    <p class="wordmark" aria-hidden="true">Christian Oller</p>

    <p class="t-small back-credits">
      <span>{t('footer.credits')} © {currentYear} Christian Oller</span>
      <a class="link" href={translatePath('/privacy')}>{t('footer.privacy')}</a>
      {/* Volver arriba (decisión de Christian, 21 nov). Sin JavaScript, "#" ya sube al principio y
          no deja ancla en la dirección (la intro se salta si la hay); con él, sube con suavidad */}
      {/* eslint-disable-next-line jsx-a11y/anchor-is-valid -- "#" es a propósito: el respaldo sin JavaScript */}
      <a class="link back-top" href="#" data-back-top>
        {t('footer.top')}
        <span class="back-top-arrow" aria-hidden="true">↑</span>
      </a>
    </p>
  </div>
</footer>

<style>
  .artboard-back {
    margin-top: clamp(6rem, 12vw, 10rem);
    padding-block: clamp(4rem, 8vw, 7rem) 2rem;
    background: var(--ink);
    color: var(--paper);
  }
  .back-inner {
    display: grid;
    /* minmax(0, …): el email con su botón no ensancha el pie en pantallas de 320 px */
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
  }
  .back-cta {
    max-width: 44rem;
  }
  .back-lead {
    margin-top: 1rem;
    color: var(--paper);
  }
  .back-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .btn-invert {
    background: color-mix(in srgb, var(--paper) 12%, var(--ink));
    color: var(--paper);
  }
  .btn-invert:hover {
    background: var(--paper);
    color: var(--ink);
  }
  .back-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    font-size: var(--step-body);
  }
  .back-links .btn-arrow {
    display: inline-block;
    margin-left: 0.3em;
  }
  .back-links a {
    display: inline-flex;
    min-height: 2.5rem;
    align-items: center;
  }
  .back-mail {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.6rem;
  }
  .back-mail a {
    overflow-wrap: anywhere;
  }
  .back-copy {
    min-width: 4.75rem;
    min-height: 1.75rem;
    padding: 0 0.6rem;
    font: 600 var(--step-small)/1 var(--font-sans);
    color: var(--paper);
    background: color-mix(in srgb, var(--paper) 14%, var(--ink));
    transition:
      background-color var(--dur-micro) var(--ease-out),
      color var(--dur-micro) var(--ease-out);
  }
  .back-copy:hover,
  .back-copy.is-done {
    color: var(--ink);
    background: var(--paper);
  }
  .wordmark {
    margin-top: 1rem;
    font-size: clamp(3rem, 12.4vw, 13rem);
    font-weight: 700;
    line-height: 0.8;
    letter-spacing: -0.055em;
    white-space: nowrap;
  }
  .back-credits {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 1.5rem;
    color: color-mix(in srgb, var(--paper) 72%, var(--ink));
  }
  /* Zona táctil de 2.5 rem como los demás enlaces del pie, sin cambiar el aspecto de la línea */
  .back-credits a {
    display: inline-flex;
    min-height: 2.5rem;
    align-items: center;
  }
  /* Al final de la línea, a la derecha; en pantallas estrechas baja a su propia línea */
  .back-top {
    gap: 0.4em;
    margin-left: auto;
  }
  .back-top-arrow {
    transition: transform 200ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .back-top:hover .back-top-arrow {
      transform: translateY(-3px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .back-top-arrow {
      transition: none;
    }
  }
</style>

<script>
  // Copiar el email: el botón dice "Copiado" un momento y vuelve a su texto. Compartido con Contacto.
  // El resultado se anuncia en una región educada (los avisos visuales no los leen los lectores de
  // pantalla) y, si el portapapeles falla, se dice en lugar de no hacer nada.
  const live = () => {
    let region = document.querySelector<HTMLElement>('[data-copy-live]');
    if (!region) {
      region = document.createElement('span');
      region.className = 'sr-only';
      region.setAttribute('role', 'status');
      region.setAttribute('aria-live', 'polite');
      region.dataset.copyLive = '';
      document.body.append(region);
    }
    return region;
  };
  // La región existe antes de que cambie su texto: si se creara con el texto puesto, no se anunciaría
  document.addEventListener('astro:page-load', () => live());

  // Volver arriba, sin dejar "#" en la dirección. El desplazamiento suave del navegador recorría la
  // home entera (unos 9.300 px) en un segundo y medio y se veía a tirones: pasa por la pila de
  // proyectos, la escena fija y las capas 3D, que no dan para tanto (medido el 21 nov: fotogramas de
  // hasta 140 ms y un salto de 2.500 px en uno solo). Ahora, desde lejos, un salto instantáneo hasta
  // un viewport y medio de arriba, y ese último tramo se desliza con su curva: sale rápido y se posa
  // suave, como si viniera de lejos. Con "reducir movimiento", de golpe. Si la persona mueve la página
  // mientras sube, manda ella
  const GLIDE_MS = 700;
  const easeOut = (t: number) => 1 - (1 - t) ** 4;
  let glide = 0;
  const stop = () => {
    cancelAnimationFrame(glide);
    glide = 0;
  };
  for (const type of ['wheel', 'touchstart', 'keydown'] as const) {
    window.addEventListener(type, () => glide && stop(), { passive: true });
  }

  function toTop(done: () => void) {
    stop();
    const y = window.scrollY;
    if (y === 0 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      window.scrollTo({ top: 0, behavior: 'instant' });
      done();
      return;
    }
    const from = Math.min(y, Math.round(window.innerHeight * 1.5));
    if (from < y) window.scrollTo({ top: from, behavior: 'instant' });
    const start = performance.now();
    const step = (now: number) => {
      const t = Math.min((now - start) / GLIDE_MS, 1);
      window.scrollTo({ top: Math.round(from * (1 - easeOut(t))), behavior: 'instant' });
      if (t < 1) glide = requestAnimationFrame(step);
      else {
        glide = 0;
        done();
      }
    };
    glide = requestAnimationFrame(step);
  }

  // Con el teclado, el foco pasa al enlace de salto (lo primero de la página) al llegar arriba, para
  // que el siguiente Tab siga desde ahí; con el ratón no se mueve el foco, solo se suelta el enlace.
  // En la fase de captura de window, antes que el router de Astro: si no, él trataría "#" como un
  // ancla de la página (la pondría en la dirección y movería el foco) y este clic llegaría tarde
  window.addEventListener(
    'click',
    (event) => {
      const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('[data-back-top]');
      if (!link) return;
      event.preventDefault();
      const keyboard = event.detail === 0;
      if (!keyboard) link.blur();
      toTop(() => {
        if (keyboard) document.querySelector<HTMLElement>('a[href="#main"]')?.focus({ preventScroll: true });
      });
    },
    { capture: true },
  );

  document.addEventListener('click', async (event) => {
    const btn = (event.target as Element | null)?.closest<HTMLButtonElement>('[data-copy]');
    if (!btn || btn.classList.contains('is-done')) return;
    let message = btn.dataset.copied ?? '';
    try {
      await navigator.clipboard.writeText(btn.dataset.copy ?? '');
    } catch {
      message = btn.dataset.failed ?? '';
    }
    const region = live();
    region.textContent = '';
    requestAnimationFrame(() => (region.textContent = message));
    // Un aviso sale desde el puntero (o desde el botón, con teclado)
    const box = btn.getBoundingClientRect();
    const pointer = event instanceof MouseEvent && (event.clientX || event.clientY);
    const toast = document.createElement('span');
    toast.className = 'kit-toast';
    toast.textContent = message;
    toast.style.left = `${pointer ? event.clientX : box.left + box.width / 2}px`;
    toast.style.top = `${pointer ? event.clientY - 6 : box.top}px`;
    document.body.append(toast);
    toast.addEventListener('animationend', () => toast.remove(), { once: true });
    const label = btn.textContent;
    btn.textContent = message;
    btn.classList.add('is-done');
    window.setTimeout(() => {
      btn.textContent = label;
      btn.classList.remove('is-done');
    }, 1600);
  });
</script>
