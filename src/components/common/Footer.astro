---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '@/i18n/utils';
import { site, hasCV } from '@/data/site';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const currentYear = new Date().getFullYear();
const subject = encodeURIComponent(t('contact.mailto.subject'));
---

<!-- El reverso del artboard: mismos datos, colores invertidos -->
<footer class="artboard-back" data-cs="<footer> Footer.astro">
  <div class="wrap back-inner">
    <div class="back-cta">
      <h2 class="t-head" data-reveal>{t('footer.title')}</h2>
      <p class="t-lead back-lead" data-reveal style="--reveal-i: 1">{t('footer.lead')}</p>
      <div class="back-actions" data-reveal style="--reveal-i: 2">
        <a class="btn btn-primary" href={`mailto:${site.email}?subject=${subject}`}>
          {t('footer.email')}
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn-invert" href={translatePath('/contact')}>{t('footer.form')}</a>
      </div>
    </div>

    <ul class="back-links" data-reveal style="--reveal-i: 3">
      <li class="back-mail">
        <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
        <button type="button" class="back-copy" data-copy={site.email} data-copied={t('footer.copied')}>
          {t('footer.copy')}
        </button>
      </li>
      <li><a class="link" href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a></li>
      <li><a class="link" href={site.github} target="_blank" rel="noreferrer">GitHub ↗</a></li>
      {
        hasCV && (
          <li>
            <a class="link" href={site.cv} download>
              {t('hero.cta.cv')} ↓
            </a>
          </li>
        )
      }
    </ul>

    <p class="wordmark" aria-hidden="true">Christian Oller</p>

    <p class="t-small back-credits">
      {t('footer.credits')} © {currentYear} Christian Oller
    </p>
  </div>
</footer>

<style>
  .artboard-back {
    margin-top: clamp(6rem, 12vw, 10rem);
    padding-block: clamp(4rem, 8vw, 7rem) 2rem;
    background: var(--ink);
    color: var(--paper);
  }
  .back-inner {
    display: grid;
    gap: 3rem;
  }
  .back-cta {
    max-width: 44rem;
  }
  .back-lead {
    margin-top: 1rem;
    color: var(--paper);
  }
  .back-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .btn-invert {
    background: color-mix(in srgb, var(--paper) 12%, var(--ink));
    color: var(--paper);
  }
  .btn-invert:hover {
    background: var(--paper);
    color: var(--ink);
  }
  .back-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    font-size: var(--step-body);
  }
  .back-links a {
    display: inline-flex;
    min-height: 2.5rem;
    align-items: center;
  }
  .back-mail {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .back-copy {
    min-width: 4.75rem;
    min-height: 1.75rem;
    padding: 0 0.6rem;
    font: 500 0.8125rem/1 var(--font-mono);
    color: var(--paper);
    background: color-mix(in srgb, var(--paper) 14%, var(--ink));
    transition:
      background-color var(--dur-micro) var(--ease-out),
      color var(--dur-micro) var(--ease-out);
  }
  .back-copy:hover,
  .back-copy.is-done {
    color: var(--ink);
    background: var(--paper);
  }
  .wordmark {
    margin-top: 1rem;
    font-size: clamp(3rem, 12.4vw, 13rem);
    font-weight: 700;
    line-height: 0.8;
    letter-spacing: -0.055em;
    white-space: nowrap;
  }
  .back-credits {
    color: color-mix(in srgb, var(--paper) 72%, var(--ink));
  }
</style>

<script>
  // Copiar el email: el botón dice "Copiado" un momento y vuelve a su texto
  document.addEventListener('click', async (event) => {
    const btn = (event.target as Element | null)?.closest<HTMLButtonElement>('[data-copy]');
    if (!btn || btn.classList.contains('is-done')) return;
    try {
      await navigator.clipboard.writeText(btn.dataset.copy ?? '');
    } catch {
      return;
    }
    const label = btn.textContent;
    btn.textContent = btn.dataset.copied ?? '';
    btn.classList.add('is-done');
    window.setTimeout(() => {
      btn.textContent = label;
      btn.classList.remove('is-done');
    }, 1600);
  });
</script>
