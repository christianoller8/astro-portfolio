---
import ThemeToggle from './ThemeToggle.astro';
import LensSwitch from '@/components/site/LensSwitch.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '@/i18n/utils';
import { site, hasCV } from '@/data/site';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const navItems = [
  { key: 'nav.home', path: '/' },
  { key: 'nav.projects', path: '/projects' },
  { key: 'nav.about', path: '/about' },
  { key: 'nav.contact', path: '/contact' },
] as const;

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (path: string) => {
  const target = translatePath(path).replace(/\/$/, '') || '/';
  if (path === '/') return current === target;
  return current === target || current.startsWith(`${target}/`);
};
---

<header class="toolbar" data-cs="<header> Header.astro">
  <div class="toolbar-inner">
    <a href={translatePath('/')} class="brand" aria-label={t('aria.home')}>
      <span class="brand-mark" aria-hidden="true"></span>
      <span>Christian Oller</span>
    </a>

    <nav class="toolbar-nav" aria-label={t('nav.menu')}>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a
                href={translatePath(item.path)}
                class="nav-link"
                aria-current={isActive(item.path) ? 'page' : undefined}
              >
                {t(item.key)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="toolbar-lens">
      <LensSwitch variant="bar" lang={lang} />
    </div>

    <div class="toolbar-tools">
      <div class="lang">
        <a
          href={translatePath(Astro.url.pathname, 'es')}
          hreflang="es"
          aria-label={t('aria.lang.es')}
          aria-current={lang === 'es' ? 'true' : undefined}>ES</a
        >
        <a
          href={translatePath(Astro.url.pathname, 'en')}
          hreflang="en"
          aria-label={t('aria.lang.en')}
          aria-current={lang === 'en' ? 'true' : undefined}>EN</a
        >
      </div>
      <ThemeToggle />
      {
        hasCV && (
          <a class="btn btn-primary toolbar-cv" href={site.cv} download>
            {t('nav.cv')}
          </a>
        )
      }
      <button
        id="menu-btn"
        class="menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t('aria.menu')}
        data-label-open={t('aria.menu')}
        data-label-close={t('aria.close')}
      >
        <svg
          width="22"
          height="22"
          viewBox="0 0 22 22"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <path class="menu-line menu-line--top" d="M3 7.5h16"></path>
          <path class="menu-line menu-line--bottom" d="M3 14.5h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <div class="mobile-lens">
      <p class="t-small">{t('lens.label')}</p>
      <LensSwitch variant="bar" lang={lang} />
    </div>
    <nav aria-label={t('nav.menu')}>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a
                href={translatePath(item.path)}
                aria-current={isActive(item.path) ? 'page' : undefined}
              >
                {t(item.key)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    {
      hasCV && (
        <a class="btn btn-primary" href={site.cv} download>
          {t('hero.cta.cv')}
        </a>
      )
    }
  </div>
</header>

<style>
  .toolbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--canvas);
    view-transition-name: toolbar;
  }
  .toolbar-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: var(--toolbar-h);
    padding-inline: var(--gutter);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .brand-mark {
    width: 0.75rem;
    height: 0.75rem;
    background: var(--pencil);
    transition: transform var(--dur-ui) var(--ease-out);
  }
  .brand:hover .brand-mark {
    transform: rotate(45deg) scale(0.9);
  }

  .toolbar-nav {
    display: none;
  }
  .toolbar-nav ul {
    display: flex;
    gap: 0.125rem;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 0.85rem;
    font-size: var(--step-small);
    font-weight: 500;
    color: var(--muted);
    transition:
      color var(--dur-micro) var(--ease-out),
      background-color var(--dur-micro) var(--ease-out);
  }
  .nav-link:hover {
    color: var(--ink);
  }
  .nav-link[aria-current='page'] {
    color: var(--ink);
    background: var(--paper);
  }

  .toolbar-lens {
    display: none;
    margin-left: auto;
  }
  .toolbar-tools {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: auto;
  }
  .lang {
    display: flex;
  }
  .lang a {
    display: inline-grid;
    place-items: center;
    min-width: 2.5rem;
    min-height: 2.5rem;
    font-size: var(--step-small);
    font-weight: 600;
    color: var(--muted);
  }
  .lang a:hover,
  .lang a[aria-current='true'] {
    color: var(--ink);
  }
  .toolbar-cv {
    min-height: 2.5rem;
    margin-left: 0.25rem;
    padding-inline: 1rem;
  }
  .menu-btn {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
  }
  .menu-line {
    transition: transform var(--dur-ui) var(--ease-out);
    transform-origin: 11px 11px;
  }
  .menu-btn[aria-expanded='true'] .menu-line--top {
    transform: translateY(3.5px) rotate(45deg);
  }
  .menu-btn[aria-expanded='true'] .menu-line--bottom {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .mobile-menu {
    padding: 0.5rem var(--gutter) 1.5rem;
  }
  .mobile-lens {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    color: var(--muted);
  }
  .mobile-menu ul {
    display: grid;
    gap: 0.25rem;
    margin-bottom: 1.25rem;
  }
  .mobile-menu a:not(.btn) {
    display: block;
    padding: 0.35rem 0;
    font-size: var(--step-head);
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--muted);
  }
  .mobile-menu a[aria-current='page'] {
    color: var(--ink);
  }

  @media (min-width: 1024px) {
    .toolbar-nav {
      display: block;
      margin-left: 1.5rem;
    }
    .toolbar-lens {
      display: block;
    }
    .toolbar-tools {
      margin-left: 0.75rem;
    }
    .menu-btn,
    .mobile-menu {
      display: none;
    }
  }
</style>

<script>
  // La barra se vuelve a pintar en cada navegación: el botón se enlaza en cada carga, Escape una sola vez
  const setOpen = (open: boolean) => {
    const btn = document.getElementById('menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', (open ? btn.dataset.labelClose : btn.dataset.labelOpen) ?? '');
    menu.hidden = !open;
  };

  document.addEventListener('astro:page-load', () => {
    const btn = document.getElementById('menu-btn');
    btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  });

  document.addEventListener('keydown', (event) => {
    const menu = document.getElementById('mobile-menu');
    if (event.key === 'Escape' && menu && !menu.hidden) {
      setOpen(false);
      document.getElementById('menu-btn')?.focus();
    }
  });
</script>
