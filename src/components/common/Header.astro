---
import ThemeToggle from './ThemeToggle.astro';
import LangSwitch from './LangSwitch.astro';
import sign from '@/assets/images/brand/chris.webp';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '@/i18n/utils';
import { site } from '@/data/site';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const navItems = [
  { key: 'nav.home', path: '/' },
  { key: 'nav.projects', path: '/projects' },
  { key: 'nav.about', path: '/about' },
  { key: 'nav.contact', path: '/contact' },
] as const;

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (path: string) => {
  const target = translatePath(path).replace(/\/$/, '') || '/';
  if (path === '/') return current === target;
  return current === target || current.startsWith(`${target}/`);
};
---

<!-- La barra de herramientas (plan §5.1): marca · menú · preferencias (idioma y modo). El CV ya no va
     aquí en escritorio (20 nov): está en el hero, en Sobre mí y en el pie de todas las páginas.
     Desde el 20 nov (D23) es la primera fila del artboard: mismo papel, mismo ancho y alineada con el contenido.
     Las lentes y el lienzo ya no van aquí, ni en la barra ni en el menú de móvil: están en el
     bocadillo de la caricatura (ViewBubble.astro), abajo a la izquierda en todos los tamaños. -->

<header class="toolbar" data-cs="<header> Header.astro">
  <div class="toolbar-inner">
    {/* La marca es una firma, "Chris" (20 nov): la caricatura ya está en la intro y en el bocadillo
        de abajo, y repetida aquí sobraba. De momento es la palabra en Rock Salt, guardada como
        imagen (.taste-skill/letras/firma.mjs) y usada de máscara para que tome el color de la
        tinta; la idea es sustituirla por la firma de Christian escrita a mano */}
    <a href={translatePath('/')} class="brand" aria-label={t('aria.home')} data-sel>
      <span
        class="brand-sign"
        style={`--sign: url(${sign.src}); --sign-ratio: ${sign.width} / ${sign.height}`}
        aria-hidden="true"
      >
        <span class="brand-sign-ink"></span>
        <span class="brand-caret"></span>
      </span>
    </a>

    <nav class="toolbar-nav" aria-label={t('nav.menu')}>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a
                href={translatePath(item.path)}
                class="nav-link"
                aria-current={isActive(item.path) ? 'page' : undefined}
              >
                {t(item.key)}
                {isActive(item.path) && <span class="nav-ind" aria-hidden="true" />}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="toolbar-end">
      <div class="tool-prefs">
        <div class="tool-segs">
          <LangSwitch />
          <ThemeToggle />
        </div>
        <button
          id="menu-btn"
          class="menu-btn"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label={t('aria.menu')}
          data-label-open={t('aria.menu')}
          data-label-close={t('aria.close')}
        >
          <svg
            width="22"
            height="22"
            viewBox="0 0 22 22"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <path class="menu-line menu-line--top" d="M3 7.5h16"></path>
            <path class="menu-line menu-line--bottom" d="M3 14.5h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <nav aria-label={t('nav.menu')}>
      <ul>
        {
          navItems.map((item, i) => (
            <li style={`--i: ${i}`}>
              <a
                href={translatePath(item.path)}
                aria-current={isActive(item.path) ? 'page' : undefined}
              >
                {t(item.key)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    {/* Por debajo de 480 px los selectores de idioma y tema no caben en la barra: van aquí */}
    <div class="mobile-prefs" style="--i: 4">
      <LangSwitch size="menu" />
      <ThemeToggle size="menu" />
    </div>
    <div class="mobile-actions" style="--i: 5">
      <a class="btn btn-primary" href={site.cv} download>
        {t('nav.cv.download')}
      </a>
    </div>
  </div>
</header>

<style>
  /* La barra va dentro de la página: la misma hoja, del ancho del artboard
     y con el contenido alineado con el de las secciones (.wrap). En el paneo se queda quieta. */
  .toolbar {
    position: sticky;
    top: 0;
    z-index: 50;
    margin-inline: var(--gutter);
    view-transition-name: toolbar;
  }
  /* La hoja de la barra (::before) y su borde de abajo (::after). El borde no es una línea: es una
     franja de la misma hoja que se desvanece, así lo que pasa por debajo al hacer scroll se funde
     en vez de cortarse. Solo aparece con la página movida (html[data-scrolled]); arriba del todo
     taparía el principio del contenido. La textura se coloca donde cae la de la página. */
  .toolbar::before,
  .toolbar::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    z-index: -1;
    pointer-events: none;
    background: var(--sheet-bg);
  }
  .toolbar::before {
    inset-block: 0;
    background-position: calc(-1 * var(--gutter)) 0;
  }
  .toolbar::after {
    top: 100%;
    height: 2.25rem;
    background-position: calc(-1 * var(--gutter)) calc(-1 * var(--toolbar-h));
    -webkit-mask-image: linear-gradient(#000, rgb(0 0 0 / 0.55) 40%, transparent);
    mask-image: linear-gradient(#000, rgb(0 0 0 / 0.55) 40%, transparent);
    opacity: 0;
    transition: opacity 200ms var(--ease-out);
  }
  :global(html[data-scrolled]) .toolbar::after {
    opacity: 1;
  }
  /* 404: el frame que falta no tiene papel, así que la barra sigue sobre el lienzo */
  :global(html[data-missing]) .toolbar::before {
    background: var(--canvas);
  }
  :global(html[data-missing]) .toolbar::after {
    display: none;
  }
  .toolbar-inner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 82rem;
    /* --toolbar-h es el alto entero: la fila de 3,5rem más el aire de arriba (--toolbar-top), que
       va dentro de la barra para que su hoja lo tape cuando la página pasa por debajo */
    height: var(--toolbar-h);
    margin-inline: auto;
    padding-inline: var(--pad);
    padding-top: var(--toolbar-top);
  }

  /* --- Marca: la firma. Al pasar el ratón se selecciona --- */
  .brand {
    display: inline-flex;
    align-items: center;
    margin-left: -0.375rem;
    padding: 0.25rem 0.5rem 0.25rem 0.375rem;
  }
  /* En la barra la selección va sin la etiqueta de medida: taparía el nombre del frame */
  .brand::after {
    display: none;
  }
  /* La imagen de la firma hace de máscara: lo que se ve es la tinta del tema, en claro y en oscuro */
  .brand-sign {
    position: relative;
    display: block;
    width: 6.5rem;
    aspect-ratio: var(--sign-ratio);
    rotate: -3deg;
  }
  .brand-sign-ink {
    position: absolute;
    inset: 0;
    background: var(--ink);
    -webkit-mask: var(--sign) center / contain no-repeat;
    mask: var(--sign) center / contain no-repeat;
  }
  .brand-caret {
    display: none;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .brand-sign {
      transition: rotate var(--dur-ui) var(--spring);
    }
    .brand:hover .brand-sign {
      rotate: -7deg;
    }
  }

  /* La firma se escribe a máquina al cargar la web (pedido por Christian el 20 nov): se destapa de
     izquierda a derecha a saltos, uno por letra, en el punto donde acaba cada una (medido sobre la
     imagen: C 22 %, H 45,1 %, R 74,9 %, I 83,5 %, S 100 %), con un cursor delante que parpadea un
     par de veces y se va. Solo al cargar: al pasar de una página a otra (html.arrived) la barra se
     vuelve a pintar y la firma ya está escrita. En la home espera a que acabe la intro */
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not(.arrived)) .brand-sign-ink {
      animation: brand-type 700ms step-end 450ms both;
    }
    :global(html:not(.arrived)) .brand-caret {
      position: absolute;
      top: 4%;
      bottom: 4%;
      left: 0;
      display: block;
      width: 2px;
      background: var(--ink);
      animation:
        brand-caret 700ms step-end 450ms both,
        brand-blink 460ms step-end infinite,
        brand-caret-out 1ms linear 2450ms forwards;
    }
    :global(html.intro) .brand-sign-ink,
    :global(html.intro) .brand-caret {
      animation-play-state: paused;
    }
  }
  /* Con step-end cada valor se mantiene hasta el siguiente: una letra más en cada paso */
  @keyframes brand-type {
    0% {
      clip-path: inset(-15% 100% -15% 0);
    }
    20% {
      clip-path: inset(-15% 78% -15% 0);
    }
    40% {
      clip-path: inset(-15% 54.9% -15% 0);
    }
    60% {
      clip-path: inset(-15% 25.1% -15% 0);
    }
    80% {
      clip-path: inset(-15% 16.5% -15% 0);
    }
    100% {
      clip-path: inset(-15% -5% -15% 0);
    }
  }
  @keyframes brand-caret {
    0% {
      left: 0;
    }
    20% {
      left: 22%;
    }
    40% {
      left: 45.1%;
    }
    60% {
      left: 74.9%;
    }
    80% {
      left: 83.5%;
    }
    100% {
      left: 102%;
    }
  }
  @keyframes brand-blink {
    50% {
      opacity: 0;
    }
  }
  /* Va la última en la lista de animaciones del cursor: al acabar manda sobre el parpadeo */
  @keyframes brand-caret-out {
    to {
      opacity: 0;
    }
  }

  /* --- Menú --- */
  .toolbar-nav {
    display: none;
    margin-inline: auto;
  }
  .toolbar-nav ul {
    display: flex;
    gap: 0.125rem;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 0.8rem;
    font-size: var(--step-small);
    font-weight: 500;
    color: var(--muted);
    transition:
      color var(--dur-micro) var(--ease-out),
      background-color var(--dur-micro) var(--ease-out);
  }
  .nav-link:hover {
    color: var(--ink);
  }
  /* El cuadradito de selección del enlace activo: viaja de un enlace a otro con la transición */
  .nav-link {
    position: relative;
  }
  .nav-ind {
    position: absolute;
    bottom: 3px;
    left: calc(50% - 2.5px);
    width: 5px;
    height: 5px;
    background: var(--ink);
    view-transition-name: nav-ind;
  }
  /* La página actual, sobre un paso de tinte (la barra ya es papel) */
  .nav-link[aria-current='page'] {
    color: var(--ink);
    background: var(--tint);
  }

  /* --- Derecha: dos grupos --- */
  .toolbar-end {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
  }

  /* Preferencias: idioma y modo */
  .tool-prefs {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }
  /* Los selectores de idioma y tema (la pieza .seg de kit.css), separados para que se lean como dos
     controles. En pantallas táctiles, celdas de 36 px; por debajo de 480 px no caben y pasan al menú */
  .tool-segs {
    display: none;
    align-items: center;
    gap: 0.875rem;
  }
  .tool-segs :global(.seg) {
    --seg-cell: 2.25rem;
  }
  @media (min-width: 480px) {
    .tool-segs {
      display: flex;
    }
  }
  /* En escritorio, celdas de 32 px */
  @media (min-width: 1024px) {
    .tool-segs :global(.seg) {
      --seg-cell: 2rem;
    }
  }
  .menu-btn {
    display: inline-grid;
    place-items: center end;
    width: 2.75rem;
    height: 2.75rem;
  }
  /* Las dos rayas acaban en el borde derecho del frame */
  .menu-btn svg {
    margin-right: -3px;
  }
  .menu-line {
    transition: transform var(--dur-ui) var(--ease-out);
    transform-origin: 11px 11px;
  }
  .menu-btn[aria-expanded='true'] .menu-line--top {
    transform: translateY(3.5px) rotate(45deg);
  }
  .menu-btn[aria-expanded='true'] .menu-line--bottom {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  /* --- Menú de móvil y tablet --- */
  .mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: grid;
    grid-template-rows: 1fr;
    grid-auto-rows: auto;
    height: calc(100dvh - var(--toolbar-h));
    padding: 1rem var(--pad) max(1.25rem, env(safe-area-inset-bottom));
    overflow-y: auto;
    background: var(--sheet-bg);
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .mobile-menu ul {
    display: grid;
    gap: 0.125rem;
  }
  .mobile-menu a:not(.btn) {
    display: block;
    padding: 0.3rem 0;
    font-size: clamp(2.75rem, 13vw, 4.5rem);
    font-weight: var(--wght-ink);
    letter-spacing: -0.04em;
    line-height: 1.02;
    color: var(--muted);
  }
  .mobile-menu a[aria-current='page'] {
    color: var(--ink);
  }
  .mobile-prefs {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  @media (min-width: 480px) {
    .mobile-prefs {
      display: none;
    }
  }
  /* La única acción del menú: descargar el CV, a todo el ancho */
  .mobile-actions {
    display: grid;
    margin-top: 1rem;
  }

  /* Entrada del menú: la capa aparece y los enlaces suben uno detrás de otro */
  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu:not([hidden]) {
      animation: menu-in var(--dur-ui) var(--ease-out) both;
    }
    .mobile-menu:not([hidden]) li,
    .mobile-menu:not([hidden]) .mobile-prefs,
    .mobile-menu:not([hidden]) .mobile-actions {
      animation: menu-item-in var(--dur-ink) var(--ease-out) both;
      animation-delay: calc(var(--i, 0) * var(--stagger) + 40ms);
    }
  }
  @keyframes menu-in {
    from {
      opacity: 0;
    }
  }
  @keyframes menu-item-in {
    from {
      opacity: 0;
      transform: translateY(var(--dist));
    }
  }
  @media (max-width: 1023px) {
    :global(html.menu-open) {
      overflow: hidden;
    }
  }


  @media (min-width: 1024px) {
    .toolbar-nav {
      display: block;
    }
    .toolbar-end {
      margin-left: 0;
    }
    .menu-btn,
    .mobile-menu {
      display: none;
    }
  }

</style>

<script>
  // La barra se vuelve a pintar en cada navegación: el botón se enlaza en cada carga, Escape una sola vez
  const setOpen = (open: boolean) => {
    const btn = document.getElementById('menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', (open ? btn.dataset.labelClose : btn.dataset.labelOpen) ?? '');
    menu.hidden = !open;
    document.documentElement.classList.toggle('menu-open', open);
  };

  // La barra funde su borde con lo que pasa por debajo solo cuando la página se ha movido
  const markScrolled = () => document.documentElement.toggleAttribute('data-scrolled', window.scrollY > 2);
  window.addEventListener('scroll', markScrolled, { passive: true });

  document.addEventListener('astro:page-load', () => {
    markScrolled();
    // Al llegar a otra página el menú vuelve cerrado
    document.documentElement.classList.remove('menu-open');
    const btn = document.getElementById('menu-btn');
    btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  });

  document.addEventListener('keydown', (event) => {
    const menu = document.getElementById('mobile-menu');
    if (event.key === 'Escape' && menu && !menu.hidden) {
      setOpen(false);
      document.getElementById('menu-btn')?.focus();
    }
  });
</script>
