---
import ThemeToggle from './ThemeToggle.astro';
import LangSwitch from './LangSwitch.astro';
import LensSwitch from '@/components/site/LensSwitch.astro';
import Caricature from '@/components/site/Caricature.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '@/i18n/utils';
import { site } from '@/data/site';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const navItems = [
  { key: 'nav.home', path: '/' },
  { key: 'nav.projects', path: '/projects' },
  { key: 'nav.about', path: '/about' },
  { key: 'nav.contact', path: '/contact' },
] as const;

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (path: string) => {
  const target = translatePath(path).replace(/\/$/, '') || '/';
  if (path === '/') return current === target;
  return current === target || current.startsWith(`${target}/`);
};
---

<!-- La barra de herramientas (plan §5.1): marca · menú · vista (lentes y lienzo) · preferencias (idioma, modo, CV).
     Desde el 20 nov (D23) es la primera fila del artboard: mismo papel, mismo ancho y alineada con el contenido. -->

<header class="toolbar" data-cs="<header> Header.astro">
  <div class="toolbar-inner">
    <a href={translatePath('/')} class="brand" aria-label={t('aria.home')} data-sel>
      <Caricature variant="mark" class="brand-head" />
      <span class="brand-name" aria-hidden="true"><span class="brand-made">made by</span> chris</span>
    </a>

    <nav class="toolbar-nav" aria-label={t('nav.menu')}>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a
                href={translatePath(item.path)}
                class="nav-link"
                aria-current={isActive(item.path) ? 'page' : undefined}
              >
                {t(item.key)}
                {isActive(item.path) && <span class="nav-ind" aria-hidden="true" />}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="toolbar-end">
      <div class="tool-view">
        <LensSwitch variant="bar" lang={lang} />
        <span class="tool-sep" aria-hidden="true"></span>
        <button
          type="button"
          class="tool-btn"
          data-canvas-open
          aria-keyshortcuts="M"
          title={`${t('nav.canvas')} (M)`}
        >
          <svg
            viewBox="0 0 16 16"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            aria-hidden="true"
          >
            <rect x="1.5" y="2" width="5.5" height="7.5"></rect>
            <rect x="9.5" y="2" width="5" height="4"></rect>
            <rect x="9.5" y="8.5" width="5" height="5.5"></rect>
            <rect x="1.5" y="12" width="5.5" height="2"></rect>
          </svg>
          <span class="tool-label">{t('nav.canvas')}</span>
          <kbd>M</kbd>
        </button>
      </div>

      <div class="tool-prefs">
        <div class="tool-segs">
          <LangSwitch />
          <ThemeToggle />
        </div>
        <a class="btn btn-primary toolbar-cv" href={site.cv} download aria-label={t('nav.cv.download')}>
          {t('nav.cv')}
          <svg
            viewBox="0 0 14 14"
            width="14"
            height="14"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            aria-hidden="true"
          >
            <path d="M7 1.5v8M3.5 6.5 7 10l3.5-3.5M2 12.5h10"></path>
          </svg>
        </a>
        <button
          id="menu-btn"
          class="menu-btn"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label={t('aria.menu')}
          data-label-open={t('aria.menu')}
          data-label-close={t('aria.close')}
        >
          <svg
            width="22"
            height="22"
            viewBox="0 0 22 22"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <path class="menu-line menu-line--top" d="M3 7.5h16"></path>
            <path class="menu-line menu-line--bottom" d="M3 14.5h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <nav aria-label={t('nav.menu')}>
      <ul>
        {
          navItems.map((item, i) => (
            <li style={`--i: ${i}`}>
              <a
                href={translatePath(item.path)}
                aria-current={isActive(item.path) ? 'page' : undefined}
              >
                {t(item.key)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="mobile-view" style="--i: 4">
      <p class="t-small">{t('lens.label')}</p>
      <LensSwitch variant="bar" lang={lang} />
    </div>
    {/* Por debajo de 480 px los selectores de idioma y tema no caben en la barra: van aquí */}
    <div class="mobile-prefs" style="--i: 5">
      <LangSwitch size="menu" />
      <ThemeToggle size="menu" />
    </div>
    <div class="mobile-actions" style="--i: 6">
      <button type="button" class="btn btn-quiet" data-canvas-open>
        {t('nav.canvas')}
      </button>
      <a class="btn btn-primary" href={site.cv} download>
        {t('nav.cv.download')}
      </a>
    </div>
  </div>
</header>

<style>
  /* La barra va dentro de la página: la misma hoja, del ancho del artboard
     y con el contenido alineado con el de las secciones (.wrap). En el paneo se queda quieta. */
  .toolbar {
    position: sticky;
    top: 0;
    z-index: 50;
    margin-inline: var(--gutter);
    view-transition-name: toolbar;
  }
  /* La hoja de la barra (::before) y su borde de abajo (::after). El borde no es una línea: es una
     franja de la misma hoja que se desvanece, así lo que pasa por debajo al hacer scroll se funde
     en vez de cortarse. Solo aparece con la página movida (html[data-scrolled]); arriba del todo
     taparía el principio del contenido. La textura se coloca donde cae la de la página. */
  .toolbar::before,
  .toolbar::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    z-index: -1;
    pointer-events: none;
    background: var(--sheet-bg);
  }
  .toolbar::before {
    inset-block: 0;
    background-position: calc(-1 * var(--gutter)) 0;
  }
  .toolbar::after {
    top: 100%;
    height: 2.25rem;
    background-position: calc(-1 * var(--gutter)) calc(-1 * var(--toolbar-h));
    -webkit-mask-image: linear-gradient(#000, rgb(0 0 0 / 0.55) 40%, transparent);
    mask-image: linear-gradient(#000, rgb(0 0 0 / 0.55) 40%, transparent);
    opacity: 0;
    transition: opacity 200ms var(--ease-out);
  }
  :global(html[data-scrolled]) .toolbar::after {
    opacity: 1;
  }
  /* 404: el frame que falta no tiene papel, así que la barra sigue sobre el lienzo */
  :global(html[data-missing]) .toolbar::before {
    background: var(--canvas);
  }
  :global(html[data-missing]) .toolbar::after {
    display: none;
  }
  .toolbar-inner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 82rem;
    height: var(--toolbar-h);
    margin-inline: auto;
    padding-inline: var(--pad);
  }

  /* --- Marca: la caricatura reducida y "made by chris" en una línea. Al pasar el ratón se selecciona --- */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: -0.375rem;
    padding: 0.25rem 0.5rem 0.25rem 0.375rem;
    white-space: nowrap;
  }
  /* En la barra la selección va sin la etiqueta de medida: taparía el nombre del frame */
  .brand::after {
    display: none;
  }
  .brand :global(.brand-head) {
    flex: none;
    width: auto;
    height: 2.25rem;
  }
  .brand-name {
    font-size: 1.125rem;
    font-weight: var(--wght-ink);
    letter-spacing: -0.035em;
  }
  .brand-made {
    font-weight: 400;
    letter-spacing: -0.02em;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .brand :global(.brand-head) {
      transform-origin: 50% 85%;
      transition: transform var(--dur-ui) var(--spring);
    }
    .brand:hover :global(.brand-head) {
      transform: rotate(-7deg);
    }
  }

  /* --- Menú --- */
  .toolbar-nav {
    display: none;
    margin-inline: auto;
  }
  .toolbar-nav ul {
    display: flex;
    gap: 0.125rem;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 0.8rem;
    font-size: var(--step-small);
    font-weight: 500;
    color: var(--muted);
    transition:
      color var(--dur-micro) var(--ease-out),
      background-color var(--dur-micro) var(--ease-out);
  }
  .nav-link:hover {
    color: var(--ink);
  }
  /* El cuadradito de selección del enlace activo: viaja de un enlace a otro con la transición */
  .nav-link {
    position: relative;
  }
  .nav-ind {
    position: absolute;
    bottom: 3px;
    left: calc(50% - 2.5px);
    width: 5px;
    height: 5px;
    background: var(--ink);
    view-transition-name: nav-ind;
  }
  /* La página actual, sobre un paso de tinte (la barra ya es papel) */
  .nav-link[aria-current='page'] {
    color: var(--ink);
    background: var(--tint);
  }

  /* --- Derecha: dos grupos --- */
  .toolbar-end {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
  }

  /* Vista: las tres lentes y "Ver lienzo" en una sola bandeja */
  .tool-view {
    display: none;
    align-items: center;
    gap: 2px;
    padding: 3px;
    background: var(--tint);
  }
  .tool-view :global(.lens-switch) {
    padding: 0;
    background: none;
  }
  .tool-view :global(.lens-btn) {
    min-height: 2rem;
  }
  .tool-sep {
    width: 1px;
    height: 1.125rem;
    margin-inline: 0.25rem;
    background: var(--line);
  }
  .tool-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2rem;
    padding: 0 0.5rem 0 0.7rem;
    font-size: var(--step-small);
    font-weight: 600;
    color: var(--muted);
    transition:
      background-color var(--dur-micro) var(--ease-out),
      color var(--dur-micro) var(--ease-out),
      transform var(--dur-micro) var(--ease-out);
  }
  .tool-btn:hover {
    color: var(--ink);
  }
  /* Con el lienzo abierto, el botón queda marcado como las lentes */
  .tool-btn[aria-pressed='true'] {
    color: var(--pencil-ink);
    background: var(--pencil);
  }
  .tool-btn[aria-pressed='true'] kbd {
    color: var(--pencil);
  }
  .tool-btn:active {
    transform: scale(0.97);
  }
  .tool-btn svg {
    flex: none;
  }
  .tool-btn kbd {
    display: inline-grid;
    place-items: center;
    min-width: 1.35rem;
    height: 1.35rem;
    font: 500 0.75rem/1 var(--font-mono);
    color: var(--muted);
    background: var(--paper);
  }

  /* Preferencias: idioma, modo y CV */
  .tool-prefs {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }
  /* Los selectores de idioma y tema (la pieza .seg de kit.css). En pantallas táctiles, celdas de
     36 px; por debajo de 480 px no caben y pasan al menú */
  .tool-segs {
    display: none;
    align-items: center;
    gap: 0.375rem;
  }
  .tool-segs :global(.seg) {
    --seg-cell: 2.25rem;
  }
  @media (min-width: 480px) {
    .tool-segs {
      display: flex;
    }
  }
  /* En escritorio, la misma altura que la bandeja de lentes */
  @media (min-width: 1024px) {
    .tool-segs :global(.seg) {
      --seg-cell: 2rem;
    }
  }
  .toolbar-cv {
    display: none;
    gap: 0.4rem;
    min-height: 2.375rem;
    padding: 0 0.8rem;
  }
  .menu-btn {
    display: inline-grid;
    place-items: center end;
    width: 2.75rem;
    height: 2.75rem;
  }
  /* Las dos rayas acaban en el borde derecho del frame */
  .menu-btn svg {
    margin-right: -3px;
  }
  .menu-line {
    transition: transform var(--dur-ui) var(--ease-out);
    transform-origin: 11px 11px;
  }
  .menu-btn[aria-expanded='true'] .menu-line--top {
    transform: translateY(3.5px) rotate(45deg);
  }
  .menu-btn[aria-expanded='true'] .menu-line--bottom {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  /* --- Menú de móvil y tablet --- */
  .mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: grid;
    grid-template-rows: 1fr;
    grid-auto-rows: auto;
    height: calc(100dvh - var(--toolbar-h));
    padding: 1rem var(--pad) max(1.25rem, env(safe-area-inset-bottom));
    overflow-y: auto;
    background: var(--sheet-bg);
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .mobile-menu ul {
    display: grid;
    gap: 0.125rem;
  }
  .mobile-menu a:not(.btn) {
    display: block;
    padding: 0.3rem 0;
    font-size: clamp(2.75rem, 13vw, 4.5rem);
    font-weight: var(--wght-ink);
    letter-spacing: -0.04em;
    line-height: 1.02;
    color: var(--muted);
  }
  .mobile-menu a[aria-current='page'] {
    color: var(--ink);
  }
  .mobile-view {
    display: grid;
    justify-items: start;
    gap: 0.5rem;
    margin-top: 1.5rem;
    color: var(--muted);
  }
  .mobile-prefs {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  @media (min-width: 480px) {
    .mobile-prefs {
      display: none;
    }
  }
  .mobile-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .mobile-actions .btn-quiet {
    background: var(--tint);
  }

  /* Entrada del menú: la capa aparece y los enlaces suben uno detrás de otro */
  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu:not([hidden]) {
      animation: menu-in var(--dur-ui) var(--ease-out) both;
    }
    .mobile-menu:not([hidden]) li,
    .mobile-menu:not([hidden]) .mobile-view,
    .mobile-menu:not([hidden]) .mobile-prefs,
    .mobile-menu:not([hidden]) .mobile-actions {
      animation: menu-item-in var(--dur-ink) var(--ease-out) both;
      animation-delay: calc(var(--i, 0) * var(--stagger) + 40ms);
    }
  }
  @keyframes menu-in {
    from {
      opacity: 0;
    }
  }
  @keyframes menu-item-in {
    from {
      opacity: 0;
      transform: translateY(var(--dist));
    }
  }
  @media (max-width: 1023px) {
    :global(html.menu-open) {
      overflow: hidden;
    }
  }

  /* La barra lleva ahora los márgenes del contenido (D23): por debajo de 390 px "made by" no cabe */
  @media (max-width: 389px) {
    .brand-made {
      display: none;
    }
  }

  @media (min-width: 1024px) {
    .toolbar-nav {
      display: block;
    }
    .toolbar-end {
      margin-left: 0;
    }
    .tool-view {
      display: flex;
    }
    .toolbar-cv {
      display: inline-flex;
    }
    .menu-btn,
    .mobile-menu {
      display: none;
    }
  }

  /* A 1024 px la barra va justa (los selectores de idioma y tema ocupan más que antes): el menú se aprieta */
  @media (min-width: 1024px) and (max-width: 1099px) {
    .toolbar-inner {
      gap: 0.5rem;
    }
    .nav-link {
      padding: 0 0.55rem;
    }
  }

  /* Entre 1024 y 1359 px no caben los rótulos: las lentes y el lienzo se quedan en icono (el nombre sigue en el title) */
  @media (min-width: 1024px) and (max-width: 1359px) {
    .tool-view :global(.lens-btn span),
    .tool-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .tool-view :global(.lens-btn),
    .tool-btn {
      justify-content: center;
      min-width: 2.25rem;
      padding: 0 0.5rem;
    }
    .tool-btn kbd {
      display: none;
    }
  }
</style>

<script>
  // La barra se vuelve a pintar en cada navegación: el botón se enlaza en cada carga, Escape una sola vez
  const setOpen = (open: boolean) => {
    const btn = document.getElementById('menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', (open ? btn.dataset.labelClose : btn.dataset.labelOpen) ?? '');
    menu.hidden = !open;
    document.documentElement.classList.toggle('menu-open', open);
  };

  // La barra funde su borde con lo que pasa por debajo solo cuando la página se ha movido
  const markScrolled = () => document.documentElement.toggleAttribute('data-scrolled', window.scrollY > 2);
  window.addEventListener('scroll', markScrolled, { passive: true });

  document.addEventListener('astro:page-load', () => {
    markScrolled();
    // Al llegar a otra página el menú vuelve cerrado
    document.documentElement.classList.remove('menu-open');
    const btn = document.getElementById('menu-btn');
    btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  });

  document.addEventListener('keydown', (event) => {
    const menu = document.getElementById('mobile-menu');
    if (event.key === 'Escape' && menu && !menu.hidden) {
      setOpen(false);
      document.getElementById('menu-btn')?.focus();
    }
  });
</script>
