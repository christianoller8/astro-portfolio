---
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

interface Props {
  /** "menu": celdas grandes, para el menú de móvil */
  size?: 'bar' | 'menu';
}

const { size = 'bar' } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
---

<!-- Selector de tema (D26): las dos opciones a la vista y la activa marcada (la pieza .seg de kit.css).
     La marca y el color de los iconos salen de html.dark, así que están bien antes de que cargue el guion. -->
<div class:list={['seg', 'seg--theme', size === 'menu' && 'seg--lg']} role="group" aria-label={t('aria.theme')}>
  <span class="seg-pad" aria-hidden="true"></span>
  <button type="button" class="seg-opt" data-theme-set="light" aria-pressed="false" aria-label={t('aria.theme.light')} title={t('aria.theme.light')}>
    <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true">
      <circle cx="8" cy="8" r="2.75"></circle>
      <path d="M8 1.25v1.5M8 13.25v1.5M1.25 8h1.5M13.25 8h1.5M3.23 3.23l1.06 1.06M11.71 11.71l1.06 1.06M12.77 3.23l-1.06 1.06M4.29 11.71l-1.06 1.06"></path>
    </svg>
  </button>
  <button type="button" class="seg-opt" data-theme-set="dark" aria-pressed="false" aria-label={t('aria.theme.dark')} title={t('aria.theme.dark')}>
    <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="miter" aria-hidden="true">
      <path d="M13.5 9.6A5.75 5.75 0 0 1 6.4 2.5a5.75 5.75 0 1 0 7.1 7.1Z"></path>
    </svg>
  </button>
</div>

<script>
  // Un solo oyente para todos los selectores (el de la barra y el del menú de móvil)
  const root = document.documentElement;
  const sync = () => {
    const dark = root.classList.contains('dark');
    for (const btn of document.querySelectorAll<HTMLElement>('[data-theme-set]')) {
      btn.setAttribute('aria-pressed', String((btn.dataset.themeSet === 'dark') === dark));
    }
  };

  document.addEventListener('click', (event) => {
    const btn = event.target instanceof Element ? event.target.closest<HTMLElement>('[data-theme-set]') : null;
    if (!btn) return;
    const dark = btn.dataset.themeSet === 'dark';
    if (dark === root.classList.contains('dark')) return;
    // El cambio de color va escalonado (estilos en global.css)
    root.classList.add('theme-switching');
    window.setTimeout(() => root.classList.remove('theme-switching'), 340);
    root.classList.toggle('dark', dark);
    // La barra del navegador sigue a la hoja del tema que se ve (la lee del token, no se repite aquí)
    const sheet = getComputedStyle(root).getPropertyValue('--sheet').trim();
    if (sheet) document.querySelector('meta[name="theme-color"]')?.setAttribute('content', sheet);
    sync();
    // El almacenamiento puede estar bloqueado: el tema cambia igual, solo no se recuerda
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {}
  });

  document.addEventListener('astro:page-load', sync);
</script>
