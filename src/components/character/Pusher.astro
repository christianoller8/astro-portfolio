---
// El personaje de la transición entre páginas. Vive en el hueco de lienzo que queda entre la página
// que sale y la que entra, y solo se ve mientras dura el cambio (html.is-panning).
// El hueco se desplaza con las páginas (::view-transition-group(pusher), en global.css); las
// piernas y los brazos los mueve src/scripts/frames.ts.
import Character from './Character.astro';
---

<div class="pusher" data-pusher aria-hidden="true">
  <div class="pusher-stage">
    <Character class="pusher-chr" defer />
  </div>
</div>

<script>
  // Unas veinte imágenes (~100 KB, el 22 % de los bytes de cada página) que solo se ven mientras dura
  // una transición. No se piden con la página: se activan en cuanto ha cargado y hay un respiro, de modo
  // que el personaje ya está completo (y en la caché) cuando se navega por primera vez. Si se navega
  // antes, se activan también al empezar la navegación (en paralelo a la descarga de la página) y en
  // cuanto hay intención de navegar (ratón o foco sobre un enlace interno).
  // Con 'reducir movimiento' o ahorro de datos no se descargan: en ese caso no hay paneo.
  const canWarm = () => {
    const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    return !window.matchMedia('(prefers-reduced-motion: reduce)').matches && !connection?.saveData;
  };
  const warm = (root: ParentNode) => {
    if (!canWarm()) return;
    root.querySelectorAll<HTMLImageElement>('[data-pusher] img[data-src]').forEach((img) => {
      img.src = img.dataset.src ?? '';
      img.removeAttribute('data-src');
    });
  };

  const whenIdle = () => {
    const run = () => warm(document);
    // Safari no tiene requestIdleCallback
    if (typeof window.requestIdleCallback === 'function') window.requestIdleCallback(run, { timeout: 1500 });
    else setTimeout(run, 800);
  };
  if (document.readyState === 'complete') whenIdle();
  else window.addEventListener('load', () => window.setTimeout(whenIdle, 300), { once: true });

  // Intención de navegar: primer ratón o foco sobre un enlace interno
  const intent = (event: Event) => {
    const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[href]') : null;
    if (link && link.origin === location.origin && !link.hasAttribute('download')) warm(document);
  };
  document.addEventListener('pointerover', intent, { passive: true });
  document.addEventListener('focusin', intent);
  // Empieza la navegación: se pide a la vez que la página nueva
  document.addEventListener('astro:before-preparation', () => warm(document));

  // La página que llega trae su propio personaje sin activar: se activa antes del swap para que
  // arranque a cargar (desde la caché) a la vez que entra, como cuando iba con la página.
  document.addEventListener('astro:before-swap', (event) => warm((event as Event & { newDocument: Document }).newDocument));
</script>

<style>
  .pusher {
    position: fixed;
    top: 0;
    /* Empieza un margen de lienzo antes: así las manos llegan al canto del frame, no al del lienzo */
    left: calc(-1 * var(--gutter));
    z-index: 90;
    width: calc(var(--pusher-gap) + var(--gutter));
    height: 100dvh;
    pointer-events: none;
    opacity: 0;
    view-transition-name: pusher;
  }
  :global(html.is-panning) .pusher {
    opacity: 1;
  }
  /* El origen del escenario es el canto de la página (el borde izquierdo del hueco): character.ts
     coloca al personaje de modo que su mano quede justo ahí, un punto montada sobre la página.
     - Hacia delante mira a la izquierda y empuja ese canto.
     - Hacia atrás mira a la derecha, que es hacia donde va, y lo lleva agarrado a su espalda. */
  .pusher-stage {
    position: absolute;
    bottom: max(5vh, 1.5rem);
    left: calc(var(--pusher-h) * -0.006);
    transform: scaleX(-1);
  }
  :global(html.frame-back) .pusher-stage {
    left: calc(var(--pusher-h) * -0.02);
    transform: none;
  }
  .pusher-stage :global(.pusher-chr) {
    --h: var(--pusher-h);
  }
  /* En oscuro, un filo claro alrededor de la silueta (como la pegatina de la marca): la sudadera
     negra no se pierde sobre el lienzo carbón */
  :global(:root.dark) .pusher-stage :global(.pusher-chr) {
    filter: drop-shadow(0 0 1px #f5f5f5) drop-shadow(0 0 1px #f5f5f5);
  }
  /* Sombra en el suelo */
  .pusher-stage::before {
    content: '';
    position: absolute;
    top: calc(var(--pusher-h) * -0.02);
    left: calc(var(--pusher-h) * 0.12);
    width: calc(var(--pusher-h) * 0.66);
    height: calc(var(--pusher-h) * 0.05);
    background: radial-gradient(closest-side, rgb(0 0 0 / 0.26), transparent);
  }
</style>
