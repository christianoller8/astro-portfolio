---
// Un proyecto en cajas (referencia de organización: poulo.site; se toma la idea, no su estilo):
// - arriba, el nombre y sus datos;
// - una caja grande con la pieza del proyecto (hoy, su interfaz; cuando haya vídeo, el vídeo);
// - una caja con el resumen, el papel y el botón al caso;
// - una fila de cajas pequeñas, una por decisión (las de src/data/cases.ts).
// Las cajas son del sistema: planas, sobre --tint, con esquinas rectas. Entre ellas se ve la hoja.
// data-morph-title y data-morph-visual son los que usa frames.ts para el paso de la tarjeta al caso.
import type { CollectionEntry } from 'astro:content';
import ProjectVisual from './ProjectVisual.astro';
import { cases } from '@/data/cases';
import { useTranslations, useTranslatedPath } from '@/i18n/utils';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: 'es' | 'en';
  /** La interfaz de la caja grande se puede tocar (project-demos.ts) */
  interactive?: boolean;
}

const { project, lang, interactive = false } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const { title, description, kind, status, role, year, stack } = project.data;
const href = translatePath(`/projects/${project.slug}`);
const facts = [t(kind === 'app' ? 'project.kind.app' : 'project.kind.web'), status, year].filter(Boolean).join(' · ');
const decisions = cases[project.slug]?.decisions ?? [];
---

<article class="bento" data-cs="<article> ProjectBento.astro">
  <header class="bento-head">
    {/* El nombre de transición va en el h2 (una caja), no en el enlace: en un elemento en línea no hace efecto */}
    <h2 class="bento-title" data-morph-title={project.slug}>
      <a href={href}>{title}</a>
    </h2>
    <p class="bento-facts">{facts}</p>
  </header>

  <div class="bento-grid">
    <div class="bento-visual" data-morph-visual={project.slug} data-sel>
      <ProjectVisual project={project} lang={lang} interactive={interactive} />
    </div>

    <div class="bento-box bento-about">
      <p class="bento-desc">{description}</p>
      <dl class="bento-meta">
        <div>
          <dt>{t('project.role')}</dt>
          <dd>{role}</dd>
        </div>
        {
          stack.length > 0 && (
            <div>
              <dt>{t('project.stack')}</dt>
              <dd>{stack.join(' · ')}</dd>
            </div>
          )
        }
      </dl>
      <a class="btn btn-primary bento-cta" href={href} aria-label={`${t('projects.case')}: ${title}`}>
        {t('projects.case')} <span aria-hidden="true">→</span>
      </a>
    </div>

    {
      decisions.length > 0 && (
        <ol class="bento-decisions">
          {decisions.map((decision) => (
            <li class="bento-box bento-decision">
              <p class="bento-note">{decision.note[lang]}</p>
              <h3 class="bento-decision-title">{decision.title[lang]}</h3>
              <p class="bento-decision-body">{decision.body[lang]}</p>
            </li>
          ))}
        </ol>
      )
    }
  </div>
</article>

<style>
  .bento {
    --bento-gap: 0.5rem;
    container-type: inline-size;
  }
  .bento-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    margin-bottom: 1.25rem;
  }
  .bento-title {
    font-size: var(--step-head);
    font-weight: var(--wght-ink);
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .bento-facts {
    font-size: var(--step-small);
    font-weight: 600;
    color: var(--muted);
  }

  .bento-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--bento-gap);
  }
  .bento-box {
    padding: 1.25rem 1.25rem 1.5rem;
    background: var(--tint);
  }
  /* La caja grande es la propia pieza: sin relleno, a sangre. Si el resumen de al lado queda más
     alto que ella, lo que sobra debajo es caja y no hoja */
  .bento-visual {
    min-width: 0;
    background: var(--tint);
  }

  .bento-about {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .bento-desc {
    font-size: var(--step-lead);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }
  .bento-meta {
    display: grid;
    gap: 0.9rem;
  }
  .bento-meta dt {
    font-size: var(--step-small);
    font-weight: 600;
    color: var(--muted);
  }
  .bento-meta dd {
    margin-top: 0.1rem;
    font-weight: 600;
  }
  /* El botón, abajo del todo de su caja */
  .bento-cta {
    align-self: flex-start;
    margin-top: auto;
  }

  .bento-decisions {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--bento-gap);
  }
  .bento-decision {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .bento-note {
    padding: 0.15rem 0.45rem;
    font: 600 var(--step-small)/1.3 var(--font-sans);
    color: var(--paper);
    background: var(--ink);
  }
  .bento-decision-title {
    margin-top: 1.75rem;
    font-size: var(--step-lead);
    font-weight: 650;
    line-height: 1.08;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .bento-decision-body {
    margin-top: 0.6rem;
    color: var(--muted);
  }

  /* Tablet: las decisiones, en fila */
  @container (min-width: 640px) {
    .bento-decisions {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  /* Escritorio: la pieza a la izquierda, el resumen a su lado y las decisiones debajo, a todo el ancho */
  @container (min-width: 900px) {
    .bento-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
    .bento-decisions {
      grid-column: 1 / -1;
    }
  }
</style>
