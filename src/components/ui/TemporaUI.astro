---
// Fragmento del cuadrante de Tempora (turnos de sanitarios), dibujado en HTML a partir de la app real:
// cuadrante mensual, una fila por persona y una columna por día, el turno con su color y su letra, y
// el turno se pone pulsando la casilla. Los datos son de ejemplo y respetan el descanso mínimo de
// 12 h entre turnos. [data-sketch] marca lo que se dibuja en el boceto.
interface Props {
  lang: 'es' | 'en';
  /** Muestra las notas a mano del boceto (solo en la escena del inicio) */
  notes?: { filters: string; table: string; cta: string };
  /** Se puede tocar: pulsar una casilla vacía pone su turno (src/scripts/project-demos.ts) */
  interactive?: boolean;
}

import { useTranslations } from '@/i18n/utils';

type Shift = 'M' | 'T' | 'N' | 'G' | 'L';

const { lang, notes, interactive = false } = Astro.props;
const Action = interactive ? 'button' : 'span';
// Lo que anuncia la región educada de la demo (project-demos.ts rellena {name} y {shift})
const t = useTranslations(lang);

const copy = {
  es: {
    nav: ['Panel de control', 'Turnos', 'Control horario', 'Ausencias', 'Empleados', 'Informes'],
    title: 'Turnos — Cuadrante',
    month: 'Junio 2026',
    status: 'Borrador',
    hint: 'Haz clic en una celda para asignar un turno',
    person: 'Empleado',
    days: ['L', 'M', 'X', 'J', 'V', 'S', 'D'],
    dayNames: ['lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado', 'domingo'],
    shifts: { M: 'Mañana', T: 'Tarde', N: 'Noche', G: 'Guardia', L: 'Libranza' },
    roles: ['Enfermería', 'TCAE', 'Medicina', 'Fisioterapia', 'Celador'],
    empty: 'sin turno',
  },
  en: {
    nav: ['Dashboard', 'Shifts', 'Time tracking', 'Absences', 'Employees', 'Reports'],
    title: 'Shifts — Rota',
    month: 'June 2026',
    status: 'Draft',
    hint: 'Click a cell to assign a shift',
    person: 'Employee',
    days: ['M', 'T', 'W', 'T', 'F', 'S', 'S'],
    dayNames: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    shifts: { M: 'Morning', T: 'Afternoon', N: 'Night', G: 'On call', L: 'Day off' },
    roles: ['Nursing', 'Care assistant', 'Medicine', 'Physiotherapy', 'Porter'],
    empty: 'no shift',
  },
}[lang];

// La primera semana de junio de 2026 (el 1 es lunes). null es la casilla vacía y `fill`, el turno
// que entra al pulsarla: siempre uno que deja 12 h de descanso con el día de antes y el de después
const people: { name: string; role: string; week: (Shift | null)[]; fill: Shift }[] = [
  { name: 'Laura García', role: copy.roles[0], week: ['M', 'M', null, 'T', 'T', 'L', 'L'], fill: 'M' },
  { name: 'Sofía Fernández', role: copy.roles[0], week: ['T', 'T', null, 'N', 'N', 'L', 'L'], fill: 'T' },
  { name: 'Ana López', role: copy.roles[1], week: ['L', 'M', 'M', null, 'G', 'L', 'L'], fill: 'M' },
  { name: 'Carlos Martínez', role: copy.roles[2], week: ['G', 'M', null, 'M', 'T', 'L', 'L'], fill: 'G' },
  { name: 'Miguel Rodríguez', role: copy.roles[3], week: ['M', 'M', 'M', 'M', null, 'L', 'L'], fill: 'M' },
  { name: 'Elena Torres', role: copy.roles[2], week: ['M', 'G', 'M', 'T', 'N', 'L', 'L'], fill: 'M' },
  { name: 'David Sánchez', role: copy.roles[4], week: ['N', 'N', 'L', 'L', 'M', 'M', 'L'], fill: 'M' },
];
const firstEmpty = people.findIndex((person) => person.week.includes(null));
---

<div
  class="tp"
  data-ui
  role={interactive ? 'group' : 'img'}
  aria-label={`Tempora — ${copy.title}`}
  data-demo={interactive ? 'tempora' : undefined}
  data-demo-data={interactive ? JSON.stringify({ say: { added: t('demo.say.added') }, shifts: copy.shifts }) : undefined}
>
  <div class="tp-top" data-sketch="box">
    <span class="tp-logo" data-sketch="text"><i aria-hidden="true"></i>Tempora</span>
    <span class="tp-org" data-sketch="text">Tempora Demo</span>
  </div>
  <div class="tp-body">
    <div class="tp-side" data-sketch="box">
      {
        copy.nav.map((item, i) => (
          <span class:list={['tp-nav', { 'is-on': i === 1 }]} data-sketch="text">
            {item}
          </span>
        ))
      }
    </div>
    <div class="tp-main">
      <div class="tp-head">
        <span class="tp-title" data-sketch="text">{copy.title}</span>
        <span class="tp-tools">
          <span class="tp-month" data-sketch="box" data-sketch-note={notes?.filters}>{copy.month}</span>
          <span class="tp-status" data-sketch="text">{copy.status}</span>
        </span>
      </div>
      <div class="tp-legend">
        {
          (Object.entries(copy.shifts) as [Shift, string][]).map(([code, label]) => (
            <span class={`tp-key s-${code}`} data-sketch="box">
              {label}
            </span>
          ))
        }
        <span class="tp-hint" data-sketch="text">{copy.hint}</span>
      </div>
      <div class="tp-grid" data-sketch="box" data-sketch-note={notes?.table}>
        <span class="tp-cell tp-corner">{copy.person}</span>
        {
          copy.days.map((day, i) => (
            <span class:list={['tp-cell', 'tp-day', { 'is-weekend': i > 4 }]}>
              <b>{i + 1}</b>
              {day}
            </span>
          ))
        }
        {
          people.map((person, row) => (
            <>
              <span class="tp-cell tp-person" data-sketch="text">
                <b>{person.name}</b>
                <small>{person.role}</small>
              </span>
              {person.week.map((code, i) => (
                <span class:list={['tp-cell', { 'is-weekend': i > 4 }]}>
                  {code ? (
                    <span class={`tp-shift s-${code}`}>
                      <span aria-hidden="true">{code}</span>
                      <span class="sr-only">{copy.shifts[code]}</span>
                    </span>
                  ) : (
                    <Action
                      class="tp-add"
                      type={interactive ? 'button' : undefined}
                      aria-label={interactive ? `${person.name}, ${copy.dayNames[i]} ${i + 1}: ${copy.empty}` : undefined}
                      data-demo-cell={interactive ? '' : undefined}
                      data-shift={interactive ? person.fill : undefined}
                      data-name={interactive ? person.name : undefined}
                      data-day={interactive ? `${copy.dayNames[i]} ${i + 1}` : undefined}
                      data-sketch-note={row === firstEmpty ? notes?.cta : undefined}
                    >
                      +
                    </Action>
                  )}
                </span>
              ))}
            </>
          ))
        }
      </div>
    </div>
  </div>
</div>

<style>
  .tp {
    --tp-ink: #1c1633;
    --tp-muted: #5d5874;
    --tp-line: #e6e2f3;
    --tp-soft: #f5f3fc;
    --tp-brand: #4b21c9;
    --tp-brand-soft: #ebe6fb;
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    grid-template-columns: minmax(0, 1fr);
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-size: var(--ui-size, 0.8125rem);
    line-height: 1.3;
    color: var(--tp-ink);
    background: #fff;
    border: 1px solid var(--tp-line);
  }
  .tp-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.8em 1.231em;
    border-bottom: 1px solid var(--tp-line);
  }
  .tp-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .tp-logo i {
    width: 1.55em;
    height: 1.55em;
    background: var(--tp-brand);
    border-radius: 0.4em;
  }
  .tp-org {
    color: var(--tp-muted);
  }
  .tp-body {
    display: grid;
    grid-template-columns: 9.6em minmax(0, 1fr);
    min-height: 0;
  }
  .tp-side {
    display: grid;
    align-content: start;
    gap: 0.25em;
    padding: 1em 0.7em;
    border-right: 1px solid var(--tp-line);
  }
  .tp-nav {
    padding: 0.45em 0.6em;
    color: var(--tp-muted);
    border-radius: 0.45em;
    white-space: nowrap;
  }
  .tp-nav.is-on {
    font-weight: 600;
    color: var(--tp-brand);
    background: var(--tp-brand-soft);
  }
  .tp-main {
    display: grid;
    align-content: start;
    gap: 0.8em;
    padding: 1em 1.231em 1.231em;
    min-width: 0;
    background: var(--tp-soft);
  }
  .tp-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1em;
  }
  .tp-title {
    font-size: 1.3em;
    font-weight: 700;
  }
  .tp-tools {
    display: flex;
    align-items: center;
    gap: 0.5em;
  }
  .tp-month {
    padding: 0.4em 1.9em 0.4em 0.7em;
    font-weight: 600;
    /* La flecha del desplegable, en V, con dos medios cuadrados */
    background:
      linear-gradient(45deg, transparent 50%, var(--tp-muted) 50%) right 0.85em top 50% / 0.36em 0.36em no-repeat,
      linear-gradient(135deg, var(--tp-muted) 50%, transparent 50%) right 0.5em top 50% / 0.36em 0.36em no-repeat,
      #fff;
    border: 1px solid var(--tp-line);
    border-radius: 0.45em;
  }
  .tp-status {
    padding: 0.3em 0.6em;
    font-size: 0.85em;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--tp-muted);
    background: #ece9f5;
    border-radius: 0.35em;
  }
  .tp-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35em;
  }
  .tp-key {
    padding: 0.2em 0.6em;
    font-size: 0.85em;
    font-weight: 600;
    border: 1px solid;
    border-radius: 0.4em;
  }
  .tp-hint {
    margin-left: 0.4em;
    font-size: 0.85em;
    color: var(--tp-muted);
  }
  .tp-grid {
    display: grid;
    grid-template-columns: minmax(7.6em, 1.7fr) repeat(7, minmax(2.1em, 1fr));
    background: #fff;
    border: 1px solid var(--tp-line);
    border-radius: 0.6em;
    overflow: hidden;
  }
  .tp-cell {
    display: grid;
    place-items: center;
    min-width: 0;
    min-height: 2.55em;
    padding: 0.25em;
    border-bottom: 1px solid var(--tp-line);
    border-left: 1px solid var(--tp-line);
  }
  .tp-cell.is-weekend {
    background: #f3f1f9;
  }
  .tp-corner,
  .tp-person {
    justify-items: start;
    padding: 0.3em 0.7em;
    border-left: 0;
  }
  .tp-corner {
    font-size: 0.78em;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--tp-muted);
  }
  .tp-day {
    font-size: 0.72em;
    line-height: 1.15;
    color: var(--tp-muted);
  }
  .tp-day b {
    display: block;
    font-size: 1.45em;
    color: var(--tp-ink);
  }
  .tp-person b {
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }
  .tp-person small {
    font-size: 0.78em;
    color: var(--tp-muted);
  }
  .tp-shift,
  .tp-add {
    display: grid;
    place-items: center;
    width: 1.95em;
    height: 1.95em;
    font-weight: 700;
    border-radius: 0.45em;
  }
  .tp-shift {
    border: 1px solid;
  }
  /* Los colores del cuadrante real, con el texto oscurecido donde hacía falta para el contraste AA */
  .s-M {
    color: #1d4ed8;
    background: rgb(59 130 246 / 0.2);
    border-color: rgb(59 130 246 / 0.5);
  }
  .s-T {
    color: #9a3412;
    background: rgb(249 115 22 / 0.2);
    border-color: rgb(249 115 22 / 0.5);
  }
  .s-N {
    color: #6d28d9;
    background: rgb(139 92 246 / 0.2);
    border-color: rgb(139 92 246 / 0.5);
  }
  .s-G {
    color: #b91c1c;
    background: rgb(239 68 68 / 0.18);
    border-color: rgb(239 68 68 / 0.5);
  }
  .s-L {
    color: #166534;
    background: rgb(34 197 94 / 0.14);
    border-color: rgb(34 197 94 / 0.45);
  }
  .tp-add {
    color: var(--tp-muted);
    border: 1px dashed #cbc5e0;
  }
  /* Lo que se puede tocar: la casilla vacía, con su zona de 24 px aunque la tarjeta vaya a escala */
  button.tp-add {
    min-width: 24px;
    min-height: 24px;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    background: none;
    transition:
      background-color 140ms ease-out,
      transform 140ms ease-out;
  }
  button.tp-add:hover {
    color: var(--tp-brand);
    background: var(--tp-brand-soft);
    border-color: var(--tp-brand);
  }
  button.tp-add:active {
    transform: scale(0.94);
  }
  .tp :focus-visible {
    outline: 2px solid var(--tp-ink);
    outline-offset: 2px;
  }
  .tp-shift.is-just {
    animation: tp-pop 380ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes tp-pop {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tp-shift.is-just {
      animation: none;
    }
  }
  @media (max-width: 640px) {
    .tp-body {
      grid-template-columns: minmax(0, 1fr);
    }
    .tp-side,
    .tp-hint,
    .tp-org {
      display: none;
    }
    .tp-head {
      flex-wrap: wrap;
      gap: 0.5em;
    }
    .tp-grid {
      grid-template-columns: minmax(5.6em, 1.4fr) repeat(7, minmax(1.9em, 1fr));
    }
    .tp-person small {
      display: none;
    }
  }
</style>
