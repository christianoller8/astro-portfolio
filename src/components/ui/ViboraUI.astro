---
// Fragmento de interfaz de Vibora (reservas de pádel). Datos de ejemplo hasta tener capturas reales.
interface Props {
  lang: 'es' | 'en';
  /** Se puede tocar: elegir una pista libre y confirmar (src/scripts/project-demos.ts) */
  interactive?: boolean;
}

const { lang, interactive = false } = Astro.props;

const copy = {
  es: {
    title: 'Reservar pista',
    day: 'Jueves 7',
    courts: ['Pista 1', 'Pista 2', 'Pista 3'],
    free: 'Libre',
    taken: 'Ocupada',
    mine: 'Tu reserva',
    summary: 'Pista 2 · 19:30 · 90 min',
    cta: 'Confirmar',
    confirmed: 'Reserva confirmada',
    pick: 'Elige una pista libre',
  },
  en: {
    title: 'Book a court',
    day: 'Thursday 7',
    courts: ['Court 1', 'Court 2', 'Court 3'],
    free: 'Free',
    taken: 'Taken',
    mine: 'Your booking',
    summary: 'Court 2 · 19:30 · 90 min',
    cta: 'Confirm',
    confirmed: 'Booking confirmed',
    pick: 'Pick a free court',
  },
}[lang];

const times = ['18:00', '19:30', '21:00'];
// 0 libre · 1 ocupada · 2 seleccionada
const grid = [
  [1, 0, 1],
  [0, 2, 1],
  [1, 0, 0],
];
---

<div
  class="vb"
  data-ui
  role={interactive ? 'group' : 'img'}
  aria-label={`Vibora — ${copy.title}`}
  data-demo={interactive ? 'vibora' : undefined}
  data-demo-data={interactive
    ? JSON.stringify({ free: copy.free, mine: copy.mine, confirmed: copy.confirmed, pick: copy.pick, cta: copy.cta })
    : undefined}
>
  <div class="vb-top">
    <span class="vb-logo">vibora</span>
    <span class="vb-day">{copy.day}</span>
  </div>
  <p class="vb-title">{copy.title}</p>
  <div class="vb-grid">
    <span></span>
    {copy.courts.map((court) => <span class="vb-court">{court}</span>)}
    {
      times.map((time, row) => (
        <>
          <span class="vb-time">{time}</span>
          {grid[row].map((state, col) =>
            interactive && state !== 1 ? (
              <button
                type="button"
                class:list={['vb-slot', { 'is-mine': state === 2 }]}
                aria-pressed={state === 2 ? 'true' : 'false'}
                data-demo-slot={`${copy.courts[col]} · ${time}`}
              >
                {state === 0 ? copy.free : copy.mine}
              </button>
            ) : (
              <span class:list={['vb-slot', { 'is-taken': state === 1, 'is-mine': state === 2 }]}>
                {state === 0 ? copy.free : state === 1 ? copy.taken : copy.mine}
              </span>
            ),
          )}
        </>
      ))
    }
  </div>
  <div class="vb-bar">
    <span data-demo-summary>{copy.summary}</span>
    {
      interactive ? (
        <button type="button" class="vb-cta" data-demo-confirm>
          {copy.cta}
        </button>
      ) : (
        <span class="vb-cta">{copy.cta}</span>
      )
    }
  </div>
</div>

<style>
  .vb {
    display: grid;
    align-content: start;
    gap: 1.108em;
    width: 100%;
    height: 100%;
    padding: 1.231em 1.354em 1.354em;
    font-size: var(--ui-size, 0.8125rem);
    line-height: 1.3;
    color: #eef5e6;
    background: #11201a;
  }
  .vb-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .vb-logo {
    font-weight: 800;
    font-size: 1.23em;
    letter-spacing: -0.03em;
    color: #b9f26b;
  }
  .vb-day {
    color: #b7c7bd;
  }
  .vb-title {
    font-size: 1.38em;
    font-weight: 700;
  }
  .vb-grid {
    display: grid;
    grid-template-columns: 3.938em repeat(3, 1fr);
    gap: 0.492em;
  }
  .vb-court {
    font-weight: 600;
    color: #b7c7bd;
  }
  .vb-time {
    align-self: center;
    font-weight: 600;
    color: #b7c7bd;
  }
  .vb-slot {
    padding: 0.738em 0.615em;
    font-weight: 600;
    color: #dff7c2;
    background: #1d3529;
  }
  .vb-slot.is-taken {
    color: #8fa398;
    background: #16271f;
    text-decoration: line-through;
  }
  .vb-slot.is-mine {
    color: #11201a;
    background: #b9f26b;
  }
  .vb-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.231em;
    padding: 0.738em 0.738em 0.738em 0.985em;
    background: #1d3529;
  }
  .vb-cta {
    padding: 0.554em 0.985em;
    font-weight: 700;
    color: #11201a;
    background: #b9f26b;
  }
  /* Lo que se puede tocar */
  button.vb-slot {
    text-align: left;
    cursor: pointer;
    transition:
      background-color 140ms ease-out,
      color 140ms ease-out,
      transform 140ms ease-out;
  }
  button.vb-slot:not(.is-mine):hover {
    background: #2a4a39;
  }
  button.vb-slot:active,
  button.vb-cta:active {
    transform: scale(0.97);
  }
  button.vb-cta {
    cursor: pointer;
    transition:
      background-color 140ms ease-out,
      transform 140ms ease-out;
  }
  button.vb-cta:hover {
    background: #cdf78f;
  }
  button.vb-cta:disabled {
    cursor: default;
    opacity: 0.45;
  }
  .vb :focus-visible {
    outline: 2px solid #eef5e6;
    outline-offset: 2px;
  }
  .vb-bar.is-done {
    color: #11201a;
    background: #b9f26b;
    font-weight: 700;
  }
  .vb-bar.is-done .vb-cta {
    visibility: hidden;
  }
</style>
