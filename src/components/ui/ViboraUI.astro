---
// Fragmento de la agenda de Víbora (reservas de pádel), dibujado en HTML a partir de la app real:
// una pista y sus horas del día; lo ocupado lleva trama y lo libre, contorno y precio. Al elegir una
// hora pasa a «Seleccionada» y un diálogo repite club, pista, fecha, hora y precio antes de reservar.
// Los datos son de ejemplo. Sin `interactive` se dibuja con el diálogo abierto sobre las 18:00.
interface Props {
  lang: 'es' | 'en';
  /** Se puede tocar: elegir una hora libre y reservarla (src/scripts/project-demos.ts) */
  interactive?: boolean;
}

import { useTranslations } from '@/i18n/utils';

type State = 'free' | 'taken' | 'picked';

const { lang, interactive = false } = Astro.props;
const Action = interactive ? 'button' : 'span';
// Lo que anuncia la región educada de la demo (project-demos.ts rellena {slot})
const t = useTranslations(lang);
const say = { picked: t('demo.say.picked'), unpicked: t('demo.say.unpicked'), confirmed: t('demo.say.confirmed') };

const copy = {
  es: {
    nav: ['Panel', 'Agenda', 'Mis reservas', 'Partidos'],
    title: 'Agenda de reservas',
    fields: ['Club', 'Pista', 'Fecha'],
    club: 'Club Víbora Demo',
    court: 'Pista 1',
    date: '25/11/2026',
    today: 'Hoy',
    states: { free: 'Libre', taken: 'Ocupada', picked: 'Seleccionada' },
    dialog: 'Confirmar reserva',
    rows: ['Club', 'Pista', 'Fecha', 'Hora', 'Precio'],
    longDate: 'miércoles, 25 de noviembre de 2026',
    back: 'Volver',
    book: 'Reservar',
    done: 'Reserva confirmada para las {time}.',
    price: (euros: number) => `${euros},00 €`,
  },
  en: {
    nav: ['Dashboard', 'Schedule', 'My bookings', 'Matches'],
    title: 'Booking schedule',
    fields: ['Club', 'Court', 'Date'],
    club: 'Víbora Demo Club',
    court: 'Court 1',
    date: '25/11/2026',
    today: 'Today',
    states: { free: 'Free', taken: 'Taken', picked: 'Selected' },
    dialog: 'Confirm booking',
    rows: ['Club', 'Court', 'Date', 'Time', 'Price'],
    longDate: 'Wednesday, 25 November 2026',
    back: 'Back',
    book: 'Book',
    done: 'Booking confirmed for {time}.',
    price: (euros: number) => `€${euros}.00`,
  },
}[lang];

// Un día de la pista 1: tramos de hora y media, con la hora punta más cara desde las 18:00
const slots: { time: string; euros: number; state: State }[] = [
  { time: '09:00 – 10:30', euros: 30, state: 'free' },
  { time: '10:30 – 12:00', euros: 30, state: 'taken' },
  { time: '12:00 – 13:30', euros: 30, state: 'free' },
  { time: '13:30 – 15:00', euros: 30, state: 'taken' },
  { time: '15:00 – 16:30', euros: 30, state: 'free' },
  { time: '16:30 – 18:00', euros: 30, state: 'taken' },
  { time: '18:00 – 19:30', euros: 45, state: interactive ? 'free' : 'picked' },
  { time: '19:30 – 21:00', euros: 45, state: 'taken' },
];
const shown = slots.find((slot) => slot.state === 'picked') ?? slots[6];
---

<div
  class="vb"
  data-ui
  role={interactive ? 'group' : 'img'}
  aria-label={`Víbora — ${copy.title}`}
  data-demo={interactive ? 'vibora' : undefined}
  data-demo-data={interactive ? JSON.stringify({ states: copy.states, done: copy.done, say }) : undefined}
>
  <div class="vb-top" data-sketch="box">
    <span class="vb-logo" data-sketch="text"><i aria-hidden="true"></i>VÍBORA</span>
    <span class="vb-nav">
      {
        copy.nav.map((item, i) => (
          <span class:list={['vb-tab', { 'is-on': i === 1 }]} data-sketch="text">
            {item}
          </span>
        ))
      }
    </span>
  </div>
  <p class="vb-title" data-sketch="text">{copy.title}</p>
  <div class="vb-filters">
    <span class="vb-field" data-sketch="box"><small>{copy.fields[0]}</small>{copy.club}</span>
    <span class="vb-field" data-sketch="box"><small>{copy.fields[1]}</small>{copy.court}</span>
    <span class="vb-field" data-sketch="box"><small>{copy.fields[2]}</small>{copy.date}</span>
    <span class="vb-today" data-sketch="box">{copy.today}</span>
  </div>
  <div class="vb-legend">
    {
      (['free', 'taken', 'picked'] as State[]).map((state) => (
        <span class="vb-key" data-sketch="text">
          <i class={`vb-swatch is-${state}`} aria-hidden="true" />
          {copy.states[state]}
        </span>
      ))
    }
  </div>
  <div class="vb-slots">
    {
      slots.map((slot) => {
        const price = copy.price(slot.euros);
        return interactive && slot.state === 'free' ? (
          <button
            type="button"
            class="vb-slot"
            aria-pressed="false"
            data-demo-slot={`${copy.court} · ${slot.time}`}
            data-time={slot.time}
            data-price={price}
            data-sketch="box"
          >
            <b>{slot.time}</b>
            <span>{price}</span>
            <em>{copy.states.free}</em>
          </button>
        ) : (
          <span class:list={['vb-slot', `is-${slot.state}`]} data-sketch="box">
            <b>{slot.time}</b>
            <span>{price}</span>
            <em>{copy.states[slot.state]}</em>
          </span>
        );
      })
    }
  </div>
  <div
    class="vb-dialog"
    data-demo-dialog
    data-sketch="box"
    hidden={interactive}
    role={interactive ? 'dialog' : undefined}
    aria-label={interactive ? copy.dialog : undefined}
  >
    <p class="vb-dialog-title">{copy.dialog}</p>
    <dl>
      <dt>{copy.rows[0]}</dt>
      <dd>{copy.club}</dd>
      <dt>{copy.rows[1]}</dt>
      <dd>{copy.court}</dd>
      <dt>{copy.rows[2]}</dt>
      <dd>{copy.longDate}</dd>
      <dt>{copy.rows[3]}</dt>
      <dd data-demo-time>{shown.time}</dd>
      <dt>{copy.rows[4]}</dt>
      <dd data-demo-price>{copy.price(shown.euros)}</dd>
    </dl>
    <div class="vb-actions">
      <Action class="vb-back" type={interactive ? 'button' : undefined} data-demo-back={interactive ? '' : undefined}>
        {copy.back}
      </Action>
      <Action class="vb-book" type={interactive ? 'button' : undefined} data-demo-confirm={interactive ? '' : undefined}>
        {copy.book}
      </Action>
    </div>
  </div>
  {interactive && <p class="vb-toast" data-demo-toast tabindex="-1" hidden />}
</div>

<style>
  .vb {
    --vb-ink: #eceee9;
    --vb-muted: #a7ada9;
    --vb-line: #3a4143;
    --vb-panel: #242a2c;
    --vb-lime: #d6f264;
    --vb-lime-ink: #1a1f0a;
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.95em;
    width: 100%;
    height: 100%;
    overflow: hidden;
    padding: 1em 1.231em 1.231em;
    font-size: var(--ui-size, 0.8125rem);
    line-height: 1.3;
    color: var(--vb-ink);
    background: #1b1f20;
  }
  .vb-top {
    display: flex;
    align-items: center;
    gap: 1.2em;
    padding: 0.45em 0.6em 0.45em 0.9em;
    background: var(--vb-panel);
    border: 1px solid var(--vb-line);
    border-radius: 999px;
  }
  .vb-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-weight: 800;
    letter-spacing: 0.2em;
  }
  .vb-logo i {
    width: 0.9em;
    height: 1.1em;
    background: var(--vb-lime);
    clip-path: polygon(0 0, 38% 0, 50% 55%, 62% 0, 100% 0, 60% 100%, 40% 100%);
  }
  .vb-nav {
    display: flex;
    gap: 0.25em;
    min-width: 0;
    overflow: hidden;
  }
  .vb-tab {
    padding: 0.4em 0.85em;
    color: var(--vb-muted);
    white-space: nowrap;
    border-radius: 999px;
  }
  .vb-tab.is-on {
    font-weight: 700;
    color: var(--vb-lime-ink);
    background: var(--vb-lime);
  }
  .vb-title {
    font-size: 1.6em;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .vb-filters {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr auto;
    gap: 0.6em;
    align-items: end;
  }
  .vb-field {
    display: grid;
    gap: 0.1em;
    padding: 0.45em 0.7em;
    white-space: nowrap;
    border: 1px solid var(--vb-line);
    border-radius: 0.4em;
  }
  .vb-field small {
    font-size: 0.78em;
    color: var(--vb-muted);
  }
  .vb-today {
    padding: 0.5em 0.95em;
    font-weight: 600;
    color: var(--vb-lime);
    border: 1px solid var(--vb-line);
    border-radius: 999px;
  }
  .vb-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1em;
    color: var(--vb-muted);
  }
  .vb-key {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }
  .vb-swatch {
    width: 0.95em;
    height: 0.95em;
    border: 1px solid var(--vb-muted);
    border-radius: 0.2em;
  }
  .vb-slots {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.55em;
  }
  .vb-slot {
    display: grid;
    justify-items: start;
    gap: 0.15em;
    padding: 0.6em 0.75em;
    font: inherit;
    text-align: left;
    color: var(--vb-ink);
    background: transparent;
    border: 1px solid var(--vb-muted);
    border-radius: 0.55em;
  }
  .vb-slot b {
    font-weight: 700;
    white-space: nowrap;
  }
  .vb-slot span {
    color: var(--vb-muted);
  }
  .vb-slot em {
    font-size: 0.85em;
    font-style: normal;
    font-weight: 700;
  }
  /* Ocupada: trama diagonal, para que no dependa solo del color (como en la agenda real) */
  .vb-slot.is-taken,
  .vb-swatch.is-taken {
    color: var(--vb-muted);
    background: repeating-linear-gradient(135deg, rgb(255 255 255 / 0.07) 0 0.35em, transparent 0.35em 0.7em);
    border-color: var(--vb-line);
  }
  .vb-slot.is-taken b {
    color: var(--vb-muted);
  }
  .vb-slot.is-picked,
  .vb-swatch.is-picked {
    color: var(--vb-lime-ink);
    background: var(--vb-lime);
    border-color: var(--vb-lime);
  }
  .vb-slot.is-picked span {
    color: var(--vb-lime-ink);
  }
  .vb-slot.is-picked em::before {
    content: '✓ ';
  }
  .vb-dialog {
    position: absolute;
    z-index: 1;
    top: 60%;
    left: 50%;
    display: grid;
    gap: 0.8em;
    width: min(26em, 90%);
    padding: 1.1em 1.25em 1em;
    background: #23292b;
    border: 1px solid var(--vb-line);
    border-radius: 0.9em;
    /* La sombra grande oscurece lo de detrás, como el fondo de un diálogo (la caja recorta lo que sobra) */
    box-shadow:
      0 1.2em 3em rgb(0 0 0 / 0.5),
      0 0 0 100vmax rgb(0 0 0 / 0.35);
    transform: translate(-50%, -50%);
  }
  .vb-dialog[hidden] {
    display: none;
  }
  .vb-dialog-title {
    font-size: 1.3em;
    font-weight: 700;
  }
  .vb-dialog dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.35em 1.2em;
  }
  .vb-dialog dt {
    color: var(--vb-muted);
  }
  .vb-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.5em;
  }
  .vb-back,
  .vb-book {
    padding: 0.55em 1.1em;
    font: inherit;
    font-weight: 700;
    border: 0;
    border-radius: 999px;
  }
  .vb-back {
    color: var(--vb-lime);
    background: #343b22;
  }
  .vb-book {
    color: var(--vb-lime-ink);
    background: var(--vb-lime);
  }
  .vb-toast {
    position: absolute;
    left: 50%;
    bottom: 1em;
    padding: 0.6em 1em;
    color: #1b1f20;
    white-space: nowrap;
    background: #e9ece6;
    border-radius: 0.4em;
    transform: translateX(-50%);
  }
  .vb-toast[hidden] {
    display: none;
  }
  /* Lo que se puede tocar */
  button.vb-slot,
  button.vb-back,
  button.vb-book {
    cursor: pointer;
    transition:
      background-color 140ms ease-out,
      transform 140ms ease-out;
  }
  button.vb-slot:not(.is-picked):hover {
    background: #2c3335;
  }
  button.vb-book:hover {
    background: #e3f98e;
  }
  button.vb-slot:active,
  button.vb-back:active,
  button.vb-book:active {
    transform: scale(0.97);
  }
  .vb :focus-visible {
    outline: 2px solid var(--vb-ink);
    outline-offset: 2px;
  }
  .vb-slot.is-just {
    animation: vb-take 420ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes vb-take {
    from {
      background-color: var(--vb-lime);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .vb-slot.is-just {
      animation: none;
    }
  }
  @media (max-width: 640px) {
    .vb-nav > :nth-child(n + 3),
    .vb-legend,
    .vb-today {
      display: none;
    }
    .vb-filters {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .vb-field {
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .vb-slots {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
