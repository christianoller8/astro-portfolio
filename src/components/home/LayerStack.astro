---
// "En capas" (decisión D18): cierre de "Cómo lo veo yo". La web de ejemplo se separa en sus cuatro
// capas (boceto, diseño, código y pruebas), puestas en el espacio con three.js. Se gira arrastrando
// y un control abre o cierra la separación. Todo lo hace src/scripts/layer-stack.ts.
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const layers = [
  { id: 'sketch', name: t('layers.sketch') },
  { id: 'design', name: t('layers.design') },
  { id: 'code', name: t('layers.code') },
  { id: 'qa', name: t('layers.qa') },
];
---

<div class="ls" data-layers>
  <div class="wrap ls-grid">
    <div class="ls-copy">
      <h3 class="ls-title" data-reveal>{t('layers.title')}</h3>
      <p class="ls-lead" data-reveal style="--reveal-i: 1">{t('layers.lead')}</p>
      <label class="ls-gap" data-reveal style="--reveal-i: 2">
        <span>{t('layers.gap')}</span>
        <input type="range" min="0" max="100" value="55" data-layers-gap />
      </label>
      <ol class="ls-legend" data-reveal style="--reveal-i: 3">
        {
          layers.map((layer, i) => (
            <li>
              <span class="ls-num">{i + 1}</span>
              {layer.name}
            </li>
          ))
        }
      </ol>
    </div>

    {/* El escenario se gira con el teclado (flechas, Inicio y Fin) además de arrastrando: es un
        control deslizante del giro, no una imagen. Su valor son los grados de giro (la escena limita
        el giro a ±60°) y layer-stack.ts mantiene aria-valuenow y aria-valuetext al día. Las
        instrucciones (la pista de abajo) son su descripción accesible. */}
    <div
      class="ls-stage"
      data-layers-stage
      data-text-zero={t('layers.rotate.zero')}
      data-text-left={t('layers.rotate.left')}
      data-text-right={t('layers.rotate.right')}
      role="slider"
      aria-label={t('layers.label')}
      aria-describedby="ls-hint"
      aria-orientation="horizontal"
      aria-valuemin="-60"
      aria-valuemax="60"
      aria-valuenow="25"
      aria-valuetext={t('layers.rotate.right').replace('{n}', '25')}
      tabindex="0"
    >
      {/* Los nombres de las capas: layer-stack.ts los pega a la esquina de cada hoja. Van numerados
          en el orden en que se hacen (el boceto es la base, las pruebas van encima): sin el número
          no se leía cuál va primero */}
      {
        layers.map((layer, i) => (
          <span class="ls-label" data-layers-label style={`--up: ${layers.length - 1 - i}`} aria-hidden="true">
            <span class="ls-num">{i + 1}</span>
            {layer.name}
          </span>
        ))
      }
      <p class="ls-hint" id="ls-hint">{t('layers.hint')}</p>
    </div>

    {/* Sin WebGL: las mismas capas, planas */}
    <ol class="ls-flat" data-layers-flat>
      {
        layers.map((layer) => (
          <li data-layer={layer.id}>
            <span>
              <span class="ls-num">{layers.indexOf(layer) + 1}</span>
              {layer.name}
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</div>

<style>
  .ls {
    margin-top: clamp(3rem, 7vw, 6rem);
    padding-block: clamp(3rem, 6vw, 5rem);
    background: var(--tint);
  }
  .ls-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }
  .ls-title {
    max-width: 15ch;
    font-size: var(--step-head);
    font-weight: 650;
    line-height: 0.98;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .ls-lead {
    max-width: 30ch;
    margin-top: 1.25rem;
    font-size: var(--step-lead);
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--muted);
  }
  .ls-gap {
    display: grid;
    gap: 0.6rem;
    max-width: 18rem;
    margin-top: 2rem;
    font: 600 var(--step-small)/1.3 var(--font-sans);
    color: var(--muted);
  }
  /* El control de separación, con el aspecto del kit: una línea y un tirador cuadrado */
  .ls-gap input {
    width: 100%;
    height: 1.5rem;
    margin: 0;
    background: none;
    appearance: none;
    -webkit-appearance: none;
    cursor: ew-resize;
  }
  .ls-gap input::-webkit-slider-runnable-track {
    height: 1px;
    background: var(--ink);
  }
  .ls-gap input::-moz-range-track {
    height: 1px;
    background: var(--ink);
  }
  .ls-gap input::-webkit-slider-thumb {
    width: 0.9rem;
    height: 0.9rem;
    margin-top: calc(-0.45rem + 0.5px);
    border: 1px solid var(--ink);
    border-radius: 0;
    background: var(--paper);
    -webkit-appearance: none;
  }
  .ls-gap input::-moz-range-thumb {
    width: 0.8rem;
    height: 0.8rem;
    border: 1px solid var(--ink);
    border-radius: 0;
    background: var(--paper);
  }
  .ls-legend {
    display: grid;
    gap: 3px;
    max-width: 18rem;
    margin-top: 2rem;
  }
  .ls-legend li {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding: 0.55rem 0.8rem;
    font-weight: 600;
    background: var(--paper);
  }

  /* El número de orden de cada capa, más apagado que su nombre */
  .ls-num {
    font-variant-numeric: tabular-nums;
    /* .75 llega a 4,5:1 en el papel y dentro de las etiquetas oscuras, en los dos temas */
    opacity: 0.75;
  }
  /* En la versión plana el texto ya es --muted: bajarle la opacidad lo dejaba bajo 4,5:1 */
  .ls-flat .ls-num {
    opacity: 1;
  }
  .ls-label .ls-num,
  .ls-flat .ls-num {
    margin-right: 0.4em;
  }

  /* El escenario: three.js pinta dentro; los nombres de las capas van encima, en HTML */
  .ls-stage {
    position: relative;
    height: clamp(20rem, 62vw, 36rem);
    overflow: hidden;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
  }
  .ls-stage.is-dragging {
    cursor: grabbing;
  }
  .ls-stage :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity var(--dur-ink) var(--ease-out);
  }
  .ls.is-ready .ls-stage :global(canvas) {
    opacity: 1;
  }
  .ls-label {
    position: absolute;
    top: 0;
    left: 0;
    padding: 0.15rem 0.45rem;
    font: 600 var(--step-small)/1.3 var(--font-sans);
    white-space: nowrap;
    color: var(--paper);
    background: var(--ink);
    /* Las cuatro etiquetas se apilan hacia arriba (la de la hoja de delante, abajo) para no pisarse */
    translate: 0 calc(-100% - 4px - var(--up, 0) * 1.5rem);
    opacity: 0;
    transition: opacity var(--dur-ink) var(--ease-out);
    pointer-events: none;
  }
  .ls.is-ready .ls-label {
    opacity: 1;
  }
  .ls-hint {
    position: absolute;
    right: 0;
    bottom: 0;
    font: 600 var(--step-small)/1.3 var(--font-sans);
    color: var(--muted);
  }

  /* Sin WebGL */
  .ls-flat {
    display: none;
  }
  .ls.is-flat .ls-stage {
    display: none;
  }
  /* Sin 3D no hay separación que mover: el control se esconde en vez de quedarse sin hacer nada */
  .ls.is-flat .ls-gap {
    display: none;
  }
  .ls.is-flat .ls-flat {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .ls-flat li {
    display: grid;
    gap: 0.4rem;
    font: 600 var(--step-small)/1.3 var(--font-sans);
    color: var(--muted);
  }
  .ls-flat :global(canvas) {
    width: 100%;
    height: auto;
  }

  @media (min-width: 1024px) {
    .ls-grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      align-items: center;
      gap: 3rem;
    }
    .ls-stage {
      height: clamp(26rem, 70vh, 40rem);
    }
    .ls-flat {
      grid-column: 2;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ls-stage :global(canvas),
    .ls-label {
      transition: none;
    }
  }
</style>

<script>
  import '@/scripts/layer-stack';
</script>
