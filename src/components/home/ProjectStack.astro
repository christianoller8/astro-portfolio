---
import ProjectVisual from '@/components/ui/ProjectVisual.astro';
import { useTranslations, useTranslatedPath } from '@/i18n/utils';
import { getSortedProjects } from '@/utils/projects';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const projects = await getSortedProjects(lang);
// Lo que se puede hacer en cada uno
const hints: Record<string, string> = {
  tempora: t('projects.try.tempora'),
  vibora: t('projects.try.vibora'),
  learnish: t('projects.try.learnish'),
  vistalo: t('projects.try.vistalo'),
};
---

<section class="projects" data-cs="<section> ProjectStack.astro">
  <div class="wrap projects-head">
    <h2 class="t-head" data-reveal>{t('projects.title')}</h2>
    <p class="t-lead projects-lead" data-reveal style="--reveal-i: 1">{t('projects.lead')}</p>
  </div>

  <ol class="wrap stack">
    {
      projects.map((project) => {
        const href = translatePath(`/projects/${project.slug}`);
        const kind = t(project.data.kind === 'app' ? 'project.kind.app' : 'project.kind.web');
        const facts = [kind, project.data.status, project.data.role, project.data.year, project.data.stack.slice(0, 3).join(', ')]
          .filter(Boolean)
          .join(' · ');
        const hint = hints[project.slug] ?? '';
        return (
          <li class="stack-item">
            {/* La tarjeta ya no es un enlace entero: la interfaz de dentro se puede tocar */}
            <article class="stack-card">
              <div class="stack-meta">
                <h3 class="stack-title">
                  <a href={href} data-morph-title={project.slug}>
                    {project.data.title}
                  </a>
                </h3>
                <div class="stack-text">
                  <p class="stack-desc">{project.data.description}</p>
                  <p class="stack-facts">{facts}</p>
                </div>
                {/* El mismo botón y el mismo texto ("Ver caso") que las cajas de Proyectos: antes aquí
                    era un enlace de texto, "Ver proyecto", de 26 px (decisión de Christian, 20 nov) */}
                <a class="btn btn-primary stack-cta" href={href} aria-label={`${t('projects.case')}: ${project.data.title}`}>
                  {t('projects.case')} <span aria-hidden="true">→</span>
                </a>
              </div>
              <div class="stack-visual">
                <p class="stack-try">
                  <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
                    <path d="M3 1.5l9.5 6.2-4.1.9 2.4 4.6-1.9 1-2.4-4.7L3.6 12.6z" />
                  </svg>
                  {hint}
                </p>
                <div data-morph-visual={project.slug} data-sel>
                  <ProjectVisual project={project} lang={lang} interactive />
                </div>
              </div>
            </article>
          </li>
        );
      })
    }
  </ol>

  <div class="wrap projects-all">
    <a class="btn btn-quiet" href={translatePath('/projects')}>
      {t('projects.all')}
      <span class="btn-arrow" aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  .projects {
    padding-top: clamp(5rem, 10vw, 9rem);
  }
  .projects-lead {
    max-width: 42ch;
    margin-top: 1rem;
    color: var(--muted);
  }
  .stack {
    display: grid;
    gap: 1.5rem;
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }
  .stack-card {
    display: grid;
    gap: 2.9rem;
    padding: clamp(0.75rem, 1.6vw, 1.25rem);
    background: var(--tint);
    transition: background-color var(--dur-ui) var(--ease-out);
  }
  .stack-meta {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.25rem 0.25rem 0;
  }
  .stack-title {
    font-size: var(--step-head);
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .stack-title a {
    text-decoration: none;
  }
  .stack-desc {
    max-width: 52ch;
    color: var(--ink);
  }
  .stack-facts {
    margin-top: 0.4rem;
    font-size: var(--step-small);
    color: var(--muted);
  }
  /* La nota de herramienta que dice qué se puede tocar: asoma por encima del marco */
  .stack-visual {
    position: relative;
  }
  .stack-try {
    position: absolute;
    bottom: calc(100% + 0.4rem);
    left: 0;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.55rem 0.25rem 0.45rem;
    font: 600 var(--step-small)/1.3 var(--font-sans);
    white-space: nowrap;
    color: var(--paper);
    background: var(--ink);
    pointer-events: none;
  }
  /* La forma del botón es la de .btn-primary (kit.css), la misma que en las cajas de Proyectos */
  .stack-cta {
    justify-self: start;
  }
  .stack-cta span {
    transition: transform var(--dur-micro) var(--ease-out);
  }
  .stack-cta:hover span {
    transform: translateX(4px);
  }
  .projects-all {
    margin-top: 2rem;
  }

  /* En móvil y tablet la interfaz se ve entera (sin recortar a 16:10): si no, no se vería lo que
     cambia al tocarla. La web abierta en su marco va en formato de móvil. */
  @media (max-width: 1023px) {
    .stack-visual :global(.pv:not(.pv--live) .pv-clip) {
      aspect-ratio: auto;
    }
    .stack-visual :global(.pv--live.is-live .pv-clip) {
      aspect-ratio: 3 / 4;
    }
  }
  @media (min-width: 1024px) {
    .stack {
      gap: 2rem;
    }
    .stack-meta {
      grid-template-columns: minmax(0, 4fr) minmax(0, 6fr) auto;
      align-items: start;
      gap: 2.5rem;
    }
    /* Mínimo de 27rem: lo que pide la interfaz más alta (Tempora, 432 px). Con 21rem, en portátiles
       bajos (1366 × 768, unos 650 px de ventana) se cortaban botones de las demos (revisión, 21 nov) */
    .stack-visual :global(.pv-clip) {
      aspect-ratio: auto;
      height: clamp(27rem, 56vh, 33rem);
    }
  }
  /* Cada tarjeta crece un poco al entrar en pantalla, ligada al scroll (sin JavaScript) */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .stack-card {
        animation: card-in linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 35%;
      }
    }
  }
  @keyframes card-in {
    from {
      transform: scale(0.94);
      opacity: 0.5;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  /* Apilado al hacer scroll (decisión de Christian, 21 nov; la referencia es la sección de servicios
     de kigo.studio). En escritorio cada tarjeta se queda fija bajo la barra y la siguiente sube y la
     tapa: Tempora, luego Vibora, Learnish y Vístalo. Para que cada una tape entera a la anterior las
     cuatro miden lo mismo: la altura sale de la pantalla y el marco de la interfaz se queda con lo
     que sobra. La inclinación con la que sube cada tarjeta la pone src/scripts/project-stack.ts.
     En móvil y tablet, con "reducir movimiento" y en ventanas de menos de 700 px de alto la lista va
     seguida, como antes (la referencia tampoco apila en móvil). Por debajo de 700 px una tarjeta que
     quepa en la pantalla deja la interfaz demasiado baja y recorta botones de las demos (medido en
     la revisión del 21 nov: Vibora pierde "Confirmar" y Learnish "Repasar" y "Lo sabía"). */
  @media (min-width: 1024px) and (min-height: 700px) and (prefers-reduced-motion: no-preference) {
    .projects {
      /* La tarjeta inclinada asoma un poco por los lados: que no cree scroll horizontal. Con clip
         (y no hidden) la sección no pasa a ser un contenedor de scroll, que rompería sticky */
      overflow-x: clip;
    }
    .stack {
      --stack-top: calc(var(--toolbar-h) + 1rem);
      --stack-h: min(calc(100svh - var(--stack-top) - clamp(1rem, 6vh, 5rem)), 44rem);
      /* En columna flexible y no en rejilla: una celda de rejilla es el límite de su elemento fijo, y
         con una fila por tarjeta ninguna podría quedarse quieta mientras sube la siguiente.
         El hueco es lo que cada tarjeta se queda sola en pantalla antes de que asome la siguiente; va
         como gap y no como margen porque el margen inferior cuenta para el límite del elemento fijo
         y las tarjetas de debajo empezarían a irse antes de que la última llegara a su sitio */
      display: flex;
      flex-direction: column;
      gap: clamp(2rem, 16vh, 10rem);
    }
    .stack-item {
      position: sticky;
      top: var(--stack-top);
      flex: none;
      height: var(--stack-h);
    }
    .stack-card {
      grid-template-rows: auto minmax(0, 1fr);
      height: 100%;
      /* El canto de la hoja: sin él, una tarjeta encima de otra del mismo color no se distingue */
      outline: 1px solid var(--line);
      outline-offset: -1px;
      /* Fuera la entrada con escala y transparencia: dejaría ver la tarjeta de debajo */
      animation: none;
    }
    .stack-visual,
    .stack-visual > [data-morph-visual] {
      display: grid;
      min-height: 0;
    }
    .stack-visual :global(.pv) {
      display: flex;
      flex-direction: column;
      min-height: 0;
    }
    .stack-visual :global(.pv-clip) {
      flex: 1 1 auto;
      height: auto;
      min-height: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .stack-cta span {
      transition: none;
    }
  }
</style>

<script>
  import '@/scripts/project-demos';
  import '@/scripts/project-stack';
</script>
