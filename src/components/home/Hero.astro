---
import { Image } from 'astro:assets';
import portraitDark from '@/assets/images/card-dark.jpg';
import portraitLight from '@/assets/images/card-light.webp';
import { useTranslations, useTranslatedPath } from '@/i18n/utils';
import { site } from '@/data/site';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Los tres oficios son también las tres lentes de la web
const roles = [
  { lens: 'design', key: '1', label: t('hero.roles.design') },
  { lens: 'code', key: '2', label: t('hero.roles.code') },
  { lens: 'qa', key: '3', label: t('hero.roles.qa') },
] as const;
---

<!--
  Hero: el retrato (la foto de la luz roja, en los dos modos) va fundido en el fondo, sin caja ni
  panel (referencia: la página "nosotros" de Vístalo).
  - Oscuro: la foto con su pared y la franja de luz, pero sin la sombra que la figura proyectaba en
    la pared (card-dark.jpg, que sale de card.jpg con .taste-skill/recorte/sin-sombra.cjs). La
    pared oscura se desvanece en la hoja oscura.
  - Claro: la misma foto "de día" (card-light.webp, D24 y D25): la figura sola, sin la franja de
    luz de la pared ni sombra, con fondo transparente para que se vea la hoja con su textura.
    Detrás del cuerpo lleva un velo oscuro muy suave, que hace de pared y se apaga hacia arriba
    (donde la foto asoma bajo la barra) y hacia los lados.
  En escritorio el fundido de abajo es el mismo en los dos modos: al cambiar de tema la figura no
  se mueve. (Se probó sentarla sobre una línea de base en claro; a Christian no le gustó.)
  El hero no pinta fondo propio: se ve la hoja del artboard.
  Texto y foto no se pisan (D22, 20 nov): en escritorio el texto ocupa su columna a la izquierda y
  la foto la suya a la derecha; en móvil la foto va arriba y el texto empieza donde ella termina.
  card-light.webp se genera con .taste-skill/recorte/luz-gris.cjs a partir de card.jpg y de su
  máscara de persona (docs/imgs/card-mascara.png).
  [data-ink] marca las piezas que entran escalonadas al acabar la intro (--ink-i es su turno).
-->
<section class="hero" data-cs="<section> Hero.astro">
  <div class="hero-inner wrap">
    <figure
      class="hero-photo"
      data-ink
      style="--ink-i: 2"
    >
      <!-- Solo se pinta (y solo se descarga) la del modo activo -->
      <Image
        src={portraitLight}
        alt={t('hero.portrait.alt')}
        widths={[640, 960, 1342]}
        sizes="(min-width: 700px) 46vw, 100vw"
        loading="lazy"
        class="hero-photo-img hero-photo-img--light"
      />
      <Image
        src={portraitDark}
        alt={t('hero.portrait.alt')}
        widths={[640, 960, 1342]}
        sizes="(min-width: 700px) 46vw, 100vw"
        loading="lazy"
        class="hero-photo-img hero-photo-img--dark"
      />
    </figure>

    <div class="hero-stage">
      <ul class="hero-roles" aria-label={t('hero.roles.label')} data-ink style="--ink-i: 0">
        {
          roles.map((role, i) => (
            <li>
              {i > 0 && <span class="hero-roles-x" aria-hidden="true">×</span>}
              <button
                type="button"
                class="hero-role-btn"
                data-lens-set={role.lens}
                aria-pressed="false"
                aria-keyshortcuts={role.key}
              >
                {role.label}
              </button>
            </li>
          ))
        }
      </ul>

      <h1 class="hero-title" data-ds="H1" data-ds-type>
        <span class="hero-name" data-ink style="--ink-i: 0">Christian Oller</span>
        <span class="hero-role" data-ink style="--ink-i: 1">{t('hero.role')}</span>
      </h1>

      <div class="hero-copy">
        <p class="hero-phrase" data-ink style="--ink-i: 3">
          <span>{t('hero.phrase.1')}</span>
          <span>{t('hero.phrase.2')}</span>
        </p>

        <div class="hero-actions" data-ink style="--ink-i: 4">
          <a
            class="btn btn-primary"
            href={translatePath('/projects')}
          >
            {t('hero.cta.projects')}
            <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn btn-quiet" href={site.cv} download>
            {t('hero.cta.cv')}
            <span class="btn-arrow" aria-hidden="true">↓</span>
          </a>
        </div>

        <p class="hero-status t-small" data-ink style="--ink-i: 5">
          <span class="status-dot" aria-hidden="true"></span>
          <span>
            {t('hero.status')}<time class="hero-clock" data-clock hidden />
          </span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }
  .hero-inner {
    position: relative;
    /* El ancho del contenido manda en todo el hero: titular, columnas y foto */
    container-type: inline-size;
    /* Móvil: proporción de la foto (alto / ancho) y punto de su alto en el que ya es transparente.
       El texto empieza justo ahí. Son los mismos en los dos modos: al cambiar de tema ni la foto ni
       el texto se mueven */
    --m-photo: 1;
    --m-clear: 0.88;
  }
  .hero-stage {
    position: relative;
    /* Columna del texto: hasta el 54 % del ancho. "Christian Oller" la llena y "Software developer"
       va en dos líneas, así nada entra en la foto (que empieza en el 58 %) */
    --text-col: 54cqi;
    --d: 9.8cqi;
    /* El bloque entero se queda en su columna (también la caja del H1 que dibuja la lente Diseño) */
    max-width: var(--text-col);
    padding-top: clamp(1.75rem, 3.4cqi, 2.75rem);
    padding-bottom: clamp(2.5rem, 4.4cqi, 3.5rem);
  }

  /* --- Retrato: fundido en el fondo, sin caja --- */
  /* La foto va en su columna, a la derecha del texto, con la cara a la altura del nombre. El
     encuadre es el mismo en los dos modos. */
  .hero-photo {
    position: absolute;
    top: -12.6cqi;
    left: calc(var(--pad) + 58cqi);
    width: 50cqi;
    aspect-ratio: 2 / 3;
    pointer-events: none;
  }
  .hero-photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* El fundido de abajo es el mismo en los dos modos (--fade-from, --fade-to), para que al cambiar
     de uno a otro la figura no se mueva ni cambie de altura */
  .hero-photo {
    --fade-from: 75%;
    --fade-to: 92%;
  }
  /* Claro: la figura se desvanece a los lados y por abajo */
  .hero-photo-img--light {
    mask-image:
      linear-gradient(90deg, transparent 0, #000 18%, #000 90%, transparent 100%),
      linear-gradient(180deg, #000 var(--fade-from), transparent var(--fade-to));
    mask-composite: intersect;
    -webkit-mask-composite: source-in;
  }
  /* Oscuro: la foto entera. Se desvanece a los lados y hacia abajo: no se ve ningún borde */
  .hero-photo-img--dark {
    display: none;
    filter: brightness(0.9) saturate(0.95);
    /* Arriba la pared también se funde con la hoja, en vez de cortarse recta bajo la barra. La foto
       asoma al 16,8 % de su alto (12,6cqi de 75cqi); el pelo, oscuro como la hoja, no lo acusa */
    mask-image:
      linear-gradient(90deg, transparent 0, #000 30%, #000 82%, transparent 100%),
      linear-gradient(180deg, transparent 16.8%, #000 25%, #000 var(--fade-from), transparent var(--fade-to));
    mask-composite: intersect;
    -webkit-mask-composite: source-in;
  }
  :global(:root.dark) .hero-photo-img--light {
    display: none;
  }
  :global(:root.dark) .hero-photo-img--dark {
    display: block;
  }

  /* --- Los tres oficios: cada uno activa su lente --- */
  .hero-roles {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    min-height: calc(0.5 * var(--d));
    font-size: clamp(1.0625rem, 1.9cqi, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .hero-roles li {
    display: flex;
    align-items: baseline;
  }
  .hero-roles-x {
    margin-inline: 0.6em;
    font-weight: 400;
    color: var(--muted);
  }
  .hero-role-btn {
    /* "QA" mide menos de 24 px de ancho en móvil: se le da el mínimo de zona táctil */
    min-width: 1.5rem;
    position: relative;
    padding-block: 0.35em;
    font: inherit;
    letter-spacing: inherit;
    color: inherit;
  }
  /* Subrayado a lápiz que se entinta al pasar el ratón y con la lente activa */
  .hero-role-btn::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0.2em;
    left: 0;
    height: 2px;
    background: currentColor;
    opacity: 0.32;
    transform-origin: 0 50%;
    transition:
      opacity var(--dur-micro) var(--ease-out),
      transform var(--dur-ui) var(--ease-out);
  }
  .hero-role-btn[aria-pressed='true']::after {
    opacity: 1;
    transform: scaleY(2);
  }
  @media (hover: hover) {
    .hero-role-btn:hover::after {
      opacity: 1;
    }
  }

  /* --- Titular --- */
  .hero-title {
    margin-top: 0.12em;
    font-size: var(--d);
    font-weight: var(--wght-ink);
    font-stretch: var(--wdth-ink);
    /* Siempre el corte de display: por debajo de 96 px el eje óptico ensancha las letras y el nombre
       se saldría de su columna en tablet */
    font-variation-settings: 'opsz' 96;
    line-height: 0.9;
    letter-spacing: -0.045em;
  }
  .hero-name,
  .hero-role {
    display: block;
  }
  .hero-name {
    white-space: nowrap;
  }
  /* El oficio, en gris: una palabra por línea ("Software" / "developer") para no salir de la columna */
  .hero-role {
    width: min-content;
    color: var(--muted);
  }
  :global(:root.dark) .hero-role {
    color: #b4b4b4;
  }

  /* --- Frase, botones y disponibilidad --- */
  .hero-copy {
    max-width: var(--text-col);
    margin-top: clamp(1.5rem, 3cqi, 2.5rem);
  }
  .hero-phrase {
    font-size: clamp(1.375rem, 2.7cqi, 2.125rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }
  .hero-phrase span {
    display: block;
    text-wrap: balance;
  }
  .hero-phrase span + span {
    color: var(--muted);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.25rem, 2.4cqi, 2rem);
  }
  .hero-status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.25rem;
    color: var(--muted);
  }
  .hero-clock {
    font-variant-numeric: tabular-nums;
  }
  .hero-clock::before {
    content: ' · ';
    white-space: pre;
  }
  .status-dot {
    width: 0.55rem;
    height: 0.55rem;
    background: var(--ok);
    border-radius: 50%;
    animation: status-pulse 2.4s ease-in-out infinite;
  }
  @keyframes status-pulse {
    50% {
      opacity: 0.35;
    }
  }

  /* --- Móvil: la foto arriba, a todo el ancho, y el texto empieza donde ella termina --- */
  @container (max-width: 640px) {
    .hero-photo {
      top: 0;
      left: 0;
      width: 100%;
    }
    /* El mismo encuadre y el mismo fundido de abajo en los dos modos: la foto se sube (la cabeza
       queda arriba) y la chaqueta se desvanece antes del nombre. En oscuro, además, la pared se
       funde arriba para que no haya un corte recto bajo la barra */
    .hero-photo {
      aspect-ratio: 1 / var(--m-photo);
      --fade-from: 77%;
      --fade-to: calc(var(--m-clear) * 100%);
    }
    .hero-photo-img {
      object-position: 50% 52%;
    }
    .hero-photo-img--light {
      mask-image: linear-gradient(180deg, #000 var(--fade-from), transparent var(--fade-to));
    }
    .hero-photo-img--dark {
      mask-image: linear-gradient(180deg, transparent 0, #000 8%, #000 var(--fade-from), transparent var(--fade-to));
    }
    /* El texto arranca donde la foto ya es transparente. La foto ocupa el ancho del contenido más
       sus dos márgenes (100cqi + 2 × --pad); su alto es ese ancho por --m-photo */
    .hero-stage {
      padding-top: calc(var(--m-clear) * var(--m-photo) * (100cqi + 2 * var(--pad)));
    }
    .hero-roles {
      order: 2;
      min-height: 0;
      /* En los móviles más estrechos baja un poco para que los tres oficios quepan en una línea */
      font-size: min(1.0625rem, 5.2cqi);
      margin-top: 1.25rem;
    }
    .hero-stage {
      display: flex;
      flex-direction: column;
      max-width: none;
    }
    .hero-title {
      order: 1;
      margin-top: 0;
      font-size: 11.2cqi;
    }
    .hero-name {
      font-size: 1.39em;
    }
    /* En móvil "Software developer" cabe en una línea */
    .hero-role {
      width: auto;
    }
    .hero-roles-x {
      margin-inline: 0.45em;
    }
    .hero-copy {
      order: 3;
      max-width: none;
      margin-top: 1.5rem;
    }
    .hero-actions .btn {
      flex: 1 1 0;
      white-space: nowrap;
    }
  }

  /* --- Entintado del titular (plan §4.3): en las visitas sin intro, las dos líneas nacen a lápiz
     (finas, estrechas y en grafito) y se entintan en 600 ms. --- */
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not(.intro-seen)) .hero-title span {
      animation: hero-ink var(--dur-ink) var(--ease-out) both;
      animation-delay: calc(var(--ink-i, 0) * 90ms + 150ms);
    }
    /* Al llegar desde otra página, espera a que la cámara termine de moverse */
    :global(html.arrived:not(.intro-seen)) .hero-title span {
      animation-delay: calc(var(--ink-i, 0) * 90ms + 520ms);
    }
  }
  @keyframes hero-ink {
    from {
      font-weight: var(--wght-pencil);
      font-stretch: var(--wdth-pencil);
      color: var(--graphite);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .status-dot {
      animation: none;
    }
  }
</style>

<script>
  // La hora de Madrid junto a la disponibilidad: "17:55 CET" (o CEST en verano)
  let timer: number | undefined;

  document.addEventListener('astro:page-load', () => {
    window.clearInterval(timer);
    const clock = document.querySelector<HTMLTimeElement>('[data-clock]');
    if (!clock) return;
    const time = new Intl.DateTimeFormat('es-ES', {
      timeZone: 'Europe/Madrid',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    });
    const zone = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Madrid', timeZoneName: 'short' });
    const tick = () => {
      const now = new Date();
      const abbr = zone.formatToParts(now).find((part) => part.type === 'timeZoneName')?.value ?? '';
      clock.textContent = `${time.format(now)} ${abbr}`.trim();
      clock.dateTime = now.toISOString();
      clock.hidden = false;
    };
    tick();
    timer = window.setInterval(tick, 15_000);
  });
</script>
