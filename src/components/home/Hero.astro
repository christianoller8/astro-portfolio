---
import { Image } from 'astro:assets';
import portrait from '@/assets/images/card.jpg';
import LensSwitch from '@/components/site/LensSwitch.astro';
import { useTranslations, useTranslatedPath } from '@/i18n/utils';
import { site, hasCV } from '@/data/site';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<!-- [data-intro-stage]: aquí se dibuja el boceto de la intro. [data-sketch] = qué se dibuja; [data-ink] = qué se entinta -->
<section class="hero wrap" data-intro-stage data-cs="<section> Hero.astro">
  <h1 class="hero-title t-display" data-ds="H1" data-ds-type>
    <span class="block" data-sketch="text" data-ink style="--ink-i: 0">Christian Oller</span>
    <span class="hero-role block" data-sketch="text" data-ink style="--ink-i: 1"
      >{t('hero.role')}</span
    >
  </h1>

  <div class="hero-grid">
    <div class="hero-copy">
      <p class="t-lead hero-lead" data-sketch="text" data-ink style="--ink-i: 2">
        {t('hero.lead')}
      </p>

      <div class="hero-actions" data-ink style="--ink-i: 3">
        <a
          class="btn btn-primary"
          href={translatePath('/projects')}
          data-sketch="box"
          data-sketch-note={t('intro.note.cta')}
        >
          {t('hero.cta.projects')}
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
        {
          hasCV ? (
            <a class="btn btn-quiet" href={site.cv} download data-sketch="box">
              {t('hero.cta.cv')}
            </a>
          ) : (
            <a class="btn btn-quiet" href={translatePath('/contact')} data-sketch="box">
              {t('hero.cta.contact')}
            </a>
          )
        }
      </div>

      <p class="hero-status t-small" data-sketch="text" data-ink style="--ink-i: 4">
        <span class="status-dot" aria-hidden="true"></span>
        {t('hero.status')}
      </p>

      <div class="hero-lens" data-ink style="--ink-i: 5">
        <p class="hero-lens-title">{t('hero.lens.title')}</p>
        <LensSwitch variant="tray" lang={lang} />
      </div>
    </div>

    <div
      class="hero-portrait"
      data-ds={lang === 'es' ? 'Retrato' : 'Portrait'}
      data-qa-host
      data-sketch="image"
      data-sketch-note={t('intro.note.photo')}
      data-ink
      style="--ink-i: 3"
    >
      <div class="hero-portrait-clip">
        <Image
          src={portrait}
          alt={t('hero.portrait.alt')}
          widths={[480, 720, 960]}
          sizes="(min-width: 1024px) 34vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="hero-portrait-img"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(2rem, 5vw, 4.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .hero-title {
    max-width: 100%;
  }
  .hero-role {
    color: var(--muted);
  }
  @media (max-width: 639px) {
    .hero-role {
      font-size: 0.8em;
    }
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }
  .hero-lead {
    max-width: 34ch;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .hero-status {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.5rem;
    color: var(--muted);
  }
  .status-dot {
    width: 0.55rem;
    height: 0.55rem;
    background: var(--ok);
    border-radius: 50%;
    animation: status-pulse 2.4s ease-in-out infinite;
  }
  @keyframes status-pulse {
    50% {
      opacity: 0.35;
    }
  }
  .hero-lens {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .hero-lens-title {
    margin-bottom: 0.75rem;
    font-family: var(--font-hand);
    font-size: 1.125rem;
    color: var(--pencil);
  }
  .hero-portrait {
    align-self: end;
    width: 100%;
    max-width: 30rem;
  }
  .hero-portrait-clip {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--tint);
  }
  .hero-portrait-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
      gap: 3rem;
    }
    .hero-portrait {
      justify-self: end;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .status-dot {
      animation: none;
    }
  }
</style>
