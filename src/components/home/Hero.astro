---
import { Image } from 'astro:assets';
import portrait from '@/assets/images/profile.jpg';
import { useTranslations, useTranslatedPath } from '@/i18n/utils';
import { site } from '@/data/site';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<!--
  Hero (plan §5.2): el titular a todo el ancho y el retrato como capa seleccionada, con la segunda
  línea cruzando por encima del jersey. El titular se funde con lo que tiene debajo (diferencia),
  así se lee igual sobre el papel, sobre el blanco de la foto y sobre el negro del jersey.
  [data-intro-stage], [data-sketch] y [data-ink] son los enganches de la intro.
-->
<section class="hero wrap" data-intro-stage data-cs="<section> Hero.astro">
  <div class="hero-stage">
    <h1 class="hero-title" data-ds="H1" data-ds-type>
      <span class="hero-name" data-sketch="text" data-ink style="--ink-i: 0">Christian Oller</span>
      <span class="hero-role" data-sketch="text" data-ink style="--ink-i: 1">{t('hero.role')}</span>
    </h1>

    <!-- Tres cajas: la posición (figure), la selección del kit y la que leen las lentes.
         La selección y las lentes dibujan con ::before y ::after, así que no pueden compartir caja -->
    <figure
      class="hero-portrait"
      data-sketch="image"
      data-sketch-note={t('intro.note.photo')}
      data-ink
      style="--ink-i: 2"
    >
      <figcaption class="hero-layer kit-frame-name" aria-hidden="true">{t('hero.layer')}</figcaption>
      <div class="hero-portrait-sel is-selected" data-sel>
        <div data-ds={lang === 'es' ? 'Retrato' : 'Portrait'} data-qa-host>
          <div class="hero-portrait-clip">
            <Image
              src={portrait}
              alt={t('hero.portrait.alt')}
              widths={[420, 720, 1080]}
              sizes="(min-width: 700px) 32vw, 100vw"
              loading="eager"
              fetchpriority="high"
              class="hero-portrait-img"
            />
          </div>
        </div>
      </div>
    </figure>

    <div class="hero-copy">
      <p class="hero-phrase" data-sketch="text" data-ink style="--ink-i: 3">
        <span>{t('hero.phrase.1')}</span>
        <span>{t('hero.phrase.2')}</span>
      </p>

      <div class="hero-actions" data-ink style="--ink-i: 4">
        <a
          class="btn btn-primary"
          href={translatePath('/projects')}
          data-sketch="box"
          data-sketch-note={t('intro.note.cta')}
        >
          {t('hero.cta.projects')}
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn-quiet" href={site.cv} download data-sketch="box">
          {t('hero.cta.cv')}
        </a>
      </div>

      <p class="hero-status t-small" data-sketch="text" data-ink style="--ink-i: 5">
        <span class="status-dot" aria-hidden="true"></span>
        <span>
          {t('hero.status')}<time class="hero-clock" data-clock hidden />
        </span>
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    /* El ancho del contenido manda en todo el hero: titular, retrato y solape */
    container-type: inline-size;
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    /* El contenedor aísla la mezcla: el papel tiene que estar dentro para que el titular se funda con él */
    background: var(--paper);
    /* El titular va en modo diferencia: estos tonos dan tinta y gris sobre el papel de cada modo */
    --title-ink: #e5e5e5;
    --title-muted: #b5b5b5;
  }
  :global(:root.dark) .hero {
    --title-ink: #ffffff;
    --title-muted: #bababa;
  }
  .hero-stage {
    position: relative;
    /* "Frontend developer" llega al borde derecho; el nombre, a unas siete décimas del ancho.
       Con margen: por debajo de 96 px el eje óptico de Bricolage ensancha un poco las letras */
    --d: 12.6cqi;
    --photo-w: 27cqi;
  }

  /* --- Titular --- */
  .hero-title {
    position: relative;
    z-index: 2;
    font-size: var(--d);
    font-weight: var(--wght-ink);
    font-stretch: var(--wdth-ink);
    line-height: 0.9;
    letter-spacing: -0.045em;
    white-space: nowrap;
    color: var(--title-ink);
    mix-blend-mode: difference;
  }
  .hero-name,
  .hero-role {
    display: block;
  }
  .hero-role {
    color: var(--title-muted);
  }

  /* --- Retrato: una capa seleccionada, con su nombre de archivo y su medida --- */
  .hero-portrait {
    position: absolute;
    top: calc(-0.3 * var(--d));
    right: 0;
    z-index: 1;
    width: var(--photo-w);
  }
  .hero-layer {
    position: absolute;
    bottom: calc(100% + 0.4rem);
    left: 0;
    font-weight: 500;
    white-space: nowrap;
  }
  /* Más estrecho que la foto: recorta el blanco de los lados y deja sitio al nombre */
  .hero-portrait-clip {
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: #ffffff;
  }
  .hero-portrait-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
  }

  /* --- Frase, botones y disponibilidad --- */
  .hero-copy {
    position: relative;
    z-index: 3;
    max-width: 62cqi;
    margin-top: clamp(1.75rem, 3.4cqi, 3rem);
  }
  .hero-phrase {
    font-size: clamp(1.375rem, 2.7cqi, 2.125rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }
  .hero-phrase span {
    display: block;
    text-wrap: balance;
  }
  .hero-phrase span + span {
    color: var(--muted);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.5rem, 2.6cqi, 2.25rem);
  }
  .hero-status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.5rem;
    color: var(--muted);
  }
  .hero-clock {
    font-variant-numeric: tabular-nums;
  }
  .hero-clock::before {
    content: ' · ';
    white-space: pre;
  }
  .status-dot {
    width: 0.55rem;
    height: 0.55rem;
    background: var(--ok);
    border-radius: 50%;
    animation: status-pulse 2.4s ease-in-out infinite;
  }
  @keyframes status-pulse {
    50% {
      opacity: 0.35;
    }
  }

  /* --- Móvil: nombre y oficio a todo el ancho, el retrato debajo y los botones al alcance del pulgar --- */
  @container (max-width: 640px) {
    .hero-title {
      font-size: 11.2cqi;
    }
    .hero-name {
      font-size: 1.39em;
    }
    .hero-portrait {
      position: relative;
      top: auto;
      width: 100%;
      margin-top: 2.25rem;
    }
    .hero-portrait-clip {
      aspect-ratio: 1 / 1;
    }
    .hero-copy {
      max-width: none;
      margin-top: 2.5rem;
    }
    .hero-actions .btn {
      flex: 1 1 0;
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .status-dot {
      animation: none;
    }
  }
</style>

<script>
  // La hora de Madrid junto a la disponibilidad: "17:55 CET" (o CEST en verano)
  let timer: number | undefined;

  document.addEventListener('astro:page-load', () => {
    window.clearInterval(timer);
    const clock = document.querySelector<HTMLTimeElement>('[data-clock]');
    if (!clock) return;
    const time = new Intl.DateTimeFormat('es-ES', {
      timeZone: 'Europe/Madrid',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    });
    const zone = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Madrid', timeZoneName: 'short' });
    const tick = () => {
      const now = new Date();
      const abbr = zone.formatToParts(now).find((part) => part.type === 'timeZoneName')?.value ?? '';
      clock.textContent = `${time.format(now)} ${abbr}`.trim();
      clock.dateTime = now.toISOString();
      clock.hidden = false;
    };
    tick();
    timer = window.setInterval(tick, 15_000);
  });
</script>
