---
import { Image } from 'astro:assets';
import portrait from '@/assets/images/card.jpg';
import { useTranslations, useTranslatedPath } from '@/i18n/utils';
import { site } from '@/data/site';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<!--
  Hero (plan §5.2): el titular a todo el ancho y el retrato como capa seleccionada, con la segunda
  línea cruzando por encima de la chaqueta. El titular real queda debajo de la foto; dentro de la
  foto va una copia en claro, recortada por su marco y colocada en el mismo sitio, de modo que cada
  letra cambia de tono justo en el borde. La foto es oscura: si se cambia por una clara, hay que
  cambiar los tonos de .hero-title-over.
  [data-intro-stage], [data-sketch] y [data-ink] son los enganches de la intro.
-->
<section class="hero wrap" data-intro-stage data-cs="<section> Hero.astro">
  <div class="hero-stage">
    <h1 class="hero-title" data-ds="H1" data-ds-type>
      <span class="hero-name" data-sketch="text" data-ink style="--ink-i: 0">Christian Oller</span>
      <span class="hero-role" data-sketch="text" data-ink style="--ink-i: 1">{t('hero.role')}</span>
    </h1>

    <!-- Tres cajas: la posición (figure), la selección del kit y la que leen las lentes.
         La selección y las lentes dibujan con ::before y ::after, así que no pueden compartir caja -->
    <figure
      class="hero-portrait"
      data-sketch="image"
      data-sketch-note={t('intro.note.photo')}
      data-ink
      style="--ink-i: 2"
    >
      <figcaption class="hero-layer kit-frame-name" aria-hidden="true">{t('hero.layer')}</figcaption>
      <div class="hero-portrait-sel is-selected" data-sel>
        <div data-ds={lang === 'es' ? 'Retrato' : 'Portrait'} data-qa-host>
          <div class="hero-portrait-clip">
            <Image
              src={portrait}
              alt={t('hero.portrait.alt')}
              widths={[480, 800, 1200]}
              sizes="(min-width: 700px) 32vw, 100vw"
              loading="eager"
              fetchpriority="high"
              class="hero-portrait-img"
            />
            <div class="hero-title hero-title-over" aria-hidden="true">
              <span class="hero-name">Christian Oller</span>
              <span class="hero-role">{t('hero.role')}</span>
            </div>
          </div>
        </div>
      </div>
    </figure>

    <div class="hero-copy">
      <p class="hero-phrase" data-sketch="text" data-ink style="--ink-i: 3">
        <span>{t('hero.phrase.1')}</span>
        <span>{t('hero.phrase.2')}</span>
      </p>

      <div class="hero-actions" data-ink style="--ink-i: 4">
        <a
          class="btn btn-primary"
          href={translatePath('/projects')}
          data-sketch="box"
          data-sketch-note={t('intro.note.cta')}
        >
          {t('hero.cta.projects')}
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn-quiet" href={site.cv} download data-sketch="box">
          {t('hero.cta.cv')}
        </a>
      </div>

      <p class="hero-status t-small" data-sketch="text" data-ink style="--ink-i: 5">
        <span class="status-dot" aria-hidden="true"></span>
        <span>
          {t('hero.status')}<time class="hero-clock" data-clock hidden />
        </span>
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    /* El ancho del contenido manda en todo el hero: titular, retrato y solape */
    container-type: inline-size;
    padding-top: clamp(2rem, 3vw, 2.75rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .hero-stage {
    position: relative;
    /* El retrato sube por encima del titular: así la cara queda junto al nombre y el oficio cruza la chaqueta */
    --rise: calc(0.34 * var(--d));
    padding-top: var(--rise);
    /* "Frontend developer" llega al borde derecho; el nombre, a unas siete décimas del ancho.
       Con margen: por debajo de 96 px el eje óptico de Bricolage ensancha un poco las letras */
    --d: 12.6cqi;
    --photo-w: 27cqi;
  }

  /* --- Titular --- */
  .hero-title {
    font-size: var(--d);
    font-weight: var(--wght-ink);
    font-stretch: var(--wdth-ink);
    line-height: 0.9;
    letter-spacing: -0.045em;
    white-space: nowrap;
  }
  .hero-name,
  .hero-role {
    display: block;
  }
  .hero-role {
    color: var(--muted);
  }
  /* La copia en claro que se ve dentro de la foto: mismo sitio, mismo tamaño */
  .hero-title-over {
    position: absolute;
    top: var(--rise);
    left: calc(var(--photo-w) - 100cqi);
    width: 100cqi;
    color: #f5f5f5;
    pointer-events: none;
    user-select: none;
  }
  .hero-title-over .hero-role {
    color: #d4d4d4;
  }

  /* --- Retrato: una capa seleccionada, con su nombre de archivo y su medida --- */
  .hero-portrait {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 1;
    width: var(--photo-w);
  }
  .hero-layer {
    position: absolute;
    bottom: calc(100% + 0.4rem);
    left: 0;
    font-weight: 500;
    white-space: nowrap;
  }
  .hero-portrait-clip {
    position: relative;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: #4b4a48;
  }
  /* La foto se acerca un poco (se ve el 86 %) y se sube: la cara queda en la mitad de arriba */
  .hero-portrait-img {
    position: absolute;
    top: -16.3%;
    left: -8.15%;
    width: 116.3%;
    max-width: none;
    height: 116.3%;
    object-fit: cover;
  }

  /* --- Frase, botones y disponibilidad --- */
  .hero-copy {
    position: relative;
    z-index: 3;
    max-width: 62cqi;
    margin-top: clamp(1.75rem, 3.4cqi, 3rem);
  }
  .hero-phrase {
    font-size: clamp(1.375rem, 2.7cqi, 2.125rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }
  .hero-phrase span {
    display: block;
    text-wrap: balance;
  }
  .hero-phrase span + span {
    color: var(--muted);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.5rem, 2.6cqi, 2.25rem);
  }
  .hero-status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.5rem;
    color: var(--muted);
  }
  .hero-clock {
    font-variant-numeric: tabular-nums;
  }
  .hero-clock::before {
    content: ' · ';
    white-space: pre;
  }
  .status-dot {
    width: 0.55rem;
    height: 0.55rem;
    background: var(--ok);
    border-radius: 50%;
    animation: status-pulse 2.4s ease-in-out infinite;
  }
  @keyframes status-pulse {
    50% {
      opacity: 0.35;
    }
  }

  /* --- Móvil: nombre y oficio a todo el ancho, el retrato debajo y los botones al alcance del pulgar --- */
  @container (max-width: 640px) {
    .hero-title {
      font-size: 11.2cqi;
    }
    .hero-name {
      font-size: 1.39em;
    }
    .hero-stage {
      padding-top: 0.5rem;
    }
    .hero-portrait {
      position: relative;
      width: 100%;
      margin-top: 2.25rem;
    }
    .hero-portrait-clip {
      aspect-ratio: 1 / 1;
    }
    /* En cuadrado: a todo el ancho, de la frente a las manos */
    .hero-portrait-img {
      top: -27%;
      left: 0;
      width: 100%;
      height: 150%;
    }
    .hero-title-over {
      display: none;
    }
    .hero-copy {
      max-width: none;
      margin-top: 2.5rem;
    }
    .hero-actions .btn {
      flex: 1 1 0;
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .status-dot {
      animation: none;
    }
  }
</style>

<script>
  // La hora de Madrid junto a la disponibilidad: "17:55 CET" (o CEST en verano)
  let timer: number | undefined;

  document.addEventListener('astro:page-load', () => {
    window.clearInterval(timer);
    const clock = document.querySelector<HTMLTimeElement>('[data-clock]');
    if (!clock) return;
    const time = new Intl.DateTimeFormat('es-ES', {
      timeZone: 'Europe/Madrid',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    });
    const zone = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Madrid', timeZoneName: 'short' });
    const tick = () => {
      const now = new Date();
      const abbr = zone.formatToParts(now).find((part) => part.type === 'timeZoneName')?.value ?? '';
      clock.textContent = `${time.format(now)} ${abbr}`.trim();
      clock.dateTime = now.toISOString();
      clock.hidden = false;
    };
    tick();
    timer = window.setInterval(tick, 15_000);
  });
</script>
