---
import { Image } from 'astro:assets';
import portrait from '@/assets/images/card.jpg';
import { useTranslations, useTranslatedPath } from '@/i18n/utils';
import { site } from '@/data/site';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Los tres oficios son también las tres lentes de la web
const roles = [
  { lens: 'design', key: '1', label: t('hero.roles.design') },
  { lens: 'code', key: '2', label: t('hero.roles.code') },
  { lens: 'qa', key: '3', label: t('hero.roles.qa') },
] as const;
---

<!--
  Hero: un escenario oscuro en los dos modos, con el retrato fundido en el fondo (referencia:
  la página "nosotros" de Vístalo). La foto no va en una caja: sangra por arriba y por la derecha,
  y se desvanece hacia la izquierda y hacia abajo. La cara queda junto al nombre y el oficio
  cruza por la chaqueta.
  [data-intro-stage], [data-sketch] y [data-ink] son los enganches de la intro.
-->
<section class="hero" data-intro-stage data-cs="<section> Hero.astro">
  <div class="hero-inner wrap">
    <figure
      class="hero-photo"
      data-sketch="image"
      data-sketch-note={t('intro.note.photo')}
      data-ink
      style="--ink-i: 2"
    >
      <Image
        src={portrait}
        alt={t('hero.portrait.alt')}
        widths={[640, 960, 1342]}
        sizes="(min-width: 700px) 46vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="hero-photo-img"
      />
    </figure>

    <div class="hero-stage">
      <ul class="hero-roles" aria-label={t('hero.roles.label')} data-ink style="--ink-i: 0">
        {
          roles.map((role, i) => (
            <li>
              {i > 0 && <span class="hero-roles-x" aria-hidden="true">×</span>}
              <button
                type="button"
                class="hero-role-btn"
                data-lens-set={role.lens}
                aria-pressed="false"
                aria-keyshortcuts={role.key}
              >
                {role.label}
              </button>
            </li>
          ))
        }
      </ul>

      <h1 class="hero-title" data-ds="H1" data-ds-type>
        <span class="hero-name" data-sketch="text" data-ink style="--ink-i: 0">Christian Oller</span>
        <span class="hero-role" data-sketch="text" data-ink style="--ink-i: 1">{t('hero.role')}</span>
      </h1>

      <div class="hero-copy">
        <p class="hero-phrase" data-sketch="text" data-ink style="--ink-i: 3">
          <span>{t('hero.phrase.1')}</span>
          <span>{t('hero.phrase.2')}</span>
        </p>

        <div class="hero-actions" data-ink style="--ink-i: 4">
          <a
            class="btn btn-primary"
            href={translatePath('/projects')}
            data-sketch="box"
            data-sketch-note={t('intro.note.cta')}
          >
            {t('hero.cta.projects')}
            <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn btn-quiet" href={site.cv} download data-sketch="box">
            {t('hero.cta.cv')}
          </a>
        </div>

        <p class="hero-status t-small" data-sketch="text" data-ink style="--ink-i: 5">
          <span class="status-dot" aria-hidden="true"></span>
          <span>
            {t('hero.status')}<time class="hero-clock" data-clock hidden />
          </span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    /* Escenario oscuro en los dos modos: dentro del hero valen siempre los tonos del modo oscuro */
    --paper: #171717;
    --ink: #f5f5f5;
    --muted: #a3a3a3;
    --line: #3a3a3c;
    --tint: #262626;
    --graphite: #7c7c82;
    --pencil: var(--ink);
    --pencil-ink: var(--paper);
    --ok: #22c55e;
    color: var(--ink);
    background: var(--paper);
  }
  .hero-inner {
    position: relative;
    /* El ancho del contenido manda en todo el hero: titular, foto y solape */
    container-type: inline-size;
  }
  .hero-stage {
    position: relative;
    z-index: 1;
    /* "Software developer" llega casi al borde derecho; el nombre, a unas siete décimas del ancho.
       Con margen: por debajo de 96 px el eje óptico de Bricolage ensancha un poco las letras */
    --d: 12.6cqi;
    padding-top: clamp(1.75rem, 3.4cqi, 2.75rem);
    padding-bottom: clamp(2.5rem, 4.4cqi, 3.5rem);
  }

  /* --- Retrato: fundido en el fondo, sin caja --- */
  .hero-photo {
    position: absolute;
    /* La foto se coloca respecto al contenido: la cara cae a la derecha del nombre y por encima
       de la segunda línea */
    top: -12.6cqi;
    left: calc(var(--pad) + 55.5cqi);
    width: 50cqi;
    aspect-ratio: 2 / 3;
    pointer-events: none;
  }
  .hero-photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.9) saturate(0.95);
    /* Se desvanece a los lados y hacia abajo: no se ve ningún borde de foto */
    mask-image:
      linear-gradient(90deg, transparent 0, #000 30%, #000 82%, transparent 100%),
      linear-gradient(180deg, #000 62%, transparent 96%);
    mask-composite: intersect;
    -webkit-mask-composite: source-in;
  }

  /* --- Los tres oficios: cada uno activa su lente --- */
  .hero-roles {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    min-height: calc(0.5 * var(--d));
    font-size: clamp(1.0625rem, 1.9cqi, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .hero-roles li {
    display: flex;
    align-items: baseline;
  }
  .hero-roles-x {
    margin-inline: 0.6em;
    font-weight: 400;
    color: var(--muted);
  }
  .hero-role-btn {
    position: relative;
    padding-block: 0.35em;
    font: inherit;
    letter-spacing: inherit;
    color: inherit;
  }
  /* Subrayado a lápiz que se entinta al pasar el ratón y con la lente activa */
  .hero-role-btn::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0.2em;
    left: 0;
    height: 2px;
    background: currentColor;
    opacity: 0.32;
    transform-origin: 0 50%;
    transition:
      opacity var(--dur-micro) var(--ease-out),
      transform var(--dur-ui) var(--ease-out);
  }
  .hero-role-btn[aria-pressed='true']::after {
    opacity: 1;
    transform: scaleY(2);
  }
  @media (hover: hover) {
    .hero-role-btn:hover::after {
      opacity: 1;
    }
  }

  /* --- Titular --- */
  .hero-title {
    margin-top: 0.12em;
    font-size: var(--d);
    font-weight: var(--wght-ink);
    font-stretch: var(--wdth-ink);
    line-height: 0.9;
    letter-spacing: -0.045em;
    white-space: nowrap;
  }
  .hero-name,
  .hero-role {
    display: block;
  }
  .hero-role {
    color: #b4b4b4;
  }

  /* --- Frase, botones y disponibilidad --- */
  .hero-copy {
    max-width: 62cqi;
    margin-top: clamp(1.5rem, 3cqi, 2.5rem);
  }
  .hero-phrase {
    font-size: clamp(1.375rem, 2.7cqi, 2.125rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }
  .hero-phrase span {
    display: block;
    text-wrap: balance;
  }
  .hero-phrase span + span {
    color: var(--muted);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.25rem, 2.4cqi, 2rem);
  }
  .hero-status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.25rem;
    color: var(--muted);
  }
  .hero-clock {
    font-variant-numeric: tabular-nums;
  }
  .hero-clock::before {
    content: ' · ';
    white-space: pre;
  }
  .status-dot {
    width: 0.55rem;
    height: 0.55rem;
    background: var(--ok);
    border-radius: 50%;
    animation: status-pulse 2.4s ease-in-out infinite;
  }
  @keyframes status-pulse {
    50% {
      opacity: 0.35;
    }
  }

  /* --- Móvil: la foto arriba, a todo el ancho, y el nombre montado sobre la chaqueta --- */
  @container (max-width: 640px) {
    .hero-photo {
      top: 0;
      left: 0;
      width: 100%;
      aspect-ratio: 1 / 1.18;
    }
    .hero-photo-img {
      object-position: 50% 30%;
      mask-image: linear-gradient(180deg, #000 48%, transparent 92%);
    }
    .hero-stage {
      padding-top: 71cqi;
    }
    .hero-roles {
      order: 2;
      min-height: 0;
      margin-top: 1.25rem;
    }
    .hero-stage {
      display: flex;
      flex-direction: column;
    }
    .hero-title {
      order: 1;
      margin-top: 0;
      font-size: 11.2cqi;
    }
    .hero-name {
      font-size: 1.39em;
    }
    .hero-copy {
      order: 3;
      max-width: none;
      margin-top: 1.5rem;
    }
    .hero-actions .btn {
      flex: 1 1 0;
      white-space: nowrap;
    }
  }

  /* --- Entintado del titular (plan §4.3): en las visitas sin intro, las dos líneas nacen a lápiz
     (finas, estrechas y en grafito) y se entintan en 600 ms. --- */
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not(.intro-seen)) .hero-title span {
      animation: hero-ink var(--dur-ink) var(--ease-out) both;
      animation-delay: calc(var(--ink-i, 0) * 90ms + 150ms);
    }
    /* Al llegar desde otra página, espera a que la cámara termine de moverse */
    :global(html.arrived:not(.intro-seen)) .hero-title span {
      animation-delay: calc(var(--ink-i, 0) * 90ms + 520ms);
    }
  }
  @keyframes hero-ink {
    from {
      font-weight: var(--wght-pencil);
      font-stretch: var(--wdth-pencil);
      color: var(--graphite);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .status-dot {
      animation: none;
    }
  }
</style>

<script>
  // La hora de Madrid junto a la disponibilidad: "17:55 CET" (o CEST en verano)
  let timer: number | undefined;

  document.addEventListener('astro:page-load', () => {
    window.clearInterval(timer);
    const clock = document.querySelector<HTMLTimeElement>('[data-clock]');
    if (!clock) return;
    const time = new Intl.DateTimeFormat('es-ES', {
      timeZone: 'Europe/Madrid',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    });
    const zone = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Madrid', timeZoneName: 'short' });
    const tick = () => {
      const now = new Date();
      const abbr = zone.formatToParts(now).find((part) => part.type === 'timeZoneName')?.value ?? '';
      clock.textContent = `${time.format(now)} ${abbr}`.trim();
      clock.dateTime = now.toISOString();
      clock.hidden = false;
    };
    tick();
    timer = window.setInterval(tick, 15_000);
  });
</script>
