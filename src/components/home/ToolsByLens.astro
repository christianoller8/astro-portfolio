---
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const columns = [
  {
    lens: 'design',
    title: t('lens.design'),
    tools: [
      'Figma',
      'Procreate',
      lang === 'es' ? 'Wireframes y prototipos' : 'Wireframes and prototypes',
    ],
  },
  {
    lens: 'code',
    title: t('lens.code'),
    tools: [
      'Angular · RxJS · NgRx · Signals',
      'TypeScript · JavaScript · Python',
      'Astro · React · Next.js',
      'Tailwind CSS · SASS · PrimeNG',
      'SQL Server · MongoDB · REST · GraphQL',
      'WordPress · Git · Bitbucket · Jira',
    ],
  },
  {
    lens: 'qa',
    title: t('lens.qa'),
    tools: [
      'Cypress · Playwright',
      'Jasmine · Karma',
      'Postman',
      lang === 'es' ? 'Tests unitarios, de integración y E2E' : 'Unit, integration and E2E tests',
    ],
  },
] as const;
---

<section class="tools wrap" data-cs="<section> ToolsByLens.astro">
  <h2 class="t-head" data-reveal>{t('stack.title')}</h2>
  <p class="t-lead tools-lead" data-reveal style="--reveal-i: 1">{t('stack.lead')}</p>

  <div class="tools-grid">
    {
      columns.map((column, i) => (
        <div class="tools-col" data-reveal style={`--reveal-i: ${i + 2}`}>
          <h3 class="tools-title">{column.title}</h3>
          <ul class="tools-list">
            {column.tools.map((tool) => (
              <li>{tool}</li>
            ))}
          </ul>
          {/* Aquí iba un botón "Ver la web como Diseño / Código / QA" por columna: Christian lo quitó
              el 20 nov. Las lentes se abren desde el bocadillo de la caricatura */}
        </div>
      ))
    }
  </div>
</section>

<style>
  .tools {
    padding-top: clamp(5rem, 10vw, 9rem);
  }
  .tools-lead {
    max-width: 40ch;
    margin-top: 1rem;
    color: var(--muted);
  }
  .tools-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }
  /* Los tres oficios son los protagonistas de la sección */
  .tools-title {
    font-size: var(--step-title);
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .tools-list {
    display: grid;
    gap: 0.35rem;
    margin-top: 1.1rem;
    font-size: var(--step-lead);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  @media (min-width: 768px) {
    .tools-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }
  }
</style>
