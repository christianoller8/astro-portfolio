---
// Lo que uso, por oficio: cada herramienta con su logotipo (20 nov, pedido por Christian).
// Los logotipos salen de simple-icons (CC0), que da el trazado de cada marca en un solo color: se
// pintan en la tinta del tema, no en el color de la marca. Solo se importan los que se usan y
// acaban como SVG dentro del HTML; el paquete no llega al navegador.
// Sin logotipo quedan las que simple-icons no trae (Procreate, SQL Server, Playwright y Karma) y
// las que no son una marca (Signals, REST, las frases): van con su nombre a secas. Ojo: el icono
// "Signal" del paquete es el de la app de mensajería, no el de los signals de Angular.
import {
  siAngular,
  siAstro,
  siBitbucket,
  siCypress,
  siFigma,
  siGit,
  siGraphql,
  siJasmine,
  siJavascript,
  siJira,
  siMongodb,
  siNextdotjs,
  siNgrx,
  siPostman,
  siPrimeng,
  siPython,
  siReact,
  siReactivex,
  siSass,
  siTailwindcss,
  siTypescript,
  siWordpress,
} from 'simple-icons';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const logos: Record<string, { path: string }> = {
  Figma: siFigma,
  Angular: siAngular,
  RxJS: siReactivex,
  NgRx: siNgrx,
  TypeScript: siTypescript,
  JavaScript: siJavascript,
  Python: siPython,
  Astro: siAstro,
  React: siReact,
  'Next.js': siNextdotjs,
  'Tailwind CSS': siTailwindcss,
  SASS: siSass,
  PrimeNG: siPrimeng,
  MongoDB: siMongodb,
  GraphQL: siGraphql,
  WordPress: siWordpress,
  Git: siGit,
  Bitbucket: siBitbucket,
  Jira: siJira,
  Cypress: siCypress,
  Jasmine: siJasmine,
  Postman: siPostman,
};

// Cada fila es una familia de herramientas
const columns = [
  {
    title: t('lens.design'),
    rows: [['Figma', 'Procreate'], [lang === 'es' ? 'Wireframes y prototipos' : 'Wireframes and prototypes']],
  },
  {
    title: t('lens.code'),
    rows: [
      ['Angular', 'RxJS', 'NgRx', 'Signals'],
      ['TypeScript', 'JavaScript', 'Python'],
      ['Astro', 'React', 'Next.js'],
      ['Tailwind CSS', 'SASS', 'PrimeNG'],
      ['SQL Server', 'MongoDB', 'REST', 'GraphQL'],
      ['WordPress', 'Git', 'Bitbucket', 'Jira'],
    ],
  },
  {
    title: t('lens.qa'),
    rows: [
      ['Cypress', 'Playwright'],
      ['Jasmine', 'Karma'],
      ['Postman'],
      [lang === 'es' ? 'Tests unitarios, de integración y E2E' : 'Unit, integration and E2E tests'],
    ],
  },
];
---

<section class="tools wrap" data-cs="<section> ToolsByLens.astro">
  <h2 class="t-head" data-reveal>{t('stack.title')}</h2>
  <p class="t-lead tools-lead" data-reveal style="--reveal-i: 1">{t('stack.lead')}</p>

  <div class="tools-grid">
    {
      columns.map((column, i) => (
        <div class="tools-col" data-reveal style={`--reveal-i: ${i + 2}`}>
          <h3 class="tools-title">{column.title}</h3>
          <ul class="tools-list">
            {column.rows.map((row) => (
              <li class="tools-row">
                {row.map((tool) => (
                  <span class="tool">
                    {logos[tool] && (
                      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                        <path d={logos[tool].path} />
                      </svg>
                    )}
                    {tool}
                  </span>
                ))}
              </li>
            ))}
          </ul>
          {/* Aquí iba un botón "Ver la web como Diseño / Código / QA" por columna: Christian lo quitó
              el 20 nov. Las lentes se abren desde el bocadillo de la caricatura */}
        </div>
      ))
    }
  </div>
</section>

<style>
  .tools {
    padding-top: clamp(5rem, 10vw, 9rem);
  }
  .tools-lead {
    max-width: 40ch;
    margin-top: 1rem;
    color: var(--muted);
  }
  .tools-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }
  /* Los tres oficios son los protagonistas de la sección */
  .tools-title {
    font-size: var(--step-title);
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .tools-list {
    display: grid;
    gap: 0.375rem;
    margin-top: 1.1rem;
  }
  .tools-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  /* Cada herramienta, una pieza plana del sistema: su logotipo en tinta y su nombre */
  .tool {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.25rem;
    padding: 0 0.7rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    background: var(--tint);
  }
  .tool svg {
    flex: none;
    fill: currentColor;
  }
  @media (min-width: 768px) {
    .tools-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }
  }
</style>
