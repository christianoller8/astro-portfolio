---
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const services = [
  { title: t('services.frontend.title'), description: t('services.frontend.desc') },
  { title: t('services.backend.title'), description: t('services.backend.desc') },
  { title: t('services.uiux.title'), description: t('services.uiux.desc') },
  { title: t('services.testing.title'), description: t('services.testing.desc') },
];
---

<section class="mx-auto w-full max-w-[1400px] px-6 py-12 md:px-12 md:py-16 lg:px-20">
  <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4 lg:gap-12">
    {
      services.map((service) => (
        <div class="group space-y-3">
          <h3 class="text-foreground group-hover:text-primary text-base font-bold tracking-wider uppercase transition-colors">
            {service.title}
          </h3>

          <div class="bg-border group-hover:bg-primary/50 h-px w-12 transition-all duration-500 group-hover:w-full dark:bg-neutral-800" />

          <p class="text-muted-foreground text-base leading-relaxed text-pretty">
            {service.description}
          </p>
        </div>
      ))
    }
  </div>
</section>
