---
import { Image, getImage } from 'astro:assets';
import cardImage from '@/assets/images/card.jpg';
import Lanyard from '@/components/lanyard/Lanyard';
import { useTranslations, useTranslatedPath } from '@/i18n/utils';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
// Small optimized copy of the photo, drawn onto the 3D card texture
const work = [
  { key: 'hero.work.design', tech: 'Figma · Procreate' },
  { key: 'hero.work.wordpress', tech: 'PHP · SQL' },
  { key: 'hero.work.web', tech: 'Tailwind · Next.js' },
  { key: 'hero.work.apps', tech: 'Angular v8–v21' },
  { key: 'hero.work.tests', tech: 'Cypress · Jasmine · Postman' },
] as const;
const cardPhoto = await getImage({ src: cardImage, width: 900, format: 'jpeg' });
---

<section class="w-full pb-12 lg:pb-0">
  <div
    class="mx-auto flex w-full max-w-[1400px] flex-col items-center gap-6 lg:grid lg:grid-cols-2 lg:items-start lg:gap-0 lg:px-20"
  >
    <div
      class="pointer-events-none relative z-10 order-2 flex flex-col items-center space-y-8 px-6 text-center md:px-12 lg:h-[780px] lg:items-start lg:justify-center lg:pt-28 lg:pr-0 lg:pl-[max(0px,calc(100%-34rem))] lg:text-left"
    >
      <div class="pointer-events-auto w-full space-y-6 lg:w-[34rem]">
        <h1
          class="text-foreground font-serif text-4xl leading-[1.1] text-balance md:text-5xl lg:text-[3.4rem] lg:tracking-[-0.025em] lg:text-nowrap"
        >
          {
            t('hero.headline')
              .split('|')
              .map((line) => (
                <span class="block">
                  {line
                    .split('*')
                    .map((part, i) => (i % 2 ? <em class="italic">{part}</em> : part))}
                </span>
              ))
          }
        </h1>

        <p
          class="text-muted-foreground mx-auto max-w-[34rem] text-lg leading-relaxed text-pretty lg:mx-0"
        >
          {t('hero.description')}
        </p>
      </div>

      <div
        class="pointer-events-auto flex flex-wrap items-center justify-center gap-3 lg:justify-start"
      >
        <a
          href={translatePath('/contact')}
          class="bg-foreground text-background hover:bg-foreground/90 inline-flex items-center justify-center rounded-full px-8 py-3 text-sm font-medium transition-transform hover:scale-105"
        >
          {t('hero.button')}
          <svg
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="ml-2"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a
          href={translatePath('/projects')}
          class="border-foreground/30 text-foreground hover:bg-foreground/5 inline-flex items-center justify-center rounded-full border px-8 py-3 text-sm font-medium transition-colors"
        >
          {t('hero.button.secondary')}
        </a>
      </div>

      <ul class="border-foreground/20 pointer-events-auto mt-6 w-full text-left lg:w-[34rem]">
        {
          work.map((item, i) => (
            <li class="border-foreground/20 flex items-baseline gap-4 border-t py-3 last:border-b">
              <span class="text-muted-foreground w-6 shrink-0 text-xs tracking-widest tabular-nums">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="text-foreground flex-1 text-base font-medium">{t(item.key)}</span>
              <span class="text-muted-foreground text-sm">{item.tech}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Lanyard column: the 3D canvas covers it from the header edge down past the card -->
    <div class="order-1 w-full lg:order-1">
      <div
        data-lanyard="pending"
        class="group relative h-[480px] w-full md:h-[640px] lg:-ml-20 lg:h-[780px] lg:w-[505px]"
        style="container-type: size; --u: calc(100cqh / 780);"
      >
        <!-- Static fallback (same geometry as the 3D scene, sized in --u = 1 design px at lg).
             Always rendered, faded out once the 3D lanyard is running. -->
        <div
          class="absolute inset-0 transition-opacity duration-500 group-data-[lanyard=ready]:pointer-events-none group-data-[lanyard=ready]:opacity-0"
        >
          <div
            class="absolute top-0 left-1/2 -translate-x-1/2 bg-[#1c1c1c]"
            style="width: calc(var(--u) * 16); height: calc(var(--u) * 179);"
          >
          </div>
          <div
            class="absolute left-1/2 -translate-x-1/2 bg-[#86868b]"
            style="top: calc(var(--u) * 165); width: calc(var(--u) * 47); height: calc(var(--u) * 14);"
          >
          </div>
          <div
            class="absolute left-1/2 -translate-x-1/2 overflow-hidden bg-[#0d0d0d] shadow-[0_24px_50px_-16px_rgb(0_0_0/0.3)]"
            style="top: calc(var(--u) * 179); width: calc(var(--u) * 300); height: calc(var(--u) * 410); border-radius: calc(var(--u) * 16); scale: 1.15; transform-origin: 50% 0;"
          >
            <div
              class="absolute inset-x-0 top-0 overflow-hidden"
              style="height: calc(var(--u) * 300);"
            >
              <Image
                src={cardImage}
                alt={t('about.img.alt')}
                widths={[320, 640]}
                sizes="(min-width: 1024px) 300px, 240px"
                class="h-full w-full object-cover object-[50%_43%]"
                loading="eager"
                fetchpriority="high"
              />
            </div>
            <span
              class="absolute font-serif whitespace-nowrap text-white uppercase"
              style="left: calc(var(--u) * 18); top: calc(var(--u) * 328); transform: translateY(-50%); font-size: calc(var(--u) * 22);"
            >
              Christian Oller
            </span>
            <span
              class="absolute font-medium whitespace-nowrap text-zinc-400 uppercase"
              style="left: calc(var(--u) * 18); top: calc(var(--u) * 355); transform: translateY(-50%); font-size: calc(var(--u) * 9.5); letter-spacing: 0.17em;"
            >
              Designer × Developer × QA
            </span>
            <span
              class="absolute rounded-full bg-[#22c55e]"
              style="left: calc(var(--u) * 17.5); top: calc(var(--u) * 381.5); width: calc(var(--u) * 7); height: calc(var(--u) * 7);"
            ></span>
            <span
              class="absolute font-semibold whitespace-nowrap text-zinc-200"
              style="left: calc(var(--u) * 32); top: calc(var(--u) * 385); transform: translateY(-50%); font-size: calc(var(--u) * 11);"
            >
              {t('hero.status')}
            </span>
          </div>
        </div>
        <!-- Decorative 3D lanyard (client-only, lazy, skipped on reduced motion / no WebGL) -->
        <Lanyard
          client:only="react"
          name="Christian Oller"
          role="Designer × Developer × QA"
          site="christianoller.dev"
          status={t('hero.status')}
          photoUrl={cardPhoto.src}
        />
      </div>
    </div>
  </div>
</section>
