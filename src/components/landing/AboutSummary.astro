---
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="bg-background py-20 lg:py-24">
  <div class="mx-auto w-full max-w-[1400px] px-6 md:px-12 lg:px-20">
    <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-[45%_1fr] lg:gap-12">
      <div>
        <h2 class="text-foreground font-serif text-4xl leading-tight uppercase lg:text-5xl">
          {t('section.about')}
        </h2>
      </div>

      <div class="text-secondary flex flex-col gap-6 text-lg leading-relaxed">
        <p class="text-pretty">
          <span class="text-foreground font-bold">{t('about.summary.name')} </span>
          {t('about.summary.body1')}
        </p>
        <p class="text-pretty">
          {t('about.summary.body2')}
        </p>
      </div>
    </div>
  </div>
</section>
