---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/home/Hero.astro';
import ProjectStack from '@/components/home/ProjectStack.astro';
import ViewScene from '@/components/home/ViewScene.astro';
import { useTranslations } from '@/i18n/utils';
import type { ui } from '@/i18n/ui';

interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Layout
  title={t('home.meta.title')}
  description={t('home.meta.description')}
  frame={t('nav.home')}
  intro
>
  {/* Orden del plan §5.2: primero los resultados (proyectos) y después "Cómo lo veo yo" */}
  <Hero lang={lang} />
  <ProjectStack lang={lang} />
  <ViewScene lang={lang} />
</Layout>
