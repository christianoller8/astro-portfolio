---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/home/Hero.astro';
import ProcessScene from '@/components/home/ProcessScene.astro';
import ProjectStack from '@/components/home/ProjectStack.astro';
import ToolsByLens from '@/components/home/ToolsByLens.astro';
import { useTranslations } from '@/i18n/utils';
import type { ui } from '@/i18n/ui';

interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Layout
  title={t('home.meta.title')}
  description={t('home.meta.description')}
  frame={t('nav.home')}
  intro
>
  <Hero lang={lang} />
  <ProcessScene lang={lang} />
  <ProjectStack lang={lang} />
  <ToolsByLens lang={lang} />
</Layout>
