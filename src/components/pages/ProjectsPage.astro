---
import Layout from '@/layouts/Layout.astro';
import ProjectVisual from '@/components/ui/ProjectVisual.astro';
import { getSortedProjects } from '@/utils/projects';
import { useTranslations, useTranslatedPath } from '@/i18n/utils';
import type { ui } from '@/i18n/ui';

interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const projects = await getSortedProjects(lang);
---

<Layout
  title={t('projects.meta.title')}
  description={t('projects.meta.description')}
  frame={t('nav.projects')}
>
  <section class="wrap page-head" data-cs="<section> ProjectsPage.astro">
    <h1 class="t-display" data-reveal data-ds="H1" data-ds-type>{t('projects.title')}</h1>
    <p class="t-lead page-lead" data-reveal style="--reveal-i: 1">{t('projects.page.lead')}</p>
  </section>

  <ol class="wrap project-list">
    {
      projects.map((project, i) => (
        <li class="project-row" data-reveal>
          <a
            class="project-visual"
            href={translatePath(`/projects/${project.slug}`)}
            tabindex="-1"
            aria-hidden="true"
          >
            <ProjectVisual project={project} lang={lang} eager={i === 0} />
          </a>
          <div class="project-info">
            <h2 class="project-title">
              <a class="link" href={translatePath(`/projects/${project.slug}`)}>
                {project.data.title}
              </a>
            </h2>
            <p class="project-kind t-small">
              {t(project.data.kind === 'app' ? 'project.kind.app' : 'project.kind.web')} ·{' '}
              {project.data.status}
            </p>
            <p class="project-desc">{project.data.description}</p>
            <ul class="project-features">
              {project.data.features.slice(0, 3).map((feature) => (
                <li>{feature}</li>
              ))}
            </ul>
            <a class="btn btn-quiet project-cta" href={translatePath(`/projects/${project.slug}`)}>
              {t('projects.view')}
              <span class="btn-arrow" aria-hidden="true">
                →
              </span>
            </a>
          </div>
        </li>
      ))
    }
  </ol>
</Layout>

<style>
  .page-head {
    padding-top: clamp(2rem, 5vw, 4.5rem);
  }
  .page-lead {
    max-width: 40ch;
    margin-top: 1.25rem;
    color: var(--muted);
  }
  .project-list {
    display: grid;
    gap: clamp(4rem, 8vw, 7rem);
    margin-top: clamp(3rem, 6vw, 5rem);
  }
  .project-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem;
  }
  .project-visual :global(.pv-clip) {
    transition: transform var(--dur-ink) var(--ease-out);
  }
  .project-visual:hover :global(.pv-clip) {
    transform: scale(0.985);
  }
  .project-title {
    font-size: var(--step-head);
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .project-kind {
    margin-top: 0.6rem;
    color: var(--muted);
  }
  .project-desc {
    max-width: 44ch;
    margin-top: 1.25rem;
  }
  .project-features {
    display: grid;
    gap: 0.4rem;
    margin-top: 1.25rem;
    color: var(--muted);
  }
  .project-features li {
    display: flex;
    gap: 0.6rem;
  }
  .project-features li::before {
    content: '';
    flex: none;
    width: 0.45rem;
    height: 0.45rem;
    margin-top: 0.55em;
    background: var(--pencil);
  }
  .project-cta {
    margin-top: 1.75rem;
  }
  @media (min-width: 1024px) {
    .project-row {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: center;
      gap: 3.5rem;
    }
    .project-row:nth-child(even) .project-visual {
      order: 2;
    }
  }
</style>
