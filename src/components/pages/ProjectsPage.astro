---
// Proyectos (plan §5.3): los cuatro proyectos como frames de un archivo de diseño, cada uno en su
// formato (escritorio o móvil) y con un hilo de prototipo hasta la nota que lleva a su caso. Para
// leer deprisa hay una vista en lista. La vista elegida se recuerda (localStorage).
import Layout from '@/layouts/Layout.astro';
import ProjectVisual from '@/components/ui/ProjectVisual.astro';
import { getSortedProjects } from '@/utils/projects';
import { useTranslations, useTranslatedPath } from '@/i18n/utils';
import type { ui } from '@/i18n/ui';

interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const projects = await getSortedProjects(lang);

// Sitio de cada frame y de su nota en el tablero, en centésimas del ancho (cqi).
// side: a qué lado del frame queda la nota (hacia ahí sale el hilo).
const spots = [
  { frame: [0, 5, 50], note: [54.5, 8, 19], side: 'right' },
  { frame: [78, 3, 22], note: [54.5, 29, 19], side: 'left' },
  { frame: [3, 50, 22], note: [29.5, 58, 18], side: 'right' },
  { frame: [52, 55, 48], note: [29.5, 76, 18], side: 'left' },
];
const items = projects.map((project, i) => {
  const spot = spots[i % spots.length];
  const mobile = project.data.format === 'mobile';
  return {
    project,
    spot,
    mobile,
    href: translatePath(`/projects/${project.slug}`),
    kind: t(project.data.kind === 'app' ? 'project.kind.app' : 'project.kind.web'),
    format: t(mobile ? 'projects.format.mobile' : 'projects.format.desktop'),
    size: mobile ? '390 × 844' : '1280 × 800',
  };
});
---

<Layout
  title={t('projects.meta.title')}
  description={t('projects.meta.description')}
  frame={t('nav.projects')}
>
  <section class="pp" data-projects data-mode="canvas" data-cs="<section> ProjectsPage.astro">
    <!-- Antes de pintar: la vista que se eligió la última vez -->
    <script is:inline>
      try {
        if (localStorage.getItem('projects-mode') === 'list') document.currentScript.parentElement.dataset.mode = 'list';
      } catch (e) {}
    </script>

    <div class="wrap pp-head">
      <div>
        <h1 class="t-display" data-reveal data-ds="H1" data-ds-type>{t('projects.title')}</h1>
        <p class="t-lead pp-lead" data-reveal style="--reveal-i: 1">{t('projects.page.lead')}</p>
      </div>
      <div class="pp-mode" role="group" aria-label={t('projects.mode.label')} data-seg data-reveal style="--reveal-i: 2">
        <button type="button" class="pp-mode-btn" data-projects-mode="canvas" aria-pressed="true">
          <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <rect x="1.5" y="2.5" width="7" height="5"></rect>
            <rect x="10.5" y="5.5" width="4" height="8"></rect>
            <rect x="2.5" y="10" width="5" height="3.5"></rect>
          </svg>
          {t('projects.mode.canvas')}
        </button>
        <button type="button" class="pp-mode-btn" data-projects-mode="list" aria-pressed="false">
          <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path d="M2 4h12M2 8h12M2 12h12"></path>
          </svg>
          {t('projects.mode.list')}
        </button>
      </div>
    </div>

    <!-- Vista de lienzo -->
    <div class="pp-canvas">
      <div class="wrap">
        <div class="board">
          {/* Hilos de prototipo: de cada frame a la nota de su caso (los dibuja kit.ts) */}
          {
            items.map(({ project }) => (
              <svg
                class="kit-thread board-thread"
                id={`pt-${project.slug}`}
                data-thread-from={`#pf-${project.slug}`}
                data-thread-to={`#pn-${project.slug}`}
                aria-hidden="true"
              />
            ))
          }
          <ol class="board-list">
          {
            items.map(({ project, spot, mobile, href, kind, format, size }, i) => (
              <li
                class="board-item"
                data-side={spot.side}
                style={`--fx:${spot.frame[0]};--fy:${spot.frame[1]};--fw:${spot.frame[2]};--nx:${spot.note[0]};--ny:${spot.note[1]};--nw:${spot.note[2]};`}
              >
                <div class:list={['board-frame', mobile && 'board-frame--mobile']}>
                  <p class="kit-frame-name board-name" aria-hidden="true">
                    {project.data.title}
                    <span>
                      {format} · {size}
                    </span>
                  </p>
                  <a
                    class="board-shot"
                    id={`pf-${project.slug}`}
                    href={href}
                    tabindex="-1"
                    aria-hidden="true"
                    data-sel
                    data-morph-visual={project.slug}
                    data-thread-hover={`#pt-${project.slug}`}
                  >
                    <ProjectVisual project={project} lang={lang} eager={i === 0} />
                  </a>
                </div>
                <div class="board-note" id={`pn-${project.slug}`}>
                  <h2 class="board-title" data-morph-title={project.slug}>
                    <a href={href} data-thread-hover={`#pt-${project.slug}`}>
                      {project.data.title}
                    </a>
                  </h2>
                  <p class="board-facts">
                    {kind} · {project.data.status}
                  </p>
                  <p class="board-desc">{project.data.description}</p>
                  <a class="board-cta" href={href} aria-label={`${t('projects.case')}: ${project.data.title}`} data-thread-hover={`#pt-${project.slug}`}>
                    {t('projects.case')} <span aria-hidden="true">→</span>
                  </a>
                </div>
              </li>
            ))
          }
          </ol>
        </div>
      </div>
    </div>

    <!-- Vista en lista -->
    <ol class="wrap plist">
      {
        items.map(({ project, href, kind, format }) => (
          <li>
            <a class="plist-row" href={href}>
              <h2 class="plist-title">{project.data.title}</h2>
              <span class="plist-desc">{project.data.description}</span>
              <span class="plist-facts">
                {[kind, format, project.data.status, project.data.role, project.data.year].filter(Boolean).join(' · ')}
              </span>
              <span class="plist-arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</Layout>

<style>
  .pp-head {
    display: grid;
    gap: 1.75rem;
    padding-top: clamp(2rem, 5vw, 4.5rem);
  }
  .pp-lead {
    max-width: 40ch;
    margin-top: 1.25rem;
    color: var(--muted);
  }

  /* Cambio de vista: el mismo control segmentado que las lentes */
  .pp-mode {
    display: inline-flex;
    justify-self: start;
    gap: 2px;
    padding: 3px;
    background: var(--tint);
  }
  .pp-mode-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.25rem;
    padding: 0 0.8rem;
    font-size: var(--step-small);
    font-weight: 600;
    color: var(--muted);
    transition:
      background-color var(--dur-micro) var(--ease-out),
      color var(--dur-micro) var(--ease-out),
      transform var(--dur-micro) var(--ease-out);
  }
  .pp-mode-btn:hover {
    color: var(--ink);
  }
  .pp-mode-btn:active {
    transform: scale(0.97);
  }
  .pp-mode-btn[aria-pressed='true'] {
    color: var(--pencil-ink);
    background: var(--pencil);
  }

  .pp[data-mode='canvas'] .plist,
  .pp[data-mode='list'] .pp-canvas {
    display: none;
  }

  /* ---------- Lienzo: una ventana al lienzo de la herramienta, de lado a lado del artboard ---------- */
  .pp-canvas {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-block: clamp(2.5rem, 5vw, 4rem);
    background-color: var(--canvas);
    background-image: radial-gradient(var(--dot) 1px, transparent 1.2px);
    background-size: 20px 20px;
  }
  /* En la vista de lienzo el pie (tinta) va pegado a la franja, sin papel entre medias */
  :global(main:has(.pp[data-mode='canvas']) .artboard-back) {
    margin-top: 0;
  }
  .board-list {
    display: grid;
    gap: 3.5rem;
  }
  .board-item {
    display: grid;
    gap: 1.25rem;
  }
  .board-name {
    margin-bottom: 0.5rem;
  }
  .board-shot {
    display: block;
    background: var(--paper);
  }
  /* Al señalar el frame, lo de dentro se acerca un 2 % (plan §4.4) */
  .board-shot :global(.pv-clip > *) {
    transition: scale var(--dur-ui) var(--spring);
  }
  .board-shot:hover :global(.pv-clip > *) {
    scale: 1.02;
  }
  .board-frame--mobile .board-shot {
    width: min(100%, 20rem);
  }
  .board-frame--mobile :global(.pv-clip) {
    aspect-ratio: auto;
  }
  .board-thread {
    display: none;
  }
  .board-title {
    font-size: var(--step-head);
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .board-title a {
    text-decoration: none;
  }
  .board-facts {
    margin-top: 0.5rem;
    font: 600 0.8125rem/1.4 var(--font-sans);
    color: var(--muted);
  }
  .board-desc {
    max-width: 44ch;
    margin-top: 0.75rem;
    line-height: 1.4;
  }
  .board-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 1.75rem;
    margin-top: 0.75rem;
    font-size: var(--step-small);
    font-weight: 600;
  }
  .board-cta span {
    transition: transform var(--dur-micro) var(--ease-out);
  }
  .board-cta:hover span {
    transform: translateX(4px);
  }

  /* A partir de tablet ancha: tablero libre. Cada pieza va a su sitio y todo escala con el ancho. */
  @media (min-width: 900px) {
    .pp-head {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }
    .board-list {
      display: contents;
    }
    .board {
      position: relative;
      container-type: inline-size;
      height: 0;
      /* Alto del tablero: 96 centésimas de su ancho */
      padding-bottom: 96%;
    }
    .board-item {
      display: contents;
    }
    .board-frame,
    .board-note {
      position: absolute;
      z-index: 1;
    }
    .board-frame {
      top: calc(var(--fy) * 1cqi);
      left: calc(var(--fx) * 1%);
      width: calc(var(--fw) * 1%);
    }
    .board-note {
      top: calc(var(--ny) * 1cqi);
      left: calc(var(--nx) * 1%);
      width: calc(var(--nw) * 1%);
    }
    /* La nota que queda a la izquierda de su frame se alinea hacia él */
    .board-item[data-side='left'] .board-note {
      text-align: right;
    }
    .board-item[data-side='left'] .board-desc {
      margin-left: auto;
    }
    .board-name {
      position: absolute;
      bottom: 100%;
      left: 0;
      white-space: nowrap;
    }
    /* Los frames, a su formato; la interfaz de dentro escala con el tablero */
    .board-shot {
      aspect-ratio: 16 / 10;
    }
    .board-frame--mobile .board-shot {
      width: auto;
      aspect-ratio: 11 / 20;
    }
    /* El tamaño de la interfaz va en centésimas del tablero (gana a los tamaños de ProjectVisual) */
    .board .board-shot :global(.pv .pv-clip) {
      --ui-size: 0.98cqi;
    }
    .board .board-frame--mobile .board-shot :global(.pv .pv-clip) {
      --ui-size: 0.8cqi;
    }
    .board-shot :global(.pv),
    .board-shot :global(.pv-clip) {
      height: 100%;
      aspect-ratio: auto;
    }
    /* En el marco de móvil la app ocupa la pantalla entera, con su contenido arriba */
    .board .board-frame--mobile .board-shot :global(.pv .pv-clip > *) {
      align-self: stretch;
      max-width: none;
      height: 100%;
    }
    .board-thread {
      display: block;
    }
    .board-title {
      font-size: clamp(1.5rem, 2.7cqi, 2.25rem);
    }
    /* Con el tablero estrecho las notas se quedan en nombre, tipo y enlace: la frase no cabe */
    @container (max-width: 1100px) {
      .board-desc {
        display: none;
      }
    }
  }

  /* ---------- Lista: una línea por proyecto ---------- */
  .plist {
    display: grid;
    gap: 3px;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .plist-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.5rem 1rem;
    padding: 1.1rem 1.1rem 1.2rem;
    background: var(--tint);
    transition:
      background-color var(--dur-micro) var(--ease-out),
      color var(--dur-micro) var(--ease-out);
  }
  .plist-facts {
    font: 600 0.8125rem/1.4 var(--font-sans);
    color: var(--muted);
  }
  .plist-title {
    font-size: clamp(1.75rem, 3.6vw, 2.75rem);
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .plist-desc,
  .plist-facts {
    grid-column: 1 / -1;
  }
  .plist-desc {
    max-width: 56ch;
  }
  .plist-arrow {
    grid-area: 1 / 2;
    font-size: 1.25rem;
    transition: transform var(--dur-micro) var(--ease-out);
  }
  .plist-row:hover,
  .plist-row:focus-visible {
    color: var(--paper);
    background: var(--ink);
  }
  .plist-row:hover .plist-facts,
  .plist-row:focus-visible .plist-facts {
    color: color-mix(in srgb, var(--paper) 76%, var(--ink));
  }
  .plist-row:hover .plist-arrow {
    transform: translateX(4px);
  }
  @media (min-width: 900px) {
    .plist-row {
      grid-template-columns: minmax(0, 4fr) minmax(0, 6fr) auto;
      gap: 0.35rem 1.5rem;
      padding: 1.25rem 1.5rem 1.35rem;
    }
    .plist-desc {
      grid-area: 1 / 2;
    }
    .plist-facts {
      grid-area: 2 / 2;
    }
    .plist-arrow {
      grid-area: 1 / 3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pp-mode-btn,
    .plist-row,
    .plist-arrow,
    .board-cta span {
      transition: none;
    }
  }
</style>

<script>
  import { drawThread, playThread } from '@/scripts/kit';

  // Cambio de vista (se recuerda) y el hilo de cada proyecto, que se vuelve a dibujar al señalarlo
  document.addEventListener('click', (event) => {
    const btn = (event.target as Element | null)?.closest<HTMLElement>('[data-projects-mode]');
    const section = btn?.closest<HTMLElement>('[data-projects]');
    if (!btn || !section) return;
    const mode = btn.dataset.projectsMode === 'list' ? 'list' : 'canvas';
    section.dataset.mode = mode;
    sync(section);
    try {
      localStorage.setItem('projects-mode', mode);
    } catch {
      /* sin almacenamiento: la vista vale solo para esta página */
    }
    if (mode === 'canvas') redraw(section);
  });

  function sync(section: HTMLElement) {
    section.querySelectorAll<HTMLElement>('[data-projects-mode]').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(btn.dataset.projectsMode === section.dataset.mode));
    });
  }
  /** Los hilos se miden con el tablero a la vista: al volver de la lista hay que repetirlos */
  function redraw(section: HTMLElement) {
    section.querySelectorAll<SVGSVGElement>('svg[data-thread-from]').forEach((svg) => {
      const from = document.querySelector(svg.dataset.threadFrom ?? '');
      const to = document.querySelector(svg.dataset.threadTo ?? '');
      if (from && to) drawThread(svg, from, to);
    });
  }

  for (const type of ['pointerover', 'focusin'] as const) {
    document.addEventListener(type, (event) => {
      const el = (event.target as Element | null)?.closest?.<HTMLElement>('[data-thread-hover]');
      if (!el || (event instanceof PointerEvent && el.contains(event.relatedTarget as Node | null))) return;
      const svg = document.querySelector<SVGSVGElement>(el.dataset.threadHover ?? '');
      if (svg && svg.clientWidth) playThread(svg);
    });
  }

  document.addEventListener('astro:page-load', () => {
    const section = document.querySelector<HTMLElement>('[data-projects]');
    if (!section) return;
    try {
      if (localStorage.getItem('projects-mode') === 'list') section.dataset.mode = 'list';
    } catch {
      /* sin almacenamiento */
    }
    sync(section);
    // Las fuentes cambian el alto de las notas: los hilos se repiten cuando han cargado
    document.fonts?.ready.then(() => redraw(section));
  });
</script>
