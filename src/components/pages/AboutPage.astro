---
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import ToolsByLens from '@/components/home/ToolsByLens.astro';
import profileImage from '@/assets/images/profile.jpg';
import { useTranslations } from '@/i18n/utils';
import { site, hasCV } from '@/data/site';
import type { ui } from '@/i18n/ui';

interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const principles = [
  { title: t('about.principle1.title'), body: t('about.principle1.body') },
  { title: t('about.principle2.title'), body: t('about.principle2.body') },
  { title: t('about.principle3.title'), body: t('about.principle3.body') },
];
---

<Layout
  title={t('about.meta.title')}
  description={t('about.meta.description')}
  frame={t('nav.about')}
>
  <section class="wrap about" data-cs="<section> AboutPage.astro">
    <h1 class="t-display about-title" data-reveal data-ds="H1" data-ds-type>{t('about.title')}</h1>

    <div class="about-grid">
      <div
        class="about-photo"
        data-ds={lang === 'es' ? 'Retrato' : 'Portrait'}
        data-qa-host
        data-reveal
      >
        <div class="about-photo-clip">
          <Image
            src={profileImage}
            alt={t('hero.portrait.alt')}
            widths={[480, 800]}
            sizes="(min-width: 1024px) 36vw, 100vw"
            loading="eager"
            class="about-photo-img"
          />
        </div>
      </div>
      <div class="about-text">
        <p class="t-lead" data-reveal style="--reveal-i: 1">{t('about.p1')}</p>
        <p data-reveal style="--reveal-i: 2">{t('about.p2')}</p>
        <p data-reveal style="--reveal-i: 3">{t('about.p3')}</p>
      </div>
    </div>
  </section>

  <section class="wrap principles" data-cs="<section> Principles">
    <h2 class="t-head" data-reveal>{t('about.principles.title')}</h2>
    <div class="principles-grid">
      {
        principles.map((item, i) => (
          <div class="principle" data-reveal style={`--reveal-i: ${i + 1}`}>
            <h3 class="principle-title">{item.title}</h3>
            <p class="principle-body">{item.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <ToolsByLens lang={lang} />

  <section class="wrap cv" data-cs="<section> CV">
    <h2 class="t-head" data-reveal>{t('about.cv.title')}</h2>
    {
      hasCV ? (
        <a class="btn btn-primary cv-btn" href={site.cv} download data-reveal>
          {t('hero.cta.cv')}
          <span class="btn-arrow" aria-hidden="true">
            ↓
          </span>
        </a>
      ) : (
        <p class="t-lead cv-pending" data-reveal>
          {t('about.cv.pending')}
        </p>
      )
    }
  </section>
</Layout>

<style>
  .about {
    padding-top: clamp(2rem, 5vw, 4.5rem);
  }
  .about-title {
    max-width: 100%;
  }
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }
  .about-photo {
    max-width: 32rem;
  }
  .about-photo-clip {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--tint);
  }
  .about-photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .about-text {
    display: grid;
    align-content: start;
    gap: 1.25rem;
    max-width: 40rem;
  }
  .principles,
  .cv {
    padding-top: clamp(5rem, 10vw, 9rem);
  }
  .principles-grid {
    display: grid;
    gap: 2rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .principle {
    padding: 1.5rem;
    background: var(--tint);
  }
  .principle-title {
    font-size: var(--step-lead);
    font-weight: 650;
    letter-spacing: -0.015em;
  }
  .principle-body {
    margin-top: 0.6rem;
  }
  .cv-btn {
    margin-top: 1.75rem;
  }
  .cv-pending {
    margin-top: 1rem;
    color: var(--muted);
  }
  @media (min-width: 768px) {
    .principles-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .about-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 4rem;
    }
  }
</style>
