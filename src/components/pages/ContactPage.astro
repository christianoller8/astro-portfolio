---
import Layout from '@/layouts/Layout.astro';
import { useTranslations } from '@/i18n/utils';
import type { ui } from '@/i18n/ui';

interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Layout title={t('contact.meta.title')} description={t('contact.meta.description')}>
  <section class="mx-auto w-full max-w-[1400px] px-6 py-12 md:px-12 md:py-24 lg:px-20">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-[5fr_7fr] lg:gap-24">
      <div class="space-y-8">
        <div class="space-y-4">
          <h1 class="font-serif text-4xl leading-tight font-bold md:text-5xl lg:text-6xl">
            {t('contact.heading')}
          </h1>
          <p class="text-secondary max-w-md text-lg text-pretty">
            {t('contact.intro')}
          </p>
        </div>

        <div class="space-y-6 pt-8">
          <div class="space-y-2">
            <h3 class="text-primary text-sm font-bold tracking-wide uppercase">
              {t('contact.label.email')}
            </h3>
            <a
              href="mailto:contacto@christianoller.com"
              class="text-secondary hover:text-primary text-xl transition-colors md:text-2xl"
            >
              contacto@christianoller.com
            </a>
          </div>

          <div class="space-y-2">
            <h3 class="text-primary text-sm font-bold tracking-wide uppercase">
              {t('contact.label.social')}
            </h3>
            <ul class="text-secondary flex flex-col gap-2 text-lg">
              <li>
                <a
                  href="https://github.com/christianoller8"
                  target="_blank"
                  rel="noreferrer"
                  class="hover:text-primary transition-colors"
                >
                  GitHub
                </a>
              </li>
              <li>
                <a
                  href="https://www.linkedin.com/in/christian-oller"
                  target="_blank"
                  rel="noreferrer"
                  class="hover:text-primary transition-colors"
                >
                  LinkedIn
                </a>
              </li>
            </ul>
          </div>

          <div class="space-y-2">
            <h3 class="text-primary text-sm font-bold tracking-wide uppercase">
              {t('contact.label.location')}
            </h3>
            <p class="text-secondary text-lg">{t('contact.location.value')}</p>
          </div>
        </div>
      </div>

      <div class="bg-surface border-border/50 rounded-2xl border p-8 transition-colors md:p-12">
        {/* Replace YOUR_FORM_ID at formspree.io/forms after creating your account */}
        <form class="space-y-6" method="POST" action="https://formspree.io/f/YOUR_FORM_ID">
          <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
            <label class="flex flex-col gap-2">
              <span class="text-primary text-sm font-medium">{t('contact.form.name')}</span>
              <input
                type="text"
                name="name"
                required
                placeholder={t('contact.form.name.placeholder')}
                class="bg-background border-border focus:border-primary focus:ring-primary placeholder:text-muted-foreground/50 h-12 w-full rounded-lg border px-4 transition-all outline-none focus:ring-1 dark:border-neutral-700 dark:bg-neutral-800/50 dark:placeholder:text-neutral-500"
              />
            </label>

            <label class="flex flex-col gap-2">
              <span class="text-primary text-sm font-medium">{t('contact.form.email')}</span>
              <input
                type="email"
                name="email"
                required
                placeholder={t('contact.form.email.placeholder')}
                class="bg-background border-border focus:border-primary focus:ring-primary placeholder:text-muted-foreground/50 h-12 w-full rounded-lg border px-4 transition-all outline-none focus:ring-1 dark:border-neutral-700 dark:bg-neutral-800/50 dark:placeholder:text-neutral-500"
              />
            </label>
          </div>

          <label class="flex flex-col gap-2">
            <span class="text-primary text-sm font-medium">{t('contact.form.subject')}</span>
            <select
              name="subject"
              class="bg-background border-border focus:border-primary focus:ring-primary text-secondary h-12 w-full rounded-lg border px-4 transition-all outline-none focus:ring-1 dark:border-neutral-700 dark:bg-neutral-800/50"
            >
              <option value="" disabled selected>{t('contact.form.subject.placeholder')}</option>
              <option value="ui-ux">{t('contact.form.subject.uiux')}</option>
              <option value="branding">{t('contact.form.subject.branding')}</option>
              <option value="development">{t('contact.form.subject.dev')}</option>
              <option value="other">{t('contact.form.subject.other')}</option>
            </select>
          </label>

          <label class="flex flex-col gap-2">
            <span class="text-primary text-sm font-medium">{t('contact.form.message')}</span>
            <textarea
              name="message"
              rows="6"
              required
              placeholder={t('contact.form.message.placeholder')}
              class="bg-background border-border focus:border-primary focus:ring-primary placeholder:text-muted-foreground/50 min-h-[150px] w-full resize-y rounded-lg border p-4 transition-all outline-none focus:ring-1 dark:border-neutral-700 dark:bg-neutral-800/50 dark:placeholder:text-neutral-500"
            ></textarea>
          </label>

          <div class="pt-4">
            <button
              type="submit"
              class="bg-primary text-background hover:bg-secondary/90 h-12 w-full rounded-lg px-8 font-medium shadow-lg transition-all duration-300 hover:shadow-xl md:w-auto"
            >
              {t('contact.form.submit')}
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>
</Layout>
