---
import Layout from '@/layouts/Layout.astro';
import { useTranslations } from '@/i18n/utils';
import { site } from '@/data/site';
import type { ui } from '@/i18n/ui';

interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Los cuatro estados del componente, dibujados al lado del formulario
const states = [
  { id: 'empty', label: t('contact.state.empty') },
  { id: 'typing', label: t('contact.state.typing') },
  { id: 'valid', label: t('contact.state.valid') },
  { id: 'sent', label: t('contact.state.sent') },
];

const topics = [
  { value: 'job', label: t('contact.topic.job') },
  { value: 'freelance', label: t('contact.topic.freelance') },
  { value: 'other', label: t('contact.topic.other') },
];
---

<Layout
  title={t('contact.meta.title')}
  description={t('contact.meta.description')}
  frame={t('nav.contact')}
>
  <!-- La frase y los datos -->
  <section class="wrap contact" data-cs="<section> ContactPage.astro">
    <h1 class="t-display" data-reveal data-ds="H1" data-ds-type>{t('contact.title')}</h1>
    <div class="contact-top">
      <p class="contact-lead" data-reveal style="--reveal-i: 1">{t('contact.lead')}</p>
      <ul class="data" data-reveal style="--reveal-i: 2">
        <li class="data-row">
          <span class="data-label">Email</span>
          <a class="data-value" href={`mailto:${site.email}`}>{site.email}</a>
          <button type="button" class="data-action" data-copy={site.email} data-copied={t('footer.copied')} data-failed={t('footer.copyFailed')}>
            {t('footer.copy')}
          </button>
        </li>
        <li class="data-row">
          <span class="data-label">LinkedIn</span>
          <a class="data-value" href={site.linkedin} target="_blank" rel="noreferrer">christian-oller</a>
          <span class="data-arrow" aria-hidden="true">↗</span>
        </li>
        <li class="data-row">
          <span class="data-label">GitHub</span>
          <a class="data-value" href={site.github} target="_blank" rel="noreferrer">christianoller8</a>
          <span class="data-arrow" aria-hidden="true">↗</span>
        </li>
        <li class="data-row">
          <span class="data-label">{t('contact.data.status')}</span>
          <span class="data-value data-value--status">
            <span class="status-dot" aria-hidden="true"></span>{t('hero.status')}
          </span>
        </li>
      </ul>
    </div>
  </section>

  <!-- El formulario, como un componente dentro de su frame, con sus cuatro estados dibujados -->
  <section class="form-band" data-form-band data-form-state="empty" data-cs="<section> ContactForm">
    <div class="wrap form-grid">
      <div class="form-frame" data-reveal>
        <p class="kit-frame-name form-name" aria-hidden="true">
          {t('contact.frame')}
          <span data-form-state-name>{states[0].label}</span>
        </p>
      <form
        class="form"
        data-contact-form
        data-endpoint={site.formEndpoint}
        data-email={site.email}
        data-subject={t('contact.mailto.subject')}
        data-ds={lang === 'es' ? 'Formulario' : 'Form'}
        novalidate
      >
        <div class="form-fields" data-form-fields>
        <p class="req-note t-small"><span aria-hidden="true">*</span> {t('contact.required')}</p>
        <fieldset class="topics">
          <legend class="field-label">{t('contact.topic')}</legend>
          <div class="topic-row">
            {
              topics.map((topic, i) => (
                <label class="topic">
                  <input type="radio" name="topic" value={topic.label} checked={i === 0} />
                  <span>{topic.label}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <div class="field-row">
          <div class="field" data-qa-host>
            <label class="field-label" for="c-name">{t('contact.name')}<span class="req" aria-hidden="true">*</span></label>
            <input id="c-name" name="name" autocomplete="name" required />
            <p class="field-error t-small" id="c-name-err" hidden><span class="err-mark" aria-hidden="true">!</span>{t('contact.err.name')}</p>
          </div>
          <div class="field" data-qa-host>
            <label class="field-label" for="c-email">{t('contact.email')}<span class="req" aria-hidden="true">*</span></label>
            <input id="c-email" name="email" type="email" autocomplete="email" required />
            <p class="field-error t-small" id="c-email-err" hidden><span class="err-mark" aria-hidden="true">!</span>{t('contact.err.email')}</p>
          </div>
        </div>
        <div class="field" data-qa-host>
          <label class="field-label" for="c-company">{t('contact.company')}</label>
          <input id="c-company" name="company" autocomplete="organization" />
        </div>
        <div class="field" data-qa-host>
          <label class="field-label" for="c-message">{t('contact.message')}<span class="req" aria-hidden="true">*</span></label>
          <textarea id="c-message" name="message" rows="6" required aria-describedby="c-checks"
          ></textarea>
          <p class="field-error t-small" id="c-message-err" hidden><span class="err-mark" aria-hidden="true">!</span>{t('contact.err.message')}</p>
        </div>

        <ul id="c-checks" class="checks" aria-live="polite">
          <li data-check="name">
            <svg class="chk" viewBox="0 0 16 16" aria-hidden="true"
              ><path d="m4 8.5 2.6 2.6L12 5.5"></path></svg
            >{t('contact.check.name')}
          </li>
          <li data-check="email">
            <svg class="chk" viewBox="0 0 16 16" aria-hidden="true"
              ><path d="m4 8.5 2.6 2.6L12 5.5"></path></svg
            >{t('contact.check.email')}
          </li>
          <li data-check="message">
            <svg class="chk" viewBox="0 0 16 16" aria-hidden="true"
              ><path d="m4 8.5 2.6 2.6L12 5.5"></path></svg
            >{t('contact.check.message')}
          </li>
        </ul>

        {/* Resumen de los errores: se rellena al enviar con datos inválidos y se anuncia solo (role=alert) */}
        <div class="form-alert t-small" role="alert" data-alert></div>

        <div class="submit-row">
          <button class="btn btn-primary send" type="submit" data-send>
            <span data-send-label>{t('contact.send')}</span>
            <span class="btn-arrow" aria-hidden="true">→</span>
          </button>
          {/* El mensaje (región de estado) y, a su lado y fuera de ella, el botón Copiar del aviso: así
              cambiar su texto no se anuncia dos veces */}
          <div class="send-feedback">
          <p class="t-small send-state" data-state role="status"></p>
          <button type="button" class="data-action send-copy" data-fallback-copy data-copy={site.email} data-copied={t('footer.copied')} data-failed={t('footer.copyFailed')} hidden>
            {t('footer.copy')}
          </button>
          </div>
        </div>
        </div>

        {/* Estado "enviado": sustituye a los campos */}
        <div class="form-sent" data-form-sent hidden>
          <span class="form-sent-mark" aria-hidden="true"></span>
          <p class="form-sent-title" tabindex="-1" data-form-sent-title>{t('contact.sent.title')}</p>
          <p class="form-sent-body">{t('contact.sent.body')}</p>
          <button type="button" class="btn btn-quiet" data-form-again>{t('contact.again')}</button>
        </div>
        <p
          hidden
          data-messages={JSON.stringify({
            ready: t('contact.ready'),
            sending: t('contact.sending'),
            sent: t('contact.sent'),
            error: t('contact.error'),
            fallback: t('contact.fallback'),
            summary: t('contact.err.summary'),
            labels: { name: t('contact.name'), email: t('contact.email'), message: t('contact.message') },
          })}
        >
        </p>
      </form>
      </div>

      <div class="states" data-reveal style="--reveal-i: 1" aria-hidden="true">
        <p class="states-title">{t('contact.states')}</p>
        <ol class="states-list">
          {
            states.map((state) => (
              <li class="state" data-state-thumb={state.id} data-label={state.label}>
                <div class="state-shot">
                  {state.id === 'sent' ? (
                    <>
                      <i class="s-mark" />
                      <i class="s-line s-line--wide" />
                      <i class="s-line" />
                    </>
                  ) : (
                    <>
                      <i class="s-field" />
                      <i class="s-field" />
                      <i class="s-field s-field--tall" />
                      <i class="s-btn" />
                    </>
                  )}
                </div>
                <p class="state-name">
                  {state.label}
                  <span class="state-now">{t('contact.state.now')}</span>
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---------- La frase y los datos ---------- */
  .contact {
    padding-top: clamp(1.5rem, 4vw, 3.5rem);
  }
  /* El H1 va en la escala (.t-display), como el de las demás páginas */
  .contact-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }
  .contact-lead {
    max-width: 22ch;
    /* Un párrafo, no un titular: hasta 36 px */
    font-size: var(--step-title);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .data {
    display: grid;
    gap: 3px;
  }
  .data-row {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    min-height: 3.75rem;
    padding: 0.6rem 1rem;
    background: var(--tint);
  }
  .data-label {
    font: 600 var(--step-small)/1.3 var(--font-sans);
    color: var(--muted);
  }
  .data-value {
    overflow: hidden;
    font-size: var(--step-lead);
    font-weight: 600;
    letter-spacing: -0.015em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  a.data-value {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--dur-micro) var(--ease-out);
  }
  a.data-value:hover {
    text-decoration-color: currentColor;
  }
  .data-value--status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    white-space: normal;
  }
  .data-action {
    min-width: 4.75rem;
    min-height: 2rem;
    padding: 0 0.7rem;
    font: 600 var(--step-small)/1 var(--font-sans);
    color: var(--paper);
    background: var(--ink);
    transition: opacity var(--dur-micro) var(--ease-out);
  }
  .data-action:hover {
    opacity: 0.85;
  }
  .data-arrow {
    font-size: var(--step-lead);
    color: var(--muted);
  }
  .status-dot {
    flex: none;
    width: 0.55rem;
    height: 0.55rem;
    background: var(--ok);
    border-radius: 50%;
  }

  /* ---------- El formulario en su frame, sobre el lienzo ---------- */
  .form-band {
    margin-top: clamp(4rem, 8vw, 7rem);
    padding-block: clamp(3rem, 6vw, 5rem);
    background-color: var(--canvas);
    background-image: radial-gradient(var(--dot) 1px, transparent 1.2px);
    background-size: 20px 20px;
  }
  /* El pie (tinta) va pegado a la franja del lienzo */
  :global(main:has(.form-band) .artboard-back) {
    margin-top: 0;
  }
  .form-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
  }
  /* El formulario, en el centro de la franja (pedido por Christian el 20 nov) */
  .form-frame {
    width: 100%;
    max-width: 46rem;
    margin-inline: auto;
  }
  /* OCULTO (20 nov), no borrado: el panel con los cuatro estados del componente (vacío,
     escribiendo, válido y enviado) que iba a la derecha del formulario. A Christian no le gusta.
     Sigue en la página porque el guion lee de él el nombre del estado que enseña el rótulo del
     formulario; para recuperarlo, quitar esta regla y devolver a .form-grid sus dos columnas
     (8fr y 3fr) a partir de 1024 px */
  .form-grid .states {
    display: none;
  }
  .form-name {
    margin-bottom: 0.5rem;
  }
  .form {
    display: grid;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    background: var(--paper);
  }
  .form-fields {
    display: grid;
    gap: 1.25rem;
  }
  .field-row {
    display: grid;
    gap: 1.25rem;
  }
  .field {
    display: grid;
    gap: 0.4rem;
  }
  .field-label {
    font-size: var(--step-small);
    font-weight: 600;
  }
  .field input,
  .field textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 0.9rem;
    font: inherit;
    color: var(--ink);
    background: var(--paper);
    /* --field-line: un gris que llega a 3:1 contra el papel en los dos temas (WCAG 1.4.11);
       --line, más suave, queda para los separadores */
    border: 1px solid var(--field-line);
    transition: border-color var(--dur-micro) var(--ease-out);
  }
  .field textarea {
    resize: vertical;
  }
  .field input:focus,
  .field textarea:focus {
    border-color: var(--pencil);
    outline: 2px solid var(--pencil);
    outline-offset: 2px;
  }
  .req {
    margin-left: 0.2em;
  }
  .req-note {
    color: var(--muted);
  }
  /* Error por campo: borde grueso en --fail (con el mismo tamaño total que el normal) y un texto con
     marca, para que no dependa solo del color */
  .field input[aria-invalid='true'],
  .field textarea[aria-invalid='true'] {
    padding: calc(0.75rem - 1px) calc(0.9rem - 1px);
    border: 2px solid var(--fail);
  }
  .field-error {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    color: var(--fail);
    font-weight: 600;
  }
  .field-error[hidden] {
    display: none;
  }
  .err-mark {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 1.1rem;
    height: 1.1rem;
    font-size: 0.75rem;
    line-height: 1;
    color: var(--on-fail);
    background: var(--fail);
  }
  .form-alert {
    padding: 0.7rem 0.9rem;
    font-weight: 600;
    color: var(--on-fail);
    background: var(--fail);
  }
  .form-alert:empty {
    display: none;
  }
  /* El mensaje y el botón Copiar fluyen en línea: el botón va detrás del correo y envuelve con el texto */
  .send-feedback .send-state {
    display: inline;
  }
  .send-copy[hidden] {
    display: none;
  }
  .send-feedback .send-copy {
    margin-left: 0.5rem;
    vertical-align: middle;
  }
  .topics {
    display: grid;
    gap: 0.6rem;
  }
  .topic-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .topic {
    position: relative;
  }
  .topic input {
    position: absolute;
    opacity: 0;
    inset: 0;
  }
  .topic span {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1rem;
    font-size: var(--step-small);
    font-weight: 600;
    color: var(--ink);
    background: var(--paper);
    cursor: pointer;
    transition:
      background-color var(--dur-micro) var(--ease-out),
      color var(--dur-micro) var(--ease-out);
  }
  .topic input:checked + span {
    color: var(--pencil-ink);
    background: var(--pencil);
  }
  .topic input:focus-visible + span {
    outline: 2px solid var(--pencil);
    outline-offset: 3px;
  }
  .checks {
    display: grid;
    gap: 0.35rem;
    font-size: var(--step-small);
    color: var(--muted);
  }
  .checks li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    transition: color var(--dur-micro) var(--ease-out);
  }
  .chk {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: transparent;
    stroke-width: 2;
    background: var(--paper);
    transition:
      background-color var(--dur-micro) var(--ease-out),
      stroke var(--dur-micro) var(--ease-out);
  }
  .checks li.is-ok {
    color: var(--ink);
  }
  .checks li.is-ok .chk {
    stroke: var(--on-ok);
    background: var(--ok);
  }
  .submit-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }
  .send {
    position: relative;
  }
  .send.is-ready {
    animation: halo 1.6s var(--ease-out) infinite;
  }
  @keyframes halo {
    0% {
      box-shadow: 0 0 0 0 var(--pencil-soft);
    }
    70%,
    100% {
      box-shadow: 0 0 0 12px transparent;
    }
  }
  .send-state {
    color: var(--muted);
  }
  /* Un campo con contenido válido lo dice en su borde */
  .field input:not(:placeholder-shown):valid,
  .field textarea.is-ok {
    border-color: var(--ink);
  }

  /* Estado "enviado" */
  .form-sent {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
    min-height: 22rem;
    align-content: center;
  }
  .form-sent[hidden] {
    display: none;
  }
  .form-sent-mark {
    width: 3.25rem;
    height: 3.25rem;
    background: var(--ok);
    -webkit-mask: var(--kit-check) center / contain no-repeat;
    mask: var(--kit-check) center / contain no-repeat;
    animation: sent-in 420ms var(--spring) both;
  }
  .form-sent-title {
    font-size: var(--step-head);
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.04em;
    outline: none;
  }
  .form-sent-body {
    margin-bottom: 0.75rem;
    font-size: var(--step-lead);
    color: var(--muted);
  }
  @keyframes sent-in {
    from {
      opacity: 0;
      scale: 0.6;
    }
  }

  /* ---------- Los cuatro estados, dibujados ---------- */
  .states-title {
    font: 600 var(--step-small)/1.3 var(--font-sans);
    color: var(--muted);
  }
  .states-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 1rem;
    margin-top: 1rem;
  }
  .state-shot {
    position: relative;
    display: grid;
    align-content: start;
    gap: 6%;
    aspect-ratio: 4 / 3;
    padding: 9%;
    background: var(--paper);
    outline: 1px solid transparent;
    transition: outline-color var(--dur-micro) var(--ease-out);
  }
  .state-shot i {
    display: block;
  }
  .s-field {
    height: 16%;
    min-height: 0.8rem;
    border: 1px solid var(--line);
    background: linear-gradient(var(--ink), var(--ink)) 8% 50% / 0 3px no-repeat;
  }
  .s-field--tall {
    height: 30%;
    background-position: 8% 30%;
  }
  .s-btn {
    width: 38%;
    height: 14%;
    min-height: 0.7rem;
    background: var(--line);
  }
  /* escribiendo: el primer campo con texto y el segundo con el foco y el cursor */
  [data-state-thumb='typing'] .s-field:nth-child(1) {
    border-color: var(--ink);
    background-size: 42% 3px;
  }
  [data-state-thumb='typing'] .s-field:nth-child(2) {
    border-color: var(--ink);
    background: linear-gradient(var(--ink), var(--ink)) 8% 50% / 2px 60% no-repeat;
  }
  /* válido: todo escrito y el botón, en tinta */
  [data-state-thumb='valid'] .s-field {
    border-color: var(--ink);
    background-size: 46% 3px;
  }
  [data-state-thumb='valid'] .s-field:nth-child(2) {
    background-size: 62% 3px;
  }
  [data-state-thumb='valid'] .s-field--tall {
    background:
      linear-gradient(var(--ink), var(--ink)) 8% 26% / 74% 3px no-repeat,
      linear-gradient(var(--ink), var(--ink)) 8% 58% / 52% 3px no-repeat;
  }
  [data-state-thumb='valid'] .s-btn {
    background: var(--ink);
  }
  /* enviado */
  [data-state-thumb='sent'] .state-shot {
    align-content: center;
  }
  .s-mark {
    width: 22%;
    aspect-ratio: 1;
    background: var(--ok);
    -webkit-mask: var(--kit-check) center / contain no-repeat;
    mask: var(--kit-check) center / contain no-repeat;
  }
  .s-line {
    width: 40%;
    height: 3px;
    background: var(--line);
  }
  .s-line--wide {
    width: 66%;
    height: 6px;
    background: var(--ink);
  }
  .state-name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-size: var(--step-small);
    font-weight: 600;
    color: var(--muted);
  }
  .state-now {
    display: none;
    padding: 0.05rem 0.4rem;
    font: 600 var(--step-small)/1.4 var(--font-sans);
    color: var(--paper);
    background: var(--ink);
  }
  /* El estado en el que está ahora el formulario: seleccionado, como en la herramienta */
  .form-band[data-form-state='empty'] [data-state-thumb='empty'] .state-shot,
  .form-band[data-form-state='typing'] [data-state-thumb='typing'] .state-shot,
  .form-band[data-form-state='valid'] [data-state-thumb='valid'] .state-shot,
  .form-band[data-form-state='sent'] [data-state-thumb='sent'] .state-shot {
    outline-color: var(--ink);
    background-image: var(--kit-handles);
  }
  .form-band[data-form-state='empty'] [data-state-thumb='empty'] .state-name,
  .form-band[data-form-state='typing'] [data-state-thumb='typing'] .state-name,
  .form-band[data-form-state='valid'] [data-state-thumb='valid'] .state-name,
  .form-band[data-form-state='sent'] [data-state-thumb='sent'] .state-name {
    color: var(--ink);
  }
  .form-band[data-form-state='empty'] [data-state-thumb='empty'] .state-now,
  .form-band[data-form-state='typing'] [data-state-thumb='typing'] .state-now,
  .form-band[data-form-state='valid'] [data-state-thumb='valid'] .state-now,
  .form-band[data-form-state='sent'] [data-state-thumb='sent'] .state-now {
    display: inline-block;
  }

  /* En móvil cada dato va en dos líneas: la etiqueta (y su acción) arriba y el valor, entero, debajo */
  @media (max-width: 639px) {
    .data-row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.35rem 1rem;
      padding-block: 0.8rem;
    }
    .data-value {
      grid-area: 2 / 1 / 3 / 3;
      font-size: var(--step-body);
    }
  }
  @media (min-width: 640px) {
    .field-row {
      grid-template-columns: 1fr 1fr;
    }
    .states-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .contact-top {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: end;
      gap: 3rem;
    }
    /* (Con los cuatro estados a la vista, la rejilla era 8fr + 3fr: el formulario y, a su derecha,
       los estados. Ahora el formulario va solo y centrado: ver .form-frame más abajo) */
    .states {
      position: sticky;
      top: calc(var(--toolbar-h) + 2rem);
      padding-top: 1.7rem;
    }
    .states-list {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
    .state-shot {
      aspect-ratio: 16 / 9;
      padding: 6% 8%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .send.is-ready,
    .form-sent-mark {
      animation: none;
    }
  }
</style>

<script>
  // Formulario con sus comprobaciones a la vista: cada regla se enciende al cumplirse y el estado
  // del componente (vacío, escribiendo, válido, enviado) se marca en los dibujos de al lado.
  // Sin endpoint configurado (PUBLIC_FORM_ENDPOINT) abre el correo con el mensaje ya escrito.
  // Para ver un estado sin escribir: ?estado=vacio | escribiendo | valido | enviado
  document.addEventListener('astro:page-load', () => {
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    const band = form?.closest<HTMLElement>('[data-form-band]');
    if (!form || !band) return;
    const messages = JSON.parse(form.querySelector<HTMLElement>('[data-messages]')?.dataset.messages ?? '{}') as Record<string, string>;
    const state = form.querySelector<HTMLElement>('[data-state]');
    const send = form.querySelector<HTMLButtonElement>('[data-send]');
    const fields = form.querySelector<HTMLElement>('[data-form-fields]');
    const sent = form.querySelector<HTMLElement>('[data-form-sent]');
    const stateName = band.querySelector<HTMLElement>('[data-form-state-name]');
    const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement;
    // Para que :placeholder-shown distinga un campo vacío de uno escrito
    for (const name of ['name', 'email', 'company', 'message']) field(name).placeholder ||= ' ';

    const setState = (next: 'empty' | 'typing' | 'valid' | 'sent') => {
      band.dataset.formState = next;
      const label = band.querySelector<HTMLElement>(`[data-state-thumb="${next}"]`)?.dataset.label;
      if (stateName && label) stateName.textContent = label;
    };
    const showSent = (on: boolean) => {
      if (!fields || !sent) return;
      fields.hidden = on;
      sent.hidden = !on;
      if (on) {
        setState('sent');
        sent.querySelector<HTMLElement>('[data-form-sent-title]')?.focus({ preventScroll: true });
      }
    };

    const rules: Record<string, () => boolean> = {
      name: () => field('name').value.trim().length > 1,
      email: () => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(field('email').value.trim()),
      message: () => field('message').value.trim().length >= 20,
    };
    const check = () => {
      let all = true;
      for (const [name, rule] of Object.entries(rules)) {
        const ok = rule();
        all &&= ok;
        form.querySelector(`[data-check="${name}"]`)?.classList.toggle('is-ok', ok);
      }
      field('message').classList.toggle('is-ok', rules.message());
      send?.classList.toggle('is-ready', all);
      if (state) state.textContent = all ? messages.ready : '';
      const any = ['name', 'email', 'company', 'message'].some((name) => field(name).value.trim());
      if (sent?.hidden !== false) setState(all ? 'valid' : any ? 'typing' : 'empty');
      return all;
    };

    // Errores por campo (WCAG 3.3.1, 3.3.3, 4.1.3): solo se marcan al enviar; después, cada campo
    // se limpia en cuanto pasa a ser válido. El texto del error entra en aria-describedby solo
    // mientras hay error (un elemento oculto referenciado se leería siempre).
    const alertBox = form.querySelector<HTMLElement>('[data-alert]');
    const fallbackCopy = form.querySelector<HTMLElement>('[data-fallback-copy]');
    const labels = (messages.labels ?? {}) as unknown as Record<string, string>;
    const setInvalid = (name: string, invalid: boolean) => {
      const el = field(name);
      const errorId = `c-${name}-err`;
      const tokens = (el.getAttribute('aria-describedby') ?? '').split(/\s+/).filter((id) => id && id !== errorId);
      if (invalid) {
        el.setAttribute('aria-invalid', 'true');
        tokens.push(errorId);
      } else {
        el.removeAttribute('aria-invalid');
      }
      form.querySelector<HTMLElement>(`#${errorId}`)!.hidden = !invalid;
      if (tokens.length) el.setAttribute('aria-describedby', tokens.join(' '));
      else el.removeAttribute('aria-describedby');
    };
    const clearFixed = () => {
      for (const name of Object.keys(rules)) {
        if (field(name).getAttribute('aria-invalid') === 'true' && rules[name]()) setInvalid(name, false);
      }
      if (alertBox && !Object.keys(rules).some((name) => field(name).getAttribute('aria-invalid') === 'true')) {
        alertBox.textContent = '';
      }
    };
    // El aviso de después del mailto: el mensaje con el correo en la región de estado y, justo detrás
    // pero fuera de ella, el botón Copiar (se muestra y se oculta con el mensaje)
    const showFallback = (on: boolean) => {
      if (on && state) state.textContent = `${messages.fallback} ${form.dataset.email}`;
      if (fallbackCopy) fallbackCopy.hidden = !on;
    };

    form.addEventListener('input', () => {
      showFallback(false);
      check();
      clearFixed();
    });
    form.addEventListener('click', (event) => {
      if (!(event.target as Element).closest('[data-form-again]')) return;
      form.reset();
      showSent(false);
      check();
      field('name').focus();
    });
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!check()) {
        const bad = Object.keys(rules).filter((name) => !rules[name]());
        for (const name of Object.keys(rules)) setInvalid(name, bad.includes(name));
        if (alertBox) {
          // Vaciar y poner el texto en el cuadro siguiente: con el mismo texto de antes, el lector no
          // lo volvería a anunciar en un segundo envío inválido
          const summary = (messages.summary ?? '').replace('{list}', bad.map((name) => labels[name] ?? name).join(', '));
          alertBox.textContent = '';
          requestAnimationFrame(() => (alertBox.textContent = summary));
        }
        field(bad[0]).focus();
        return;
      }
      clearFixed();
      const data = new FormData(form);
      const endpoint = form.dataset.endpoint;
      if (!endpoint) {
        const body = `${data.get('message')}\n\n— ${data.get('name')} (${data.get('email')})${data.get('company') ? ` · ${data.get('company')}` : ''}`;
        window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(`${form.dataset.subject} · ${data.get('topic')}`)}&body=${encodeURIComponent(body)}`;
        // Sin servicio de envío, abrir el cliente de correo es lo único que pasa, y sin cliente no pasa
        // nada: el aviso dice qué ha ocurrido y da el correo con su botón de copiar
        showFallback(true);
        return;
      }
      if (state) state.textContent = messages.sending;
      send?.setAttribute('disabled', '');
      try {
        const response = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!response.ok) throw new Error(String(response.status));
        showSent(true);
      } catch {
        if (state) state.textContent = `${messages.error} ${form.dataset.email}`;
      } finally {
        send?.removeAttribute('disabled');
      }
    });

    // Vista previa de un estado (para revisar el diseño)
    const preview = new URLSearchParams(location.search).get('estado');
    if (preview === 'escribiendo' || preview === 'valido' || preview === 'enviado') {
      field('name').value = 'Laura Vidal';
      field('email').value = preview === 'escribiendo' ? 'laura@' : 'laura@estudio.example';
      if (preview !== 'escribiendo') field('message').value = 'Buscamos a alguien que diseñe y programe la nueva web del estudio.';
    }
    check();
    if (preview === 'enviado') showSent(true);
  });
</script>
