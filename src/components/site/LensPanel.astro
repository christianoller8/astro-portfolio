---
// Barra de estado de la lente activa, pegada abajo como la de una herramienta: el frame en el que
// estás y su tamaño real, el nombre de la lente, sus cifras (medidas en el navegador por
// src/scripts/lenses.ts) y la salida a la vista normal.
// En móvil y tablet lleva también el cambio de lente, para pasar de una a otra sin abrir el menú.
import { useTranslations } from '@/i18n/utils';
import LensSwitch from './LensSwitch.astro';

interface Props {
  lang: 'es' | 'en';
  /** Nombre del frame (la página); el tamaño lo escribe kit.ts */
  frame: string;
}

const { lang, frame } = Astro.props;
const t = useTranslations(lang);
---

<aside
  class="lens-bar"
  aria-label={t('lens.label')}
  data-lens-panel
  data-i18n={JSON.stringify({
    design: t('lens.design'),
    code: t('lens.code'),
    qa: t('lens.qa'),
    nodes: t('lens.stat.nodes'),
    js: t('lens.stat.js'),
    css: t('lens.stat.css'),
    load: t('lens.stat.load'),
    passed: t('lens.stat.passed'),
  })}
>
  <div class="lens-bar-switch"><LensSwitch variant="dock" lang={lang} /></div>
  <p class="lens-bar-frame" aria-hidden="true">{frame} <span data-frame-size></span></p>
  <p class="lens-bar-title" data-lens-title aria-live="polite"></p>
  <ul class="lens-bar-stats" data-lens-stats></ul>
  <button type="button" class="lens-bar-close" data-lens-clear>
    <span>{t('lens.clear')}</span>
    <kbd>Esc</kbd>
    <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M3.5 3.5l9 9M12.5 3.5l-9 9"></path>
    </svg>
  </button>
</aside>

<style>
  .lens-bar {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 48;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    height: var(--lens-bar-h);
    padding-inline: var(--gutter) 0;
    padding-bottom: env(safe-area-inset-bottom);
    box-sizing: content-box;
    font-size: 0.8125rem;
    color: var(--paper);
    background: var(--ink);
    transition:
      translate var(--dur-ui) var(--ease-out),
      visibility 0s;
  }
  /* Sin lente, la barra espera fuera de la pantalla */
  :global(html:not([data-lens])) .lens-bar,
  :global(html.canvas-open) .lens-bar,
  :global(html.menu-open) .lens-bar,
  :global(html.intro) .lens-bar {
    translate: 0 100%;
    visibility: hidden;
    transition:
      translate var(--dur-micro) var(--ease-in),
      visibility 0s var(--dur-micro);
  }
  .lens-bar-title {
    flex: none;
    font-size: var(--step-small);
    font-weight: 700;
  }
  /* El frame en el que estás, como en la herramienta: "Inicio 1440 × 7570" */
  .lens-bar-frame {
    display: none;
    flex: none;
    gap: 0.5rem;
    align-items: baseline;
    font-size: var(--step-small);
    font-weight: 600;
    white-space: nowrap;
  }
  .lens-bar-frame span {
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    color: color-mix(in srgb, var(--paper) 68%, var(--ink));
  }
  @media (min-width: 1024px) {
    .lens-bar-frame {
      display: flex;
    }
  }
  .lens-bar-switch {
    display: none;
    flex: none;
  }

  /* Las cifras: una fila que se desliza si no cabe */
  .lens-bar-stats {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 0.35rem;
    min-width: 0;
    height: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    font-family: var(--font-mono);
    white-space: nowrap;
    -webkit-mask: linear-gradient(90deg, #000 calc(100% - 1.5rem), transparent);
    mask: linear-gradient(90deg, #000 calc(100% - 1.5rem), transparent);
  }
  .lens-bar-stats::-webkit-scrollbar {
    display: none;
  }
  .lens-bar-stats :global(li) {
    flex: none;
  }
  .lens-bar-stats :global(.lb-chip) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 1.75rem;
    padding: 0 0.55rem;
    color: color-mix(in srgb, var(--paper) 72%, var(--ink));
    background: color-mix(in srgb, var(--paper) 9%, var(--ink));
    animation: lb-in 260ms var(--ease-out) both;
  }
  .lens-bar-stats :global(.lb-chip b) {
    font-weight: 500;
    color: var(--paper);
  }
  .lens-bar-stats :global(.lb-chip i:not(.lm-ico):not(.lb-sw)) {
    font-style: normal;
    opacity: 0.7;
  }
  .lens-bar-stats :global(.lb-chip--btn) {
    color: var(--paper);
    transition: background-color var(--dur-micro) var(--ease-out);
  }
  .lens-bar-stats :global(.lb-chip--btn:hover),
  .lens-bar-stats :global(.lb-chip--btn:focus-visible) {
    background: color-mix(in srgb, var(--paper) 22%, var(--ink));
  }
  .lens-bar-stats :global(.lb-chip--btn:focus-visible) {
    outline: 1px solid var(--paper);
    outline-offset: -1px;
  }
  .lens-bar-stats :global(.lb-score b) {
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .lens-bar-stats :global(.lb-sw) {
    width: 0.75rem;
    height: 0.75rem;
    box-shadow: inset 0 0 0 1px rgb(127 127 127 / 0.6);
  }
  .lens-bar-stats :global(.lb-sep) {
    width: 0.5rem;
  }
  @keyframes lb-in {
    from {
      opacity: 0;
      translate: 0 5px;
    }
  }

  .lens-bar-close {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.5rem;
    align-self: stretch;
    padding: 0 var(--gutter) 0 0.9rem;
    font-size: var(--step-small);
    font-weight: 600;
    color: var(--ink);
    background: var(--paper);
    transition: background-color var(--dur-micro) var(--ease-out);
  }
  .lens-bar-close:hover {
    background: color-mix(in srgb, var(--paper) 86%, var(--ink));
  }
  .lens-bar-close kbd {
    font: 500 0.6875rem/1 var(--font-mono);
    opacity: 0.7;
  }
  .lens-bar-close svg {
    display: none;
  }

  /* Móvil y tablet: dos filas. Arriba, el cambio de lente y la salida; abajo, las cifras. */
  @media (max-width: 1023px) {
    .lens-bar {
      display: grid;
      grid-template: 3rem 2.75rem / 1fr auto;
      gap: 0;
      padding-inline: 0;
    }
    .lens-bar-switch {
      display: block;
      padding-left: var(--gutter);
    }
    .lens-bar-title {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .lens-bar-close {
      grid-area: 1 / 2;
      width: 2.25rem;
      height: 2.25rem;
      justify-content: center;
      align-self: center;
      margin-right: var(--gutter);
      padding: 0;
    }
    .lens-bar-close kbd {
      display: none;
    }
    .lens-bar-close span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .lens-bar-close svg {
      display: block;
    }
    .lens-bar-stats {
      grid-area: 2 / 1 / 3 / 3;
      padding-inline: var(--gutter);
      align-items: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lens-bar,
    .lens-bar-stats :global(.lb-chip) {
      transition: none;
      animation: none;
    }
  }
</style>
