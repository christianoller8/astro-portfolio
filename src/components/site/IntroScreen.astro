---
// Pantalla de la intro (plan §4.3 A). Solo se ve con html.intro, que decide el <head> antes del
// primer pintado: en cada carga de la home (decisión de Christian del 21 nov; del 20 al 21 nov salió
// solo en la primera visita), sin ancla en la URL, sin "reducir movimiento" y sin ahorro de datos; con
// ?intro se fuerza. El trazado empieza con CSS, sin esperar al JavaScript; las fases siguientes las
// marca src/scripts/intro.ts con las clases is-filled e is-leaving. Una pista dice que se puede
// saltar (aparece a los 0,6 s): "Toca" en pantallas táctiles, "Haz clic o pulsa una tecla" en el resto.
import Caricature from './Caricature.astro';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: 'es' | 'en';
}

const t = useTranslations(Astro.props.lang);
---

<div class="intro-screen" data-intro-screen aria-hidden="true">
  <Caricature variant="lockup" class="intro-logo" />
  <p class="intro-hint">
    <span class="intro-hint-touch">{t('intro.skip.touch')}</span>
    <span class="intro-hint-pointer">{t('intro.skip.pointer')}</span>
  </p>
</div>

<style>
  .intro-screen {
    position: fixed;
    inset: 0;
    z-index: var(--z-intro);
    display: none;
    place-items: center;
    color: var(--ink);
    background: var(--canvas);
    clip-path: circle(150% at 50% 50%);
  }
  /* Si el JavaScript no llega, la pantalla se quita sola */
  :global(html.intro) .intro-screen {
    display: grid;
    animation: intro-failsafe 0.01s 7s forwards;
  }
  .intro-screen :global(.intro-logo) {
    width: clamp(15rem, 34vw, 30rem);
    height: auto;
  }
  /* La pista para saltarla: discreta, abajo, a los 0,6 s. --muted sobre --canvas da 5,2:1 en claro y
     5,5:1 en oscuro (mínimo 4,5:1) */
  .intro-hint {
    position: absolute;
    inset: auto 0 max(1.5rem, calc(env(safe-area-inset-bottom) + 1rem));
    text-align: center;
    font-size: var(--step-small);
    color: var(--muted);
    opacity: 0;
    animation: intro-hint-in 300ms var(--ease-out) 600ms forwards;
  }
  .intro-hint-touch {
    display: none;
  }
  @media (pointer: coarse) {
    .intro-hint-touch {
      display: inline;
    }
    .intro-hint-pointer {
      display: none;
    }
  }
  @keyframes intro-hint-in {
    to {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .intro-hint {
      animation-duration: 1ms;
    }
  }

  /* 1 · Trazado (800 ms): todos los contornos a la vez, en línea fina de grafito. Es la animación
     del vídeo de referencia (docs/referencias/analisis-video-intro.md) */
  .intro-screen :global(.car-halo),
  .intro-screen :global(.car-paper),
  .intro-screen :global(.car-tone) {
    opacity: 0;
    transition: opacity 200ms linear;
  }
  .intro-screen :global(.car-ink),
  .intro-screen :global(.car-name path) {
    fill-opacity: 0;
    stroke: var(--graphite);
    stroke-width: 10;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: intro-trace 800ms cubic-bezier(0.4, 0.1, 0.4, 1) forwards;
    transition:
      fill-opacity 200ms linear,
      stroke-opacity 200ms linear 200ms;
  }

  /* 2 · Relleno (200 ms): se pintan el pelo, la barba y las letras; el contorno se retira después */
  .intro-screen.is-filled :global(.car-halo),
  .intro-screen.is-filled :global(.car-paper),
  .intro-screen.is-filled :global(.car-tone) {
    opacity: 1;
  }
  .intro-screen.is-filled :global(.car-ink),
  .intro-screen.is-filled :global(.car-name path) {
    fill-opacity: 1;
    stroke-opacity: 0;
  }

  /* 3 · Salida: el iris se cierra sobre la marca y deja ver la web (la mecánica de eloicotonat.com) */
  :global(html.intro) .intro-screen.is-leaving {
    animation: intro-iris 850ms cubic-bezier(0.76, 0, 0.24, 1) forwards;
  }

  @keyframes intro-trace {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes intro-iris {
    to {
      clip-path: circle(0% at 50% 50%);
    }
  }
  @keyframes intro-failsafe {
    to {
      visibility: hidden;
    }
  }
</style>
