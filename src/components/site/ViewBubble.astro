---
// "¿Quieres verlo como yo?": la caricatura, abajo a la izquierda, con un bocadillo de cómic. Al
// pulsarla se abre con las tres lentes y el lienzo, que antes iban en la barra y en el menú de
// móvil (20 nov: Christian los quiso fuera de la barra, que quedaba cargada). Es la única entrada
// en todos los tamaños.
// - El bocadillo está dibujado con la tinta de la caricatura y conserva sus colores en modo oscuro,
//   igual que ella.
// - Los botones no tienen lógica propia: llevan data-lens-set, data-lens-clear y data-canvas-open,
//   y de eso se encargan lenses.ts y canvas.ts. Los atajos (1, 2, 3, M y Esc) son los de siempre.
// - La cara no se queda en la de la marca: entra con ella, habla y, al acabar, guiña un ojo; así
//   se queda el resto de la visita (pedido por Christian para que no sea la misma cara en todas
//   partes). La boca, en reposo, es siempre la del dibujo.
// - En reposo queda solo la cabeza, que parpadea de vez en cuando. El bocadillo sale cuando
//   "habla" (mueve la boca): una vez por visita, un segundo después de entrar, y se recoge a los
//   cinco segundos; después, solo al pasar el ratón o enfocarla. Con la página movida o con una
//   lente puesta no sale solo, para no tapar contenido.
// - El bocadillo y el panel son un solo globo: al abrir, crece; al cerrar, encoge.
import Caricature from './Caricature.astro';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const lenses = [
  { id: 'design', key: '1', label: t('lens.design') },
  { id: 'code', key: '2', label: t('lens.code') },
  { id: 'qa', key: '3', label: t('lens.qa') },
] as const;
---

<div class="vb" data-vb data-face="normal">
  <button
    type="button"
    class="vb-toggle"
    data-vb-toggle
    aria-expanded="false"
    aria-controls="vb-panel"
    aria-label={t('bubble.title')}
  >
    <Caricature variant="head" class="vb-head" />
    {/* Los gestos de esta cara, dibujados encima con las medidas de la caricatura (900 × 1180).
        Entra con la cara del dibujo; al acabar de hablar guiña un ojo y se queda así (data-face).
        - El guiño: el ojo grande cerrado en un arco grueso.
        - Las bocas: al hablar va pasando de una forma a otra (data-mouth), como en los dibujos
          animados: entreabierta, en "o" y abierta del todo. La abierta es también la sonrisa con
          la que se queda tras el guiño. La boca cerrada es la línea del propio dibujo.
        El CSS esconde los trazos del dibujo a los que sustituyen en cada momento */}
    <svg class="vb-face" viewBox="0 0 900 1180" aria-hidden="true">
      <path class="vb-wink vb-ink" d="M330 664Q408 556 500 642Q414 630 330 664Z"></path>
      <g class="vb-m vb-m--half">
        <path class="vb-ink" d="M498 888Q578 874 660 884Q644 940 578 942Q514 938 498 888Z"></path>
        <path class="vb-teeth" d="M520 893Q578 884 640 890L634 906Q578 898 526 908Z"></path>
      </g>
      <g class="vb-m vb-m--o">
        <path class="vb-ink" d="M532 910a46 40 0 1 0 92 0a46 40 0 1 0-92 0Z"></path>
        <path class="vb-tongue" d="M552 926Q578 908 604 926Q592 944 578 944Q564 944 552 926Z"></path>
      </g>
      <g class="vb-m vb-m--wide">
        <path class="vb-ink" d="M446 868Q580 912 716 846Q700 1006 566 1002Q468 990 446 868Z"></path>
        <path class="vb-teeth" d="M470 886Q582 924 698 866L688 898Q580 948 480 916Z"></path>
        <path class="vb-tongue" d="M520 966Q580 938 640 958Q604 992 566 990Q536 986 520 966Z"></path>
      </g>
    </svg>
    <span class="vb-bubble" aria-hidden="true">
      <span data-vb-title>{t('bubble.title')}</span>
      {/* La respuesta a la pregunta, con forma de botón: deja claro que el bocadillo se pulsa */}
      <span class="vb-yes" data-vb-yes>{t('bubble.yes')}</span>
      <svg class="vb-tail" viewBox="0 0 30 24" aria-hidden="true">
        <path d="M11 1C10 9 7 16 1 22c11-2 19-9 23-20"></path>
      </svg>
    </span>
  </button>

  <div id="vb-panel" class="vb-panel" data-vb-panel role="group" aria-label={t('bubble.title')} hidden>
    {/* El contenido va en su propia caja para que no se salga mientras el globo crece o encoge */}
    <div class="vb-panel-in">
    <p class="vb-title" data-vb-title aria-hidden="true">{t('bubble.title')}</p>
    {
      lenses.map((lens) => (
        <button type="button" class="vb-row" data-lens-set={lens.id} aria-pressed="false" aria-keyshortcuts={lens.key}>
          <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            {lens.id === 'design' && (
              <>
                <rect x="3" y="3" width="10" height="10" />
                <rect x="1.5" y="1.5" width="3" height="3" fill="currentColor" stroke="none" />
                <rect x="11.5" y="11.5" width="3" height="3" fill="currentColor" stroke="none" />
              </>
            )}
            {lens.id === 'code' && <path d="M5.5 4 2 8l3.5 4M10.5 4 14 8l-3.5 4" />}
            {lens.id === 'qa' && <path d="m2.5 8.5 3.5 3.5 7.5-8" />}
          </svg>
          <span>{lens.label}</span>
          <kbd>{lens.key}</kbd>
        </button>
      ))
    }
    <button type="button" class="vb-row" data-canvas-open aria-keyshortcuts="M">
      <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <rect x="1.5" y="2" width="5.5" height="7.5"></rect>
        <rect x="9.5" y="2" width="5" height="4"></rect>
        <rect x="9.5" y="8.5" width="5" height="5.5"></rect>
        <rect x="1.5" y="12" width="5.5" height="2"></rect>
      </svg>
      <span>{t('nav.canvas')}</span>
      <kbd>M</kbd>
    </button>
    {/* Solo con una lente puesta: la salida */}
    <button type="button" class="vb-row vb-row--clear" data-lens-clear aria-keyshortcuts="Escape">
      <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="m3.5 3.5 9 9M12.5 3.5l-9 9"></path>
      </svg>
      <span>{t('lens.clear')}</span>
      <kbd>Esc</kbd>
    </button>
    </div>
    <svg class="vb-tail" viewBox="0 0 30 24" aria-hidden="true">
      <path d="M11 1C10 9 7 16 1 22c11-2 19-9 23-20"></path>
    </svg>
  </div>
</div>

<style>
  .vb {
    /* La tinta y el papel de la caricatura: no cambian con el tema */
    --vb-ink: var(--car-ink);
    --vb-paper: var(--car-paper);
    --vb-head: 3.625rem;
    --vb-line: 2.6px;
    position: fixed;
    left: max(calc(var(--gutter) * 0.5), env(safe-area-inset-left));
    bottom: calc(1rem + env(safe-area-inset-bottom));
    z-index: 49;
    color: var(--vb-ink);
    /* En el paneo entre páginas se queda quieta, como la barra */
    view-transition-name: view-bubble;
    transition:
      bottom var(--dur-ui) var(--ease-out),
      opacity var(--dur-micro) var(--ease-out),
      visibility 0s;
  }
  /* Con una lente puesta sube por encima de su barra de estado */
  :global(html[data-lens]) .vb {
    bottom: calc(var(--lens-bar-h) + 0.75rem + env(safe-area-inset-bottom));
  }
  :global(html.intro) .vb,
  :global(html.canvas-open) .vb,
  :global(html.menu-open) .vb {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--dur-micro) var(--ease-in),
      visibility 0s var(--dur-micro);
  }

  .vb-toggle {
    position: relative;
    display: block;
    cursor: pointer;
  }
  .vb :global(.vb-head) {
    width: var(--vb-head);
    height: auto;
    transform-origin: 50% 100%;
    transition: transform var(--dur-micro) var(--ease-out);
  }
  /* El gesto (.vb-face) va encima de la cabeza y se mueve con ella */
  @media (hover: hover) {
    .vb-toggle:hover :global(.vb-head),
    .vb-toggle:hover .vb-face {
      transform: rotate(-5deg);
    }
  }
  .vb-toggle:active :global(.vb-head),
  .vb-toggle:active .vb-face {
    transform: scale(0.96);
  }

  /* --- El bocadillo y el panel: el mismo globo de tinta, con más peso abajo y a la derecha --- */
  .vb-bubble,
  .vb-panel {
    position: absolute;
    bottom: 2.5rem;
    background: var(--vb-paper);
    border: var(--vb-line) solid var(--vb-ink);
    box-shadow: 2px 2.5px 0 var(--vb-ink);
    transform-origin: 0 100%;
  }
  .vb-tail {
    position: absolute;
    left: 12px;
    bottom: -19.5px;
    width: 30px;
    height: 24px;
    overflow: visible;
  }
  .vb-tail path {
    fill: var(--vb-paper);
    stroke: var(--vb-ink);
    stroke-width: var(--vb-line);
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .vb-bubble {
    left: calc(100% + 0.25rem);
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.4rem 0.45rem 0.45rem 0.9rem;
    /* La misma familia de forma que el panel: un rectángulo de esquinas blandas y desiguales */
    border-radius: 16px 13px 17px 12px / 13px 17px 12px 16px;
    font-size: var(--step-small);
    font-weight: 700;
    line-height: 1.2;
    white-space: nowrap;
    /* En reposo no se ve: queda la cabeza sola */
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: scale(0.7);
    transition:
      opacity var(--dur-micro) var(--ease-in),
      transform var(--dur-micro) var(--ease-in),
      visibility 0s var(--dur-micro);
  }
  /* Sale cuando la caricatura habla: al saludar (.is-saying, lo pone el guion una vez por visita,
     con la página arriba del todo y sin lente) y al pasar el ratón o enfocarla. Entra con un
     pequeño rebote, como un bocadillo que salta */
  :global(html:not([data-scrolled]):not([data-lens])) .vb.is-saying .vb-toggle[aria-expanded='false'] .vb-bubble,
  .vb .vb-toggle[aria-expanded='false']:focus-visible .vb-bubble {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: none;
    transition:
      opacity var(--dur-micro) var(--ease-out),
      transform 220ms cubic-bezier(0.34, 1.56, 0.64, 1),
      visibility 0s;
  }
  @media (hover: hover) {
    .vb .vb-toggle[aria-expanded='false']:hover .vb-bubble {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: none;
      transition:
        opacity var(--dur-micro) var(--ease-out),
        transform 220ms cubic-bezier(0.34, 1.56, 0.64, 1),
        visibility 0s;
    }
  }
  /* El "Sí" del bocadillo: una pastilla de tinta, que es lo que se pulsa. Se aclara al pasar el ratón */
  .vb-yes {
    padding: 0.3rem 0.65rem 0.35rem;
    font-size: 0.8125rem;
    line-height: 1.2;
    color: var(--vb-paper);
    background: var(--vb-ink);
    border-radius: 9px 7px 10px 7px / 7px 10px 7px 9px;
    transition: background-color var(--dur-micro) var(--ease-out);
  }
  @media (hover: hover) {
    .vb-toggle:hover .vb-yes {
      background: color-mix(in srgb, var(--vb-ink) 78%, var(--vb-paper));
    }
  }
  /* En los móviles más estrechos la pregunta va en dos líneas para que quepa con su "Sí" */
  @media (max-width: 359px) {
    .vb-bubble {
      width: 13rem;
      white-space: normal;
    }
  }
  /* Los trazos de la cara giran y se estiran sobre su propio centro (parpadeo y boca, en el guion) */
  .vb :global(.car-ink) {
    transform-box: fill-box;
    transform-origin: center;
  }
  /* --- Los gestos (.vb-face). data-face y data-mouth los pone el guion. Los trazos del dibujo que
     se esconden son de caricature.json: trazo-3 (ojo grande), trazo-6 (boca), trazo-7 y barba-2
     (línea y tono de debajo del labio) y trazo-1 (ceja de ese ojo) --- */
  .vb-wink,
  .vb-m {
    visibility: hidden;
  }
  /* El guiño: el ojo grande se cierra en arco y su ceja baja un poco */
  .vb[data-face='wink'] .vb-wink {
    visibility: visible;
  }
  .vb[data-face='wink'] :global([data-part='trazo-3']) {
    visibility: hidden;
  }
  .vb[data-face='wink'] :global([data-part='trazo-1']) {
    transform: translateY(12px);
  }
  /* La boca. En reposo, antes y después del guiño, es la del dibujo (pedido por Christian: la
     sonrisa abierta fija no le convenció). Al hablar, la forma de cada momento */
  .vb[data-mouth='wide'] .vb-m--wide,
  .vb[data-mouth='half'] .vb-m--half,
  .vb[data-mouth='o'] .vb-m--o {
    visibility: visible;
  }
  .vb[data-mouth]:not([data-mouth='closed']) :global([data-part='trazo-6']) {
    visibility: hidden;
  }
  /* La boca abierta del todo tapa la línea y el tono de debajo del labio */
  .vb[data-mouth='wide'] :global([data-part='trazo-7']),
  .vb[data-mouth='wide'] :global([data-part='barba-2']) {
    visibility: hidden;
  }
  .vb-face {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--vb-head);
    height: auto;
    overflow: visible;
    pointer-events: none;
    transform-origin: 50% 100%;
    transition: transform var(--dur-micro) var(--ease-out);
  }
  .vb-ink {
    fill: var(--vb-ink);
  }
  .vb-teeth {
    fill: var(--vb-paper);
  }
  .vb-tongue {
    fill: var(--car-tone);
  }

  .vb-panel {
    left: calc(var(--vb-head) + 0.25rem);
    min-width: 12.5rem;
    padding: 0.75rem 0.625rem 0.625rem;
    border-radius: 26px 22px 28px 20px / 22px 28px 20px 26px;
  }
  .vb-panel[hidden] {
    display: none;
  }
  /* El bocadillo y el panel son el mismo globo: al abrir crece desde el tamaño del bocadillo y al
     cerrar vuelve a él (lo anima el guion). Mientras tanto el contenido queda recortado en su caja */
  .vb-panel.is-closing {
    pointer-events: none;
  }
  .vb-panel-in {
    height: 100%;
    overflow: hidden;
  }
  .vb-title {
    margin: 0 0.5rem 0.5rem;
    font-size: var(--step-small);
    font-weight: 700;
    line-height: 1.2;
    white-space: nowrap;
  }
  .vb-row:focus-visible {
    outline-offset: -2px;
  }
  .vb-row {
    display: grid;
    grid-template-columns: 1rem 1fr auto;
    align-items: center;
    gap: 0.625rem;
    width: 100%;
    min-height: 2.25rem;
    padding: 0 0.5rem;
    font-size: var(--step-small);
    font-weight: 600;
    text-align: left;
    white-space: nowrap;
    color: inherit;
  }
  .vb-row svg {
    display: block;
  }
  .vb-row kbd {
    font: 500 0.75rem/1 var(--font-mono);
    opacity: 0.6;
  }
  /* Al pasar el ratón o enfocar, un tinte; la opción activa, en tinta. Con los colores de la
     caricatura y no con --pencil, que en modo oscuro es claro y no se vería sobre el globo blanco */
  @media (hover: hover) {
    .vb-row:hover {
      background: color-mix(in srgb, var(--vb-ink) 12%, var(--vb-paper));
    }
  }
  .vb-row:focus-visible {
    background: color-mix(in srgb, var(--vb-ink) 12%, var(--vb-paper));
  }
  .vb-row[aria-pressed='true'] {
    background: var(--vb-ink);
    color: var(--vb-paper);
  }
  .vb-row--clear {
    display: none;
  }
  :global(html[data-lens]) .vb-row--clear {
    display: grid;
  }
  @media (pointer: coarse) {
    .vb-row {
      min-height: 2.75rem;
    }
  }

  /* Sin movimiento: todo cambia de golpe y la cabeza no se ladea */
  @media (prefers-reduced-motion: reduce) {
    .vb,
    .vb-bubble,
    .vb-face,
    .vb :global(.vb-head) {
      transition: none !important;
    }
    .vb-toggle:hover :global(.vb-head),
    .vb-toggle:active :global(.vb-head),
    .vb-toggle:hover .vb-face,
    .vb-toggle:active .vb-face {
      transform: none;
    }
  }

  /* Tablet y móvil: la cabeza, algo más pequeña */
  @media (max-width: 1023px) {
    .vb {
      --vb-head: 3rem;
      bottom: calc(0.75rem + env(safe-area-inset-bottom));
    }
    .vb-bubble,
    .vb-panel {
      bottom: 2rem;
    }
  }
</style>

<script>
  // La página se vuelve a pintar en cada navegación: los oyentes van en el documento, una sola vez
  const parts = () => {
    const box = document.querySelector<HTMLElement>('[data-vb]');
    const toggle = box?.querySelector<HTMLButtonElement>('[data-vb-toggle]');
    const panel = box?.querySelector<HTMLElement>('[data-vb-panel]');
    return box && toggle && panel ? { box, toggle, panel } : null;
  };
  const isOpen = () => parts()?.toggle.getAttribute('aria-expanded') === 'true';
  const rows = (panel: HTMLElement) => [...panel.querySelectorAll<HTMLButtonElement>('button')].filter((btn) => btn.offsetParent !== null);

  // Las esquinas del bocadillo y del panel (las mismas que en el CSS), para pasar de unas a otras
  const BUBBLE_RADIUS = '16px 13px 17px 12px / 13px 17px 12px 16px';
  const PANEL_RADIUS = '26px 22px 28px 20px / 22px 28px 20px 26px';
  /** El paso del bocadillo al panel: un solo globo que crece desde el tamaño del bocadillo (están
   *  anclados en el mismo punto, abajo a la izquierda) y, al cerrar, encoge hasta él y se va */
  const morph = (p: NonNullable<ReturnType<typeof parts>>, open: boolean, bubbleShown: boolean) => {
    const { panel } = p;
    const bubble = p.box.querySelector<HTMLElement>('.vb-bubble');
    const inner = panel.querySelector<HTMLElement>('.vb-panel-in');
    for (const el of [panel, inner]) el?.getAnimations().forEach((anim) => anim.cancel());
    panel.classList.toggle('is-closing', !open);
    if (!bubble || !inner || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      panel.hidden = !open;
      panel.classList.remove('is-closing');
      return;
    }
    panel.hidden = false;
    const size = (el: HTMLElement) => ({ width: `${el.offsetWidth}px`, minWidth: `${el.offsetWidth}px`, height: `${el.offsetHeight}px` });
    const small = { ...size(bubble), borderRadius: BUBBLE_RADIUS };
    const big = { ...size(panel), borderRadius: PANEL_RADIUS };
    if (open) {
      // Si el bocadillo estaba a la vista, el globo ya está ahí: solo crece. Si no, además aparece
      panel.animate([{ ...small, opacity: bubbleShown ? 1 : 0 }, { opacity: 1, offset: 0.3 }, { ...big, opacity: 1 }], {
        duration: 300,
        easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
      });
      inner.animate([{ opacity: 0 }, { opacity: 0, offset: 0.3 }, { opacity: 1 }], { duration: 300, easing: 'ease-out' });
      return;
    }
    inner.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 100, easing: 'ease-in', fill: 'forwards' });
    panel
      .animate([{ ...big, opacity: 1 }, { opacity: 1, offset: 0.6 }, { ...small, opacity: 0 }], { duration: 200, easing: 'cubic-bezier(0.4, 0, 0.6, 1)' })
      .finished.then(() => {
        if (!isOpen()) panel.hidden = true;
        panel.classList.remove('is-closing');
        inner.getAnimations().forEach((anim) => anim.cancel());
      })
      .catch(() => {});
  };

  /** Abre o cierra el panel. Al cerrar, el foco vuelve a la caricatura si estaba dentro (salvo refocus: false) */
  const setOpen = (open: boolean, refocus = true) => {
    const p = parts();
    if (!p || open === isOpen()) return;
    const hadFocus = refocus && p.panel.contains(document.activeElement);
    const bubble = p.box.querySelector('.vb-bubble');
    const bubbleShown = !!bubble && getComputedStyle(bubble).visibility === 'visible';
    p.toggle.setAttribute('aria-expanded', String(open));
    morph(p, open, bubbleShown);
    if (open) {
      const list = rows(p.panel);
      (list.find((btn) => btn.getAttribute('aria-pressed') === 'true') ?? list[0])?.focus({ preventScroll: true });
    } else if (hadFocus) {
      p.toggle.focus({ preventScroll: true });
    }
  };

  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target : null;
    if (target?.closest('[data-vb-toggle]')) {
      setOpen(!isOpen());
      return;
    }
    if (!isOpen()) return;
    // Elegir una opción o pulsar fuera lo cierra. Al abrir el lienzo el foco es suyo (canvas.ts)
    if (!target?.closest('[data-vb-panel]') || target.closest('button')) setOpen(false, !target?.closest('[data-canvas-open]'));
  });

  // En la fase de captura: con el panel abierto, Escape lo cierra y no llega a quitar la lente
  document.addEventListener(
    'keydown',
    (event) => {
      const p = parts();
      if (!p || !isOpen()) return;
      const state = document.documentElement.classList;
      // Con el lienzo o el menú abiertos la caricatura está escondida: el panel se cierra y la tecla sigue su camino
      if (state.contains('canvas-open') || state.contains('menu-open')) {
        setOpen(false, false);
        return;
      }
      // M abre el lienzo (canvas.ts): antes, el foco pasa a la caricatura para que vuelva a ella al cerrarlo
      if (event.key.toLowerCase() === 'm' && !event.metaKey && !event.ctrlKey && !event.altKey) {
        p.toggle.focus({ preventScroll: true });
        setOpen(false, false);
        return;
      }
      if (event.key === 'Escape') {
        event.preventDefault();
        event.stopPropagation();
        p.toggle.focus({ preventScroll: true });
        setOpen(false);
        return;
      }
      const list = rows(p.panel);
      const at = list.indexOf(document.activeElement as HTMLButtonElement);
      const next =
        event.key === 'ArrowDown' ? (at + 1) % list.length
        : event.key === 'ArrowUp' ? (at <= 0 ? list.length - 1 : at - 1)
        : event.key === 'Home' ? 0
        : event.key === 'End' ? list.length - 1
        : -1;
      if (next < 0) return;
      event.preventDefault();
      list[next]?.focus({ preventScroll: true });
    },
    true,
  );

  // Al salir con el tabulador, se cierra
  document.addEventListener('focusout', (event) => {
    const p = parts();
    if (!p || !isOpen()) return;
    const to = event.relatedTarget instanceof Node ? event.relatedTarget : null;
    if (to && !p.box.contains(to)) setOpen(false);
  });

  // --- La cara: parpadea de vez en cuando y mueve la boca cuando habla ---
  // Los ojos son trazos de src/data/caricature.json (Caricature.astro los numera en data-part): si
  // se regenera el dibujo, hay que comprobar que siguen siendo esos. Tras el guiño el ojo grande
  // (trazo-3) queda escondido y solo se ve parpadear el otro.
  const EYES = ['trazo-3', 'trazo-4'];
  const still = window.matchMedia('(prefers-reduced-motion: reduce)');
  const root = document.documentElement;
  const trace = (name: string) => parts()?.box.querySelector<SVGPathElement>(`.car [data-part="${name}"]`) ?? null;
  // Escondida (intro, lienzo o menú abiertos) o con la pestaña en segundo plano, no se mueve
  const away = () => document.hidden || ['intro', 'canvas-open', 'menu-open'].some((cls) => root.classList.contains(cls));

  const blink = () => {
    if (still.matches || away()) return;
    for (const name of EYES) {
      trace(name)?.animate([{ transform: 'scaleY(1)' }, { transform: 'scaleY(0.12)', offset: 0.45 }, { transform: 'scaleY(1)' }], {
        duration: 180,
        easing: 'ease-in-out',
      });
    }
  };
  // A intervalos irregulares (de 3,6 a 6,4 s): si fuera regular parecería un tic
  const blinkLater = () => {
    window.setTimeout(() => {
      blink();
      blinkLater();
    }, 3600 + Math.random() * 2800);
  };
  blinkLater();

  // --- El guiño: la primera vez que habla acaba guiñando un ojo, y se queda así. Lo recuerda este
  // guion, que sigue cargado al pasar de una página a otra y empieza de cero cuando la web se
  // carga de nuevo (al entrar o al recargar): así cada entrada empieza con la cara normal ---
  let winked = false;
  const wink = () => {
    const box = parts()?.box;
    if (!box) return;
    box.dataset.face = 'wink';
    winked = true;
    if (still.matches) return;
    // Un cabeceo corto acompaña al guiño
    for (const el of box.querySelectorAll('.vb-head, .vb-face')) {
      el.animate([{ transform: 'rotate(0deg)' }, { transform: 'rotate(-7deg)', offset: 0.4 }, { transform: 'rotate(0deg)' }], {
        duration: 320,
        easing: 'ease-out',
      });
    }
  };
  // La página se vuelve a pintar en cada navegación: si ya guiñó, la nueva entra guiñando
  document.addEventListener('astro:after-swap', () => {
    const box = parts()?.box;
    if (box && winked) box.dataset.face = 'wink';
  });

  // --- Hablar: la boca pasa de una forma a otra, sin transición, como en los dibujos animados.
  // Son las siete sílabas de "¿Quie-res ver-lo co-mo yo?": cada paso es una forma de boca
  // (data-mouth; "closed" es la línea del dibujo) y lo que dura en milisegundos ---
  const PHRASE: [mouth: 'closed' | 'half' | 'o' | 'wide', ms: number][] = [
    ['half', 90], ['wide', 120], ['half', 80], ['closed', 70], // Quie-res
    ['half', 110], ['closed', 60], ['o', 120], // ver-lo
    ['closed', 60], ['o', 110], ['closed', 70], ['o', 120], // co-mo
    ['half', 90], ['o', 140], ['closed', 110], // yo
  ];
  let talking = 0;
  const talk = () => {
    if (still.matches || away() || talking) return;
    let at = 0;
    const step = () => {
      const box = parts()?.box;
      if (!box || at >= PHRASE.length) {
        talking = 0;
        if (!box) return;
        delete box.dataset.mouth;
        if (box.dataset.face !== 'wink') wink();
        return;
      }
      const [mouth, ms] = PHRASE[at++];
      box.dataset.mouth = mouth;
      talking = window.setTimeout(step, ms);
    };
    step();
  };

  // Al pasar el ratón o llegar con el teclado, habla (el bocadillo lo saca el CSS)
  document.addEventListener('pointerover', (event) => {
    if (event.pointerType !== 'mouse' || isOpen()) return;
    const toggle = event.target instanceof Element ? event.target.closest('[data-vb-toggle]') : null;
    const from = event.relatedTarget instanceof Node ? event.relatedTarget : null;
    if (toggle && !(from && toggle.contains(from))) talk();
  });
  document.addEventListener('focusin', (event) => {
    if (event.target instanceof Element && event.target.matches('[data-vb-toggle]:focus-visible') && !isOpen()) talk();
  });

  // El saludo: cada vez que se carga la web (al entrar o al recargar), no al pasar de una página a
  // otra, que no vuelve a ejecutar este guion. La página entra sin bocadillo; un momento después
  // la caricatura habla y el bocadillo sale. Si en ese momento la página ya está movida o hay una
  // lente, no hay saludo. A los cinco segundos, o al bajar, el bocadillo se va y ya no vuelve solo.
  const SAY_MS = 5200;
  const greet = () => {
    // En la home espera a que acabe la intro
    if (root.classList.contains('intro')) {
      window.setTimeout(greet, 300);
      return;
    }
    window.setTimeout(() => {
      const box = parts()?.box;
      if (!box || away() || root.hasAttribute('data-scrolled') || root.dataset.lens) return;
      // Sin movimiento no habla: el bocadillo aparece y la cara pasa a la del guiño
      if (still.matches) wink();
      else talk();
      window.setTimeout(() => parts()?.box.classList.add('is-saying'), still.matches ? 0 : 160);
      // El bocadillo se queda cinco segundos y se recoge; después solo sale al pasar el ratón
      window.setTimeout(() => parts()?.box.classList.remove('is-saying'), SAY_MS);
    }, 1000);
  };
  greet();
  window.addEventListener(
    'scroll',
    () => {
      if (window.scrollY > 120) parts()?.box.classList.remove('is-saying');
    },
    { passive: true },
  );
</script>
