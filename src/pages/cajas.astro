---
// Página interna de pruebas (fuera de buscadores y del sitemap): los proyectos en cajas
// (ProjectBento.astro), para verlos antes de decidir dónde van en la web.
import Layout from '@/layouts/Layout.astro';
import ProjectBento from '@/components/ui/ProjectBento.astro';
import { getSortedProjects } from '@/utils/projects';

const projects = await getSortedProjects('es');
---

<Layout title="Cajas · pruebas" frame="Cajas" noindex>
  <section class="wrap lab">
    <h1 class="t-head">Proyectos</h1>
    <ol class="lab-list">
      {
        projects.map((project) => (
          <li>
            <ProjectBento project={project} lang="es" interactive />
          </li>
        ))
      }
    </ol>
  </section>
</Layout>

<style>
  .lab {
    padding-block: 3rem 6rem;
  }
  .lab-list {
    display: grid;
    gap: clamp(4.5rem, 9vw, 8rem);
    margin-top: clamp(3rem, 6vw, 5rem);
  }
</style>

<script>
  import '@/scripts/project-demos';
</script>
