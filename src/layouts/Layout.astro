---
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import '../styles/kit.css';
import '../styles/lenses.css';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import LensPanel from '../components/site/LensPanel.astro';
import ViewBubble from '../components/site/ViewBubble.astro';
import IntroScreen from '../components/site/IntroScreen.astro';
import Pusher from '../components/character/Pusher.astro';
import CanvasMap from '../components/site/CanvasMap.astro';
import { ClientRouter } from 'astro:transitions';
import { getLangFromUrl, useTranslatedPath, useTranslations, withTrailingSlash } from '@/i18n/utils';
import { site } from '@/data/site';
import { heroPhotoPreload } from '@/data/hero-photo';
import Analytics from '@vercel/analytics/astro';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Nombre del frame (la página) que aparece encima del artboard */
  frame: string;
  /** Solo el inicio lleva la intro (la marca que se dibuja) */
  intro?: boolean;
  /** 404: el artboard es un frame vacío (sin papel ni pie) */
  missing?: boolean;
  /** Páginas internas (la muestra del sistema): fuera de buscadores */
  noindex?: boolean;
}

const {
  title,
  description = 'Christian Oller, software developer. Diseño, programo y pruebo webs y apps.',
  image,
  frame,
  intro = false,
  missing = false,
  noindex = false,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Canonical y hreflang salen de la misma función y acaban siempre en "/": la página dice lo mismo de
// sí misma en las dos etiquetas (antes el hreflang inglés de la home era /en y su canonical /en/).
const canonicalURL = new URL(withTrailingSlash(Astro.url.pathname), Astro.site);
const esURL = new URL(useTranslatedPath('es')(Astro.url.pathname), Astro.site);
const enURL = new URL(useTranslatedPath('en')(Astro.url.pathname), Astro.site);
// La 404 y las páginas internas no se indexan: sin canonical ni hreflang (apuntarían a /404/ o a
// rutas /en/ que no existen), y su selector de idioma lleva a la portada del otro idioma
const indexable = !noindex && !missing;
const isHome = ['/', '/en/'].includes(withTrailingSlash(Astro.url.pathname));

// Datos estructurados (schema.org): quién es y, en las portadas, qué es la web. Los enlaces salen de
// src/data/site.ts para que no haya dos copias.
const siteURL = new URL('/', Astro.site).href;
const person = {
  '@type': 'Person',
  '@id': `${siteURL}#christian-oller`,
  name: site.name,
  url: siteURL,
  jobTitle: site.jobTitle,
  sameAs: [site.linkedin, site.github],
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    person,
    ...(isHome
      ? [
          {
            '@type': 'WebSite',
            '@id': `${siteURL}#website`,
            name: site.name,
            url: new URL(lang === 'en' ? '/en/' : '/', Astro.site).href,
            inLanguage: lang === 'en' ? 'en-US' : 'es-ES',
            description,
            author: { '@id': person['@id'] },
          },
        ]
      : []),
  ],
};
// La imagen para redes es una captura de la parte de arriba de la propia página, en su idioma
// (public/og/<idioma>-<página>.jpg, generadas con .taste-skill/eloi-1118/tools/og-images.mjs). La
// página es el último tramo de la ruta, o "home" en la portada. Las que no tienen la suya (la 404, las
// internas) usan la general, y una página puede pasar otra con la prop image.
const routeSegments = withTrailingSlash(Astro.url.pathname).replace(/^\/en\//, '/').split('/').filter(Boolean);
const pageShot = `/og/${lang}-${routeSegments.at(-1) ?? 'home'}.jpg`;
const hasShot = !image && existsSync(join(process.cwd(), 'public', pageShot));
const ogImage = image ?? (hasShot ? pageShot : '/og-image.jpg');
// El texto alternativo dice qué se ve: en la home (y en la general), el retrato con el nombre; en el
// resto, la página por su nombre (el último tramo del frame: "Proyectos / Tempora" -> "Tempora")
const ogAlt = hasShot && !isHome ? t('meta.og.page').replace('{page}', frame.split(' / ').at(-1) ?? frame) : t('meta.og.alt');
// Siempre absoluta y en el host canónico (los rastreadores no resuelven rutas relativas a un host que
// redirige). 1200 x 630 es el formato que piden Open Graph y las tarjetas grandes.
const imageURL = new URL(ogImage, Astro.site);
// La analítica solo existe en la web publicada: Vercel pone VERCEL en el entorno de la compilación.
// En local (pnpm dev, pnpm build, preview) no se carga nada ni se registra ninguna visita, y las
// pruebas y capturas no ensucian las cifras.
const onVercel = Boolean(process.env.VERCEL);
// Solo la portada lleva la foto del hero: su srcset sale del mismo módulo que el <img> de Hero.astro
const heroPreload = intro ? await heroPhotoPreload() : null;
// Además del gancho: el script de la analítica lo añade inject() al <head> mientras la página corre,
// así que el cambio de página sin recarga lo quitaría (no viene en el HTML de la página nueva) y la
// página nueva lo volvería a cargar y a ejecutar. Se marca para que el router de Astro lo conserve
// (con la misma marca en el <head> nuevo se queda con el que ya funciona) y como ya ejecutado
// (data-astro-exec): sin eso, tras el cambio el router lo reemplaza por una copia y lo ejecuta otra
// vez. Comprobado el 21 nov con .taste-skill/privacidad/persist.mjs: una sola carga del script
const beforeSend = `window.webAnalyticsBeforeSend = function (event) {
  var off = window.__analyticsOff === true;
  try { if (localStorage.getItem('analytics-off') === '1') off = true; } catch (e) {}
  if (off || navigator.globalPrivacyControl === true) return null;
  return event;
};
if (!window.__analyticsKeep) {
  window.__analyticsKeep = true;
  document.addEventListener('astro:before-swap', function (event) {
    var script = document.head.querySelector('script[data-sdkn^="@vercel/analytics"]');
    if (!script || !event.newDocument) return;
    script.setAttribute('data-astro-transition-persist', 'vercel-analytics');
    script.setAttribute('data-astro-exec', '');
    var mark = event.newDocument.createElement('meta');
    mark.setAttribute('data-astro-transition-persist', 'vercel-analytics');
    event.newDocument.head.appendChild(mark);
  });
}`;
---

<!doctype html>
<html lang={lang} data-intro={intro ? '1' : undefined} data-missing={missing ? '' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {/* Color de la barra del navegador en móvil: la hoja de la página (--sheet) del tema que se ve.
        Una sola etiqueta y no una por prefers-color-scheme: quien elige en la web un tema distinto al
        de su sistema vería la barra del otro. El guion del head pone el valor al aplicar el tema y
        tras cada navegación (la mezcla del head de Astro repone el de arriba, claro, sin JavaScript) */}
    <meta name="theme-color" content="#d6d6d6" />
    <meta name="generator" content={Astro.generator} />

    {
      indexable ? (
        <>
          <link rel="canonical" href={canonicalURL} />
          <link rel="alternate" hreflang="es-ES" href={esURL} />
          <link rel="alternate" hreflang="en-US" href={enURL} />
          <link rel="alternate" hreflang="x-default" href={esURL} />
        </>
      ) : (
        noindex && <meta name="robots" content="noindex" />
      )
    }
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <ClientRouter fallback="swap" />

    <script is:inline>
      // Antes del primer pintado: tema, lente guardada, entradas y si toca la intro
      (() => {
        const root = document.documentElement;
        // "js": sin esta clase (JavaScript apagado o roto) la navegación de móvil se ve abierta y el
        // botón de menú, que no haría nada, se esconde (Header.astro)
        root.classList.add('js');
        const applyTheme = () => {
          let theme = 'light';
          try {
            theme =
              localStorage.getItem('theme') ||
              (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          } catch {
            // Almacenamiento bloqueado: se queda en claro
          }
          root.classList.toggle('dark', theme === 'dark');
          // --sheet de cada tema (global.css): el color de la barra del navegador
          const bar = document.querySelector('meta[name="theme-color"]');
          if (bar) bar.setAttribute('content', theme === 'dark' ? '#171717' : '#d6d6d6');
        };
        const applyLens = () => {
          // La lente puesta se recuerda mientras dure la pestaña (sessionStorage): al cerrarla y volver
          // otro día, la web se ve normal. Decisión de Christian, 20 nov; antes iba en localStorage y
          // se quedaba puesta para siempre. El valor viejo de localStorage se borra para que no
          // quede basura (y nadie vuelva a verlo puesto sin haberlo elegido).
          try {
            localStorage.removeItem('lens');
          } catch {
            // Almacenamiento bloqueado: no hay nada que borrar
          }
          try {
            const lens = sessionStorage.getItem('lens');
            if (lens) root.dataset.lens = lens;
          } catch {
            // Sin sessionStorage la web se ve sin lente
          }
        };
        // Atajos de una tecla (1, 2, 3 y M) apagados por quien los ajustó en el panel de la caricatura
        // (src/scripts/shortcuts.ts). Astro cambia los atributos de html al navegar: se repone.
        const applyShortcuts = () => {
          try {
            if (localStorage.getItem('shortcuts') === 'off') root.dataset.shortcuts = 'off';
            else delete root.dataset.shortcuts;
          } catch {
            // Almacenamiento bloqueado: los atajos siguen encendidos
          }
        };
        const markReveal = () => {
          if (!('IntersectionObserver' in window)) return;
          root.classList.add('reveal-ready');
          setTimeout(() => {
            if (!window.__revealInit) root.classList.remove('reveal-ready');
          }, 3000);
        };
        applyTheme();
        applyLens();
        applyShortcuts();
        markReveal();
        try {
          // La intro sale en cada carga de la home (decisión de Christian, 21 nov). El 20 nov, tras la
          // auditoría, había pasado a salir solo en la primera visita (con una bandera en
          // localStorage), y al recargar ya no la veía: la quiso de vuelta. La pista para saltarla se
          // queda. No sale al llegar a la home navegando desde otra página (es un cambio de página sin
          // recarga), ni con ancla en la URL, "reducir movimiento", ahorro de datos o un navegador
          // automatizado (las pruebas). ?intro la fuerza igualmente.
          const replay = new URLSearchParams(location.search).has('intro');
          const skip =
            root.dataset.intro !== '1' ||
            (!replay &&
              (location.hash ||
                window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
                (navigator.connection && navigator.connection.saveData) ||
                navigator.webdriver));
          // intro-seen: en esta carga el titular ya entra con la intro, así que no se entinta aparte
          if (!skip) root.classList.add('intro', 'intro-seen');
        } catch {
          // Si algo falla aquí, sin intro: la página se ve directamente
        }
        document.addEventListener('astro:after-swap', () => {
          // arrived: se llega navegando desde otra página (el entintado espera a la transición)
          root.classList.add('arrived', 'js');
          applyTheme();
          applyLens();
          applyShortcuts();
          markReveal();
        });
      })();
    </script>

    {
      heroPreload && (
        <script is:inline define:vars={{ heroPreload }}>
          // La foto del hero es el LCP de la portada y va en lazy (solo se descarga la del tema activo), así
          // que el navegador no la pide hasta tener la maquetación. Aquí el tema ya está resuelto (el
          // guion de arriba) y los estilos aún no han llegado: se precarga la del tema activo, con el
          // mismo srcset y sizes que su <img>, para que sea una sola descarga. Solo en la carga completa
          // del documento: al llegar navegando desde otra página, la foto ya se pide a su ritmo.
          if (document.readyState === 'loading') {
            const photo = heroPreload[document.documentElement.classList.contains('dark') ? 'dark' : 'light'];
            const link = document.createElement('link');
            link.rel = 'preload';
            link.as = 'image';
            link.setAttribute('imagesrcset', photo.srcset);
            link.setAttribute('imagesizes', photo.sizes);
            link.setAttribute('fetchpriority', 'high');
            document.head.appendChild(link);
          }
        </script>
      )
    }

    {
      onVercel && (
        <>
          {/* El gancho que documenta Vercel: antes de enviar cada evento decide si se descarta (null).
              Se descarta si quien visita lo pidió en /privacy/ (bandera en localStorage, o en memoria
              si el navegador bloquea el almacenamiento) o si su navegador envía Global Privacy Control.
              Se lee en cada evento, así que el botón de la página de privacidad surte efecto al
              instante y sin recargar. Tiene que estar antes del componente, que lo lee al arrancar */}
          <script is:inline set:html={beforeSend} />
          {/* Al final del head: el componente es un elemento propio y el analizador del HTML cierra
              el head al encontrarlo, así que nada que vaya detrás se queda en él */}
          <Analytics />
        </>
      )
    }
  </head>

  <body class="antialiased">
    <a
      href="#main"
      class="bg-pencil text-pencil-ink sr-only z-(--z-skip) px-4 py-3 font-semibold focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
      >{t('aria.skip')}</a
    >
    <Header langHome={!indexable} />
    {/* El frame y el artboard son cajas sin semántica: el contenido va en <main> y el pie, dentro del
        mismo artboard (mismo aspecto), queda fuera de <main> para ser el landmark contentinfo */}
    <div class="frame">
      {
        /* El nombre del frame encima del artboard solo queda en la 404, donde el frame es lo que
           falta. En el resto va en la barra de estado de las lentes y en el lienzo (D23) */
        missing && (
          <p class="frame-label kit-frame-name" aria-hidden="true">
            {frame}
            <span data-frame-size></span>
          </p>
        )
      }
      <div class:list={['artboard', missing && 'artboard--missing']}>
        <main id="main">
          <slot />
        </main>
        {!missing && <Footer />}
      </div>
    </div>
    <ViewBubble lang={lang} />
    <LensPanel lang={lang} frame={frame} />
    {intro && <IntroScreen lang={lang} />}
    <Pusher />
    <CanvasMap />
    <script is:inline>
      // Primera pantalla sin esperar al módulo: en una carga completa, lo que ya está dentro del
      // viewport arranca su entrada ahora (animación CSS, mismo aspecto y escalonado que la transición
      // del scroll). Sin esto, el titular seguía oculto hasta que bajaba y ejecutaba el JS, y retrasaba
      // el LCP en móvil lento. La bandera en window evita repetirlo en las navegaciones sin recarga,
      // que conservan su coreografía (html.arrived y la transición de página).
      (() => {
        if (window.__revealEarly) return;
        window.__revealEarly = true;
        const root = document.documentElement;
        if (!root.classList.contains('reveal-ready')) return;
        const limit = window.innerHeight * 0.92; // el mismo margen (-8 %) que usa reveal.ts
        document.querySelectorAll('[data-reveal]').forEach((el) => {
          const r = el.getBoundingClientRect();
          if (r.top < limit && r.bottom > 0) el.classList.add('is-revealed', 'reveal-early');
        });
      })();
    </script>
  </body>
</html>

<script>
  import '@/scripts/reveal';
  import '@/scripts/lenses';
  import '@/scripts/shortcuts';
  import '@/scripts/frames';
  import '@/scripts/intro';
  import '@/scripts/kit';
</script>
