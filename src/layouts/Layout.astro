---
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import '../styles/kit.css';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import LensPanel from '../components/site/LensPanel.astro';
import { ClientRouter } from 'astro:transitions';
import { getLangFromUrl, useTranslatedPath, useTranslations } from '@/i18n/utils';
import profileImage from '@/assets/images/profile.jpg';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Nombre del frame (la página) que aparece encima del artboard */
  frame: string;
  /** Solo el inicio lleva la intro del boceto */
  intro?: boolean;
  /** Páginas internas (la muestra del sistema): fuera de buscadores */
  noindex?: boolean;
}

const {
  title,
  description = 'Christian Oller, frontend developer. Diseño, programo y pruebo interfaces.',
  image = profileImage.src,
  frame,
  intro = false,
  noindex = false,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const esURL = new URL(useTranslatedPath('es')(Astro.url.pathname), Astro.site);
const enURL = new URL(useTranslatedPath('en')(Astro.url.pathname), Astro.site);
---

<!doctype html>
<html lang={lang} data-intro={intro ? '1' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={canonicalURL} />
          <link rel="alternate" hreflang="es-ES" href={esURL} />
          <link rel="alternate" hreflang="en-US" href={enURL} />
          <link rel="alternate" hreflang="x-default" href={esURL} />
        </>
      )
    }

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <ClientRouter fallback="swap" />

    <script is:inline>
      // Antes del primer pintado: tema, lente guardada, entradas y si toca la intro del boceto
      (() => {
        const root = document.documentElement;
        const applyTheme = () => {
          let theme = 'light';
          try {
            theme =
              localStorage.getItem('theme') ||
              (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          } catch (e) {}
          root.classList.toggle('dark', theme === 'dark');
        };
        const applyLens = () => {
          try {
            const lens = localStorage.getItem('lens');
            if (lens) root.dataset.lens = lens;
          } catch (e) {}
        };
        const markReveal = () => {
          if (!('IntersectionObserver' in window)) return;
          root.classList.add('reveal-ready');
          setTimeout(() => {
            if (!window.__revealInit) root.classList.remove('reveal-ready');
          }, 3000);
        };
        applyTheme();
        applyLens();
        markReveal();
        try {
          const skip =
            root.dataset.intro !== '1' ||
            location.hash ||
            sessionStorage.getItem('intro-done') ||
            window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
            (navigator.connection && navigator.connection.saveData) ||
            navigator.webdriver;
          // intro-seen: en esta carga el titular ya entra con la intro, así que no se entinta aparte
          if (!skip) root.classList.add('intro', 'intro-seen');
          if (root.dataset.intro === '1') sessionStorage.setItem('intro-done', '1');
        } catch (e) {}
        document.addEventListener('astro:after-swap', () => {
          // arrived: se llega navegando desde otra página (el entintado espera a la transición)
          root.classList.add('arrived');
          applyTheme();
          applyLens();
          markReveal();
        });
      })();
    </script>
  </head>

  <body class="antialiased">
    <a
      href="#main"
      class="bg-pencil text-pencil-ink sr-only z-[70] px-4 py-3 font-semibold focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
      >{t('aria.skip')}</a
    >
    <Header />
    <main id="main" class="frame">
      <p class="frame-label kit-frame-name" aria-hidden="true">
        {frame}
        <span data-frame-size></span>
      </p>
      <div class="artboard">
        <slot />
        <Footer />
      </div>
    </main>
    <LensPanel lang={lang} />
  </body>
</html>

<script>
  import '@/scripts/reveal';
  import '@/scripts/lenses';
  import '@/scripts/frames';
  import '@/scripts/intro';
  import '@/scripts/kit';
</script>
